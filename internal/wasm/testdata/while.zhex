# while: counter, initially-false condition, nested loops, while inside a
# word, and collatz as the computed-condition witness (DESIGN-M2 §5, §7.6).
var count = 0
while count < 3
    count = count + 1
print(count)
while count < 3
    count = count + 1
print(count)
var visits = 0
var i = 0
while i < 2
    var j = 0
    while j < 2
        j = j + 1
        visits = visits + 1
    i = i + 1
print(visits)
word collatz(n: Int) -> Int
    var current = n
    var steps = 0
    while current != 1
        if current % 2 == 0
            current = current / 2
        else
            current = 3 * current + 1
        steps = steps + 1
    steps
print(collatz(27))
print(collatz(837799))
var total = 0
var k = 1
while k <= 1000
    total = total + k
    k = k + 1
print(total)

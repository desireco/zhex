# Report line, word, and character counts for a text file, then stream it
# back uppercased — the whole-file and streaming reads in one program.
# Style-adapted from examples/text-stats.zhex for the wasm milestone: the
# path is inline and relative, no console.arg.

let body = file.read("sample.txt") try
print(int.to-string(text.line-count(body)) + " lines  " + int.to-string(text.word-count(body)) + " words  " + int.to-string(text.length(body)) + " chars")
for line in file.stream("sample.txt")
    print(text.upper(line))

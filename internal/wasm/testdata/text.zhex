# Every milestone-2 text word with the multibyte and edge witnesses
# (DESIGN-M2 §1, §7.1).
let greeting = "héllo"
print(text.length(greeting))
print(text.length("😀"))
print(text.length("e\u0301"))
print(text.slice(greeting, 1, 3))
print(text.slice("hello", -2, 99))
print("[" + text.slice("hello", 3, 2) + "]")
print("[" + text.slice("hello", 2, 2) + "]")
print(text.index-of(greeting, "l"))
print(text.index-of(greeting, "z"))
print(text.index-of(greeting, ""))
print(text.contains("hello", "ell"))
print(text.contains("hello", "xyz"))
print(text.contains("hello", ""))
flow greeting
    text.reverse
    print
print(text.length(text.reverse("e\u0301")))
print("[" + text.trim("\u00a0 \t hi \n\u00a0") + "]")
print(text.upper("éà"))
print(text.lower("ÉÀ"))
let parts = text.split(",a,,b,", ",")
print(list.length(parts))
print(parts[0] + "|" + parts[1] + "|" + parts[2] + "|" + parts[3] + "|" + parts[4])
let cps = text.split("héllo", "")
print(list.length(cps))
print(cps[1])
print(list.length(text.split("", "")))
print(list.length(text.split("", ",")))
let emoji = text.split("a😀b", "😀")
print(list.length(emoji))
print(emoji[0] + emoji[1])
print(text.join(parts, "-"))
print("[" + text.join([], "-") + "]")
print(text.join(text.split("1😀2", "😀"), "😀"))
print(text.replace("a-b-c", "-", "+"))
print(text.replace("a.b.c", ".", "!"))
print(text.replace("aaa", "aa", "b"))
print(text.starts-with("hello", "he"))
print(text.starts-with("hello", ""))
print(text.starts-with("hello", "el"))
print(text.ends-with("hello", "lo"))
print(text.ends-with("hello", ""))
print(text.line-count(""))
print(text.line-count("a"))
print(text.line-count("a\nb"))
print(text.line-count("a\n"))
print(text.word-count("  a\u00a0b\tc "))
print(text.word-count(""))

# env.load parses KEY=VALUE lines: first assignment wins (against a
# runner-injected key too), set-but-empty stays set, quotes strip, comments
# and blanks skip, and trimmed keys and values are used.

file.write("TITLE=from-file\nTITLE=second\nMODE=\nQUOTED=\"hello\"\nMARKED='single'\n# a comment\n\n   PADDED   =   spaced   \nZHEX_TEST_INJECTED=from-file\n", "app.env") try
env.load("app.env") try

match env.get("TITLE")
    case Option.Some(title)
        print("title: " + title)
    case Option.None
        print("title: unset")

match env.get("MODE")
    case Option.Some(mode)
        if mode == ""
            print("mode: set but empty")
        else
            print("mode: " + mode)
    case Option.None
        print("mode: unset")

match env.get("QUOTED")
    case Option.Some(v)
        print("quoted: " + v)
    case Option.None
        print("quoted: unset")
match env.get("MARKED")
    case Option.Some(v)
        print("marked: " + v)
    case Option.None
        print("marked: unset")
match env.get("PADDED")
    case Option.Some(v)
        print("padded: [" + v + "]")
    case Option.None
        print("padded: unset")
match env.get("ZHEX_TEST_INJECTED")
    case Option.Some(v)
        print("injected wins: " + v)
    case Option.None
        print("injected: unset")
match env.get("NEVER_SET")
    case Option.Some(v)
        print("never: " + v)
    case Option.None
        print("never: unset")

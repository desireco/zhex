# text.to-int successes and caught fallbacks (DESIGN-M2 §2, §7.2).
print(text.to-int("  12  ") try)
print(text.to-int("\u00a07\u00a0") try)
print(text.to-int("+7") try)
print(text.to-int("007") try)
print(text.to-int("-9223372036854775808") try)
print(text.to-int("9223372036854775807") try)
let fallback = text.to-int("x") catch
    -1
print(fallback)
# 2^127 is beyond both builds' widths, so the catch agrees everywhere.
let overflow = text.to-int("170141183460469231731687303715884105728") catch
    -2
print(overflow)
let empty = text.to-int("") catch
    0
print(empty)

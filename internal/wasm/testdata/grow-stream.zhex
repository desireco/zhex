# Streaming stdin line I/O (#187): the read-to-EOF loop over 100k lines,
# each transformed and printed — the per-line read/print shape the #6
# benchmark caught paying the WASI adapter per line.

var lines = 0
var chars = 0
var done = false
while not done
    let line = read-line("") catch problem
        if error.detail(problem, "reason") == "end-of-file"
            done = true
            ""
        else
            error.message(problem)
    if not done
        lines = lines + 1
        chars = chars + text.length(line)
        print(int.to-string(lines) + ":" + line)
print("lines: " + int.to-string(lines) + " chars: " + int.to-string(chars))

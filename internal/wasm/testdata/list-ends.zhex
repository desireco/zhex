# List end words: first and last read the ends without changing the list.
let xs = [1, 2, 3]
print(list.first(xs))
print(list.last(xs))
print(list.length(xs))
print(list.first(xs))
let words = ["a", "b", "c"]
print(list.last(words))
print(list.length(words))
let stack: List<Int> = list.new()
for n in [1, 2, 3]
    list.append(stack, n)
print(list.last(stack))
print(list.first(stack))

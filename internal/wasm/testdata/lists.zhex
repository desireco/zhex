# List building, index read and write, iteration, String +, int.to-string.
let names: List<String> = list.new()
list.append(names, "Ada")
list.append(names, "Grace")
list.append(names, "Lin")
print(list.length(names))
print(names[1])
names[0] = "Augusta"
for index, name in names
    print(int.to-string(index) + ": " + name)

# The read-to-EOF idiom (#135): the loop branches on the end-of-file
# reason detail. A caught parse failure's message names each build's Int
# width (the interpreter parses 128-bit, compiled wasm 64-bit), so this
# fixture echoes only the build-agnostic absent reason detail.

let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch problem
        if error.detail(problem, "reason") == "end-of-file"
            done = true
            ""
        else
            error.message(problem)
    if not done
        let added = buffer.add-line(input, line)
print(buffer.to-text(input))
let n = text.to-int("12x") catch bad
    print("[" + error.detail(bad, "reason") + "]")
    0
print(int.to-string(n))

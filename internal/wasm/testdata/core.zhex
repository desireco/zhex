# var, for range, if/elif/else, comparisons, and/or/not, negative numbers.
var total = 0
for i in range(1, 11)
    total = total + i
print(total)

let size = if total > 100
    "huge"
elif total > 50
    "large"
else
    "small"
print(size)

print(not (total == 55))
print(total > 50 and total < 60)
print(total == 54 or total == 1)
print(0 - total)
print(-7 * 3)
print(7 / 2)
print(7 % 3)
print("neg: " + -9)

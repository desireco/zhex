# A user choice with match, the built-in Option, and a record.
type Status = choice
    Pending
    Running
    Failed(message: String)

word describe(status: Status) -> String
    match status
        case Status.Pending
            "pending"
        case Status.Running
            "running"
        case Status.Failed(message)
            "failed: " + message

print(describe(Status.Pending))
print(describe(Status.Running))
print(describe(Status.Failed("network unavailable")))

word opt-value(opt: Option<Int>) -> Int
    match opt
        case Option.Some(value)
            value
        case Option.None
            0

print(opt-value(Option.Some(7)))
print(opt-value(Option.None))

type Customer = record
    name: String
    age: Int

word summary(customer: Customer) -> String
    customer.name + ", age " + int.to-string(customer.age)

let ada: Customer = Customer("Ada", 36)
print(summary(ada))

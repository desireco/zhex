<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="What works in Zhex today, what comes next, and the language's longer-term direction.">
  <meta name="theme-color" content="#f6f3ec">
  <title>Roadmap — Zhex</title>
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="brand" href="./" aria-label="Zhex home"><img class="brand-logo" src="logo.svg" width="168" height="50" alt=""></a>
    <nav aria-label="Main navigation">
      {{.Nav}}
    </nav>
  </header>

  <main id="main">
    <section class="page-intro wrap">
      <p class="eyebrow">The plan</p>
      <h1>Where Zhex goes next.</h1>
      <p class="lede">{{.Roadmap.Intro}}</p>
    </section>

    {{range .Roadmap.Sections}}
    <section class="section roadmap-section{{if eq .Title "Done"}} done{{else if eq .Title "Next"}} next{{end}}" aria-labelledby="stage-{{.Title}}">
      <div class="wrap roadmap-stage">
        <div><p class="eyebrow">{{.Title}}</p><h2 id="stage-{{.Title}}">{{if eq .Title "Done"}}A working foundation.{{else if eq .Title "Next"}}Make it useful day to day.{{else}}Room to grow.{{end}}</h2><p class="aside">{{.Summary}}</p></div>
        <ul>{{range .Items}}<li>{{.}}</li>{{end}}</ul>
      </div>
    </section>
    {{end}}

    <p class="roadmap-source wrap"><a href="https://github.com/users/desireco/projects/8">Follow the project board ↗</a> · <a href="ROADMAP.md">View the roadmap source</a> · <a href="examples.html">Try the current examples →</a></p>
  </main>

  <footer class="site-footer wrap">
    <a class="brand" href="./" aria-label="Zhex home"><img class="brand-logo" src="logo.svg" width="138" height="41" alt=""></a>
    <p>Small words. Big ideas.</p>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="design/design-system.html">Design system</a>
      <a href="design/archive/">Design archive</a>
      <a href="https://github.com/users/desireco/projects/8">Project board ↗</a>
      <a href="https://github.com/desireco/zhex/blob/main/docs/initial-language.md">Language reference ↗</a>
    </nav>
  </footer>
</body>
</html>

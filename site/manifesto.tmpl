<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Why Zhex exists: understandable programs, small composable words, useful tools, and the pleasure of programming.">
  <meta name="theme-color" content="#f6f3ec">
  <title>Manifesto — Zhex</title>
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="brand" href="./" aria-label="Zhex home"><img class="brand-logo" src="logo.svg" width="168" height="50" alt=""></a>
    <nav aria-label="Main navigation">
      {{.Nav}}
    </nav>
  </header>

  <main id="main" class="wrap">
    <section class="page-intro">
      <p class="eyebrow">Manifesto</p>
      <h1>{{.Manifesto.Title}}</h1>
      {{range .Manifesto.Intro}}<p class="lede">{{.}}</p>{{end}}
      <p class="aside">Read the <a href="manifesto.md">Markdown source</a> or the <a href="https://github.com/desireco/zhex/blob/main/docs/language-goals.md">language goals and acceptance criteria</a>.</p>
    </section>

    <section class="section" aria-label="The intentions behind Zhex">
      {{range .Manifesto.Sections}}
      <div class="docs-feature">
        <h2>{{.Title}}</h2>
        {{range .Paragraphs}}<p>{{.}}</p>{{end}}
      </div>
      {{end}}
    </section>
  </main>

  <footer class="site-footer wrap">
    <a class="brand" href="./" aria-label="Zhex home"><img class="brand-logo" src="logo.svg" width="138" height="41" alt=""></a>
    <p>Small words. Big ideas.</p>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="design/design-system.html">Design system</a>
      <a href="design/archive/">Design archive</a>
      <a href="https://github.com/users/desireco/projects/8">Project board ↗</a>
      <a href="https://github.com/desireco/zhex/blob/main/docs/initial-language.md">Language reference ↗</a>
    </nav>
  </footer>
</body>
</html>

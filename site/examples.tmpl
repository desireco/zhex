<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Read and run Zhex examples: console input, FizzBuzz, Fibonacci, and palindrome checking.">
  <meta name="theme-color" content="#153c32">
  <title>Examples — Zhex</title>
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="wordmark" href="./" aria-label="Zhex home"><img src="favicon.svg" width="34" height="34" alt="">Zhex</a>
    <nav aria-label="Main navigation"><a href="examples.html" aria-current="page">Examples</a><a href="./#start">Get started</a><a href="roadmap.html">Roadmap</a><a href="https://github.com/desireco/zhex">GitHub <span aria-hidden="true">↗</span></a></nav>
  </header>
  <main id="main" class="wrap">
    <section class="examples-intro"><p class="eyebrow">The language in use</p><h1>Zhex, by example.</h1><p class="lede">Each program includes its source,<br>sample input, and output.</p><p class="aside">These examples use the current interpreter. Open a program to see its source.</p></section>
    <div class="programs">
    {{range .Examples}}{{if or (eq .ID "hello") (eq .ID "fizzbuzz") (eq .ID "fibonacci") (eq .ID "palindrome")}}
      <details class="program"{{if eq .ID "hello"}} open{{end}}>
        <summary><span><strong>{{.Title}}</strong><span>{{.Description}}</span></span><span class="expand-mark" aria-hidden="true">+</span></summary>
        <div class="program-body" id="{{.ID}}">
          <div class="program-code"><div class="code-label"><span>{{.ID}}.zhex</span><a href="{{.SourceURL}}" download>Download source <span aria-hidden="true">↓</span></a></div><pre><code>{{.Source}}</code></pre></div>
          <div class="program-result">
            <h2>Run</h2><pre><code>{{.Command}}</code></pre>
            <h2>Sample input</h2><pre><samp>{{.Input}}</samp></pre>
            <h2>Output</h2><pre><samp>{{.Output}}</samp></pre>
          </div>
        </div>
      </details>
    {{end}}{{end}}
    </div>
    <section class="more-examples"><h2>Two more to explore.</h2><p>Download <a href="examples/composition.zhex" download>simple composition</a> or <a href="examples/factorial.zhex" download>factorial</a> and run it with the same command.</p></section>
    <section class="example-notes"><h2>A few language details.</h2><ul><li><code>let</code> creates an immutable value. <code>var</code> allows local updates.</li><li><code>flow</code> passes each result to the next operation.</li><li><code>try</code> propagates a failed input operation as an error.</li><li>Palindrome checking preserves case, spaces, and punctuation.</li></ul><a class="text-link" href="./#start">Set up the interpreter <span aria-hidden="true">↗</span></a></section>
  </main>
  <footer class="site-footer wrap"><a class="wordmark" href="./">Zhex</a><p>An experimental Forth-inspired language.</p><a href="https://github.com/desireco/zhex/blob/main/docs/initial-language.md">Language reference <span aria-hidden="true">↗</span></a></footer>
</body>
</html>

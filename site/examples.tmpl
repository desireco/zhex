<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Read, download, and run Zhex examples for console input, conditions, loops, local state, and text.">
  <meta name="theme-color" content="#f6f3ec">
  <title>Examples — Zhex</title>
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="brand" href="./" aria-label="Zhex home"><img class="brand-logo" src="logo.svg" width="168" height="50" alt=""></a>
    <nav aria-label="Main navigation">
      <a href="examples.html" aria-current="page">Examples</a>
      <a href="docs.html">Docs</a>
      <a href="./#start">Get started</a>
      <a href="roadmap.html">Roadmap</a>
      <a href="https://github.com/desireco/zhex">GitHub ↗</a>
    </nav>
  </header>

  <main id="main" class="wrap">
    <section class="page-intro">
      <p class="eyebrow">The language in use</p>
      <h1>Zhex, by example.</h1>
      <p class="lede">Each program includes its source, sample input, and output.</p>
      <p class="aside">These examples use the current Go interpreter. Open a program to inspect how the words compose.</p>
    </section>

    <div class="programs">
    {{range .Examples}}{{if or (eq .ID "hello") (eq .ID "fizzbuzz") (eq .ID "fibonacci") (eq .ID "palindrome") (eq .ID "gcd") (eq .ID "times-table")}}
      <details class="program" id="{{.ID}}"{{if eq .ID "hello"}} open{{end}}>
        <summary><span><strong>{{.Title}}</strong><span>{{.Description}}</span></span><span class="expand-mark" aria-hidden="true">+</span></summary>
        <div class="program-body">
          <div class="program-code">
            <div class="code-label"><span>{{.ID}}.zhex</span><a href="{{.SourceURL}}" download>Download source ↓</a></div>
            <pre><code>{{.Source | highlight}}</code></pre>
          </div>
          <div class="program-result">
            <h3>Run</h3><pre><code>{{.Command}}</code></pre>
            <h3>Sample input</h3><pre><samp>{{.Input}}</samp></pre>
            <h3>Output</h3><pre><samp>{{.Output}}</samp></pre>
          </div>
        </div>
      </details>
    {{end}}{{end}}
    </div>

    <section class="more-examples">
      <p class="eyebrow">Keep exploring</p>
      <h2>Two more programs.</h2>
      <p>Download <a href="examples/composition.zhex" download>simple composition</a> or <a href="examples/factorial.zhex" download>factorial</a> and run them with the same interpreter command.</p>
    </section>

    <section class="example-notes">
      <p class="eyebrow">Language details</p>
      <h2>A few words worth knowing.</h2>
      <ul>
        <li><code>let</code> creates an immutable value. <code>var</code> allows local updates.</li>
        <li><code>flow</code> passes each result to the next operation.</li>
        <li><code>try</code> propagates a failed input operation as an error.</li>
        <li>Palindrome checking preserves case, spaces, and punctuation.</li>
      </ul>
      <a class="text-link" href="./#start">Set up the interpreter →</a>
    </section>
  </main>

  <footer class="site-footer wrap">
    <a class="brand" href="./" aria-label="Zhex home"><img class="brand-logo" src="logo.svg" width="138" height="41" alt=""></a>
    <p>Small words. Big ideas.</p>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="design/design-system.html">Design system</a>
      <a href="design/archive/">Design archive</a>
      <a href="https://github.com/users/desireco/projects/8">Project board ↗</a>
      <a href="https://github.com/desireco/zhex/blob/main/docs/initial-language.md">Language reference ↗</a>
    </nav>
  </footer>

  <script>
    const openTarget = () => {
      const target = document.getElementById(location.hash.slice(1));
      if (target && target.tagName === "DETAILS") target.open = true;
    };
    openTarget();
    addEventListener("hashchange", openTarget);
  </script>
</body>
</html>

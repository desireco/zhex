---
const { title, description, current = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [[`${base}/manifesto.html`, 'Manifesto', 'manifesto'], [`${base}/examples.html`, 'Examples', 'examples'], [`${base}/docs.html`, 'Docs', 'docs'], [`${base}/roadmap.html`, 'Roadmap', 'roadmap'], ['https://github.com/desireco/zhex', 'GitHub ↗', '']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content={description}><meta name="theme-color" content="#f6f3ec"><title>{title}</title><link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml"><link rel="stylesheet" href={`${base}/styles.css`}></head><body>

  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="brand" href={`${base}/`} aria-label="Zhex home"><img class="brand-logo" src={`${base}/logo.svg`} width="168" height="50" alt=""></a>
    <nav aria-label="Main navigation">
      {links.map(([href, label, page]) => <a href={href} aria-current={page === current ? "page" : undefined}>{label}</a>)}
    </nav>
  </header>

<slot />
  <footer class="site-footer wrap">
    <a class="brand" href={`${base}/`} aria-label="Zhex home"><img class="brand-logo" src={`${base}/logo.svg`} width="138" height="41" alt=""></a>
    <p>Small words. Big ideas.</p>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href={`${base}/design/design-system.html`}>Design system</a>
      <a href={`${base}/design/archive/`}>Design archive</a>
      <a href="https://github.com/users/desireco/projects/8">Project board ↗</a>
      <a href="https://github.com/desireco/zhex/blob/main/docs/initial-language.md">Language reference ↗</a>
    </nav>
  </footer>
</body></html>

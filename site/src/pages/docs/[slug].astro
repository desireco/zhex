---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DocsNav from '../../components/DocsNav.astro';
export async function getStaticPaths() {
  return (await getCollection('docs')).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const entries = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${entry.data.title} — Zhex`} description={entry.data.description} current={entry.id === 'tldr' ? 'tldr' : 'docs'}>
  <main id="main" class="wrap docs-page">
    <section class="page-intro docs-intro"><p class="eyebrow"><a href={`${base}/docs.html`}>Docs</a> / {entry.data.section}</p><h1>{entry.data.title}</h1><p class="lede">{entry.data.description}</p></section>
    <div class="docs-layout">
      <div class="docs-nav-desktop"><DocsNav entries={entries} current={entry.id} base={base} /></div>
      <details class="docs-nav-mobile"><summary>Browse documentation</summary><DocsNav entries={entries} current={entry.id} base={base} /></details>
      <article class="section docs-article">{headings.some(h => h.depth === 2) && <details class="docs-toc"><summary>On this page</summary><nav aria-label="On this page"><ul>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav></details>}<Content /></article>
    </div>
  </main>
</Base>

---
import Base from "../layouts/Base.astro";
import data from "../../data.json";
const groups = ["Language basics", "Algorithms"].map(name => ({
  name,
  examples: data.Examples.filter(example => example.Group === name),
}));
---
<Base title="Examples — Zhex" description="Read, download, and run Zhex examples." current="examples">
  <main id="main" class="wrap">
    <section class="page-intro examples-intro">
      <p class="eyebrow">The language in use</p>
      <h1>Zhex, by example.</h1>
      <p class="lede">Read every program, see its output, and run it yourself.</p>
      <div class="actions">
        <a class="text-link" href="demos.html">Watch the demos →</a>
      </div>
      <p class="aside">Runnable examples are compiled to WebAssembly and run entirely in your browser, using WebAssembly garbage collection — roughly Chrome 119+, Firefox 120+, or Safari 18.2+.</p>
    </section>

    <nav class="example-index" aria-label="Browse examples by group">
      <h2>Browse examples</h2>
      {groups.map(group => (
        <section aria-label={group.name}>
          <h3>{group.name}</h3>
          <ul>{group.examples.map(e => <li><a href={`#${e.ID}`}>{e.Title}</a></li>)}</ul>
        </section>
      ))}
    </nav>

    <div class="programs">
    {groups.map(group => (
      <section class="example-group" aria-labelledby={`${group.name.toLowerCase().replaceAll(" ", "-")}-title`}>
        <header class="example-group-heading">
          <h2 id={`${group.name.toLowerCase().replaceAll(" ", "-")}-title`}>{group.name}</h2>
          <p>{group.name === "Language basics" ? "Small programs for learning Zhex values, words, and effects." : "Complete programs that use those language tools to solve a problem."}</p>
        </header>
        {group.examples.map(e => (
        <section class="program" id={e.ID} aria-labelledby={`${e.ID}-title`}>
          <header class="program-heading"><h3 id={`${e.ID}-title`}>{e.Title}</h3><p>{e.Description}</p></header>
          <div class="program-body">
            <div class="program-code">
              <div class="code-label"><span>{e.File}</span><a href={e.SourceURL} download>Download source ↓</a></div>
              <pre><code><Fragment set:html={e.Highlighted} /></code></pre>
              {(e.Modules || []).map(m => (<div class="code-label"><span>{m.File}</span><a href={m.URL} download>Download source ↓</a></div>
              <pre><code><Fragment set:html={m.Highlighted} /></code></pre>))}
            </div>
            <div class="program-result">
              <h4>Run</h4><pre><code>{e.Command}</code></pre>
              {!e.Wasm && e.Input && <><h4>Sample input</h4><pre><samp>{e.Input}</samp></pre></>}
              {e.Wasm && (
                <div class="run-panel" data-wasm={e.Wasm} data-input-kind={e.InputKind} data-input-lines={e.InputLines}>
                  {e.InputKind !== "none" && (
                    <>
                      <label class="run-label" for={`${e.ID}-stdin`}>Program input</label>
                      <p class="run-input-hint" id={`${e.ID}-hint`}>{e.InputHint}</p>
                    </>
                  )}
                  {e.InputKind !== "none" && (
                    <>
                      <textarea id={`${e.ID}-stdin`} rows={3} spellcheck="false" aria-describedby={`${e.ID}-hint`}>{e.Stdin}</textarea>
                      <p class="run-input-error" role="alert" hidden></p>
                    </>
                  )}
                  <button class="button run-button" type="button">Run <span aria-hidden="true">→</span></button>
                </div>
              )}
              <h4>Output</h4>
              {e.Wasm
                ? <pre aria-live="polite"><samp data-run-output>{e.Output}</samp></pre>
                : <pre><samp>{e.Output}</samp></pre>}
              {e.WasmNote && <p class="wasm-note">Not compiled to WebAssembly yet — {e.WasmNote}.</p>}
            </div>
          </div>
        </section>
        ))}
      </section>
    ))}
    </div>

    <section class="example-notes">
      <p class="eyebrow">Language details</p>
      <h2>A few words worth knowing.</h2>
      <ul>
        <li><code>let</code> creates an immutable binding. <code>var</code> allows rebinding.</li>
        <li><code>flow</code> passes each result to the next operation.</li>
        <li><code>try</code> unwraps success or propagates a compatible failure.</li>
        <li>Palindrome checking preserves case, spaces, and punctuation.</li>
      </ul>
      <a class="text-link" href="docs/getting-started.html">Get started with Zhex →</a>
    </section>

    <a class="to-top" href="#top">Back to top ↑</a>
    <script is:inline>
      const link = document.querySelector('.to-top');
      new IntersectionObserver(([entry]) =>
        link.classList.toggle('shown', !entry.isIntersecting)
      ).observe(document.querySelector('.examples-intro'));
    </script>

    <script>
      // One module script for every run panel: the artifact is fetched lazily
      // on first Run through the shared fetchArtifact (the shim compiles a
      // fresh instance per call, so each click is a clean run).
      import { runZhex } from "../scripts/zhex-run.mjs";
      import { fetchArtifact, loadFailedMessage } from "../scripts/artifact.mjs";

      const decoder = new TextDecoder();

      function withErrorLine(stdout, error) {
        if (!error) return stdout;
        return stdout && !stdout.endsWith("\n") ? `${stdout}\n${error}` : stdout + error;
      }

      // The page validates the box against its declared kind before any run,
      // so a wrong entry is named here instead of surfacing as the program's
      // own trap; the trap path stays as the backstop for what this cannot
      // predict. Integer lines mirror text.to-int: trimmed, then a signed
      // 64-bit decimal integer.
      const INT64_MIN = -(2n ** 63n);
      const INT64_MAX = 2n ** 63n - 1n;

      function isInt64(text) {
        if (!/^[+-]?[0-9]+$/.test(text)) return false;
        const value = BigInt(text);
        return value >= INT64_MIN && value <= INT64_MAX;
      }

      function inputProblem(panel, value) {
        if (panel.dataset.inputKind !== "int") return "";
        const count = Number(panel.dataset.inputLines);
        const phrases = { 1: "one number", 2: "two numbers, one per line" };
        const expected = phrases[count] ?? `${count} numbers, one per line`;
        const raw = value.replace(/\n$/, "");
        const lines = raw === "" ? [] : raw.split("\n");
        if (lines.length !== Number(panel.dataset.inputLines)) {
          return lines.length === 0
            ? `Expected ${expected} — the box is empty.`
            : `Expected ${expected} — ${lines.length} ${lines.length === 1 ? "line" : "lines"} found.`;
        }
        const bad = lines.find(line => !isInt64(line.trim()));
        if (bad === undefined) return "";
        return bad.trim() === ""
          ? `Expected ${expected} — a blank line is not an integer.`
          : `Expected ${expected} — "${bad.trim()}" is not an integer.`;
      }

      for (const panel of document.querySelectorAll(".run-panel")) {
        const button = panel.querySelector("button");
        const input = panel.querySelector("textarea");
        const validation = panel.querySelector(".run-input-error");
        const output = panel.closest(".program-result").querySelector("[data-run-output]");
        const pane = output.closest("pre");
        // Messages can run wider than the pane: wrap them instead of clipping.
        const showMessage = (text) => {
          pane.classList.add("run-error");
          output.textContent = text;
        };
        button.addEventListener("click", async () => {
          const problem = inputProblem(panel, input ? input.value : "");
          if (problem) {
            validation.textContent = problem;
            validation.hidden = false;
            return;
          }
          if (validation) validation.hidden = true;
          button.disabled = true;
          try {
            const bytes = await fetchArtifact(panel.dataset.wasm);
            const { stdout, error } = runZhex(bytes, { stdin: input ? input.value : "" });
            const text = decoder.decode(stdout);
            if (error) showMessage(withErrorLine(text, error));
            else {
              pane.classList.remove("run-error"); // a clean re-run unwraps the pane again
              output.textContent = text;
            }
          } catch (error) {
            showMessage(error?.message ?? loadFailedMessage); // curated artifact messages and runZhex's raw errors alike
          } finally {
            button.disabled = false;
          }
        });
      }
    </script>

  </main>
</Base>

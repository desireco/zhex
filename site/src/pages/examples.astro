---
import Base from "../layouts/Base.astro";
import data from "../../data.json";
const groups = ["Language basics", "Algorithms"].map(name => ({
  name,
  examples: data.Examples.filter(example => example.Group === name),
}));
---
<Base title="Examples — Zhex" description="Read, download, and run Zhex examples." current="examples">
  <main id="main" class="wrap">
    <section class="page-intro examples-intro">
      <p class="eyebrow">The language in use</p>
      <h1>Zhex, by example.</h1>
      <p class="lede">Read every program, see its output, and run it yourself.</p>
    </section>

    <nav class="example-index" aria-label="Browse examples by group">
      <h2>Browse examples</h2>
      {groups.map(group => (
        <section aria-label={group.name}>
          <h3>{group.name}</h3>
          <ul>{group.examples.map(e => <li><a href={`#${e.ID}`}>{e.Title}</a></li>)}</ul>
        </section>
      ))}
    </nav>

    <div class="programs">
    {groups.map(group => (
      <section class="example-group" aria-labelledby={`${group.name.toLowerCase().replaceAll(" ", "-")}-title`}>
        <header class="example-group-heading">
          <h2 id={`${group.name.toLowerCase().replaceAll(" ", "-")}-title`}>{group.name}</h2>
          <p>{group.name === "Language basics" ? "Small programs for learning Zhex values, words, and effects." : "Complete programs that use those language tools to solve a problem."}</p>
        </header>
        {group.examples.map(e => (
        <section class="program" id={e.ID} aria-labelledby={`${e.ID}-title`}>
          <header class="program-heading"><h3 id={`${e.ID}-title`}>{e.Title}</h3><p>{e.Description}</p></header>
          <div class="program-body">
            <div class="program-code">
              <div class="code-label"><span>{e.File}</span><a href={e.SourceURL} download>Download source ↓</a></div>
              <pre><code><Fragment set:html={e.Highlighted} /></code></pre>
              {(e.Modules || []).map(m => (<div class="code-label"><span>{m.File}</span><a href={m.URL} download>Download source ↓</a></div>
              <pre><code><Fragment set:html={m.Highlighted} /></code></pre>))}
            </div>
            <div class="program-result">
              <h4>Run</h4><pre><code>{e.Command}</code></pre>
              {e.Input && <><h4>Sample input</h4><pre><samp>{e.Input}</samp></pre></>}
              <h4>Output</h4><pre><samp>{e.Output}</samp></pre>
            </div>
          </div>
        </section>
        ))}
      </section>
    ))}
    </div>

    <section class="example-notes">
      <p class="eyebrow">Language details</p>
      <h2>A few words worth knowing.</h2>
      <ul>
        <li><code>let</code> creates an immutable binding. <code>var</code> allows rebinding.</li>
        <li><code>flow</code> passes each result to the next operation.</li>
        <li><code>try</code> unwraps success or propagates a compatible failure.</li>
        <li>Palindrome checking preserves case, spaces, and punctuation.</li>
      </ul>
      <a class="text-link" href="docs/getting-started.html">Get started with Zhex →</a>
    </section>

    <a class="to-top" href="#top">Back to top ↑</a>
    <script is:inline>
      const link = document.querySelector('.to-top');
      new IntersectionObserver(([entry]) =>
        link.classList.toggle('shown', !entry.isIntersecting)
      ).observe(document.querySelector('.examples-intro'));
    </script>
  </main>
</Base>

---
import Base from "../layouts/Base.astro";
import data from "../../data.json";

// One honest label per door status, verbatim (#126); the door count comes
// from the data rows, never from the page.
const statusLabel = {
  empty: "Not solved yet",
  working: "Working on this problem",
  part1: "Part 1 solved, part 2 in progress",
  solved: "Solved",
};
const days = data.Aoc;
---
<Base title="Advent of Code — Zhex" description="Advent of Code puzzles solved in Zhex — last year's archive, with this year following in December." current="advent-of-code">
  <main id="main" class="wrap">
    <section class="page-intro aoc-intro">
      <p class="eyebrow">December 2025 archive</p>
      <h1 id="aoc-title">Advent of Code.</h1>
      <p class="lede">Advent of Code puzzles solved in Zhex — last year's archive, with this year following in December.</p>
    </section>

    <div class="aoc-tabs" role="tablist" aria-label="Advent of Code years">
      <button class="aoc-tab" id="aoc-tab-2025" type="button" role="tab" aria-selected="true" aria-controls="aoc-panel-2025">2025</button>
      <button class="aoc-tab" id="aoc-tab-2026" type="button" role="tab" aria-selected="false" aria-controls="aoc-panel-2026" tabindex="-1">2026</button>
    </div>

    <section class="aoc-panel" id="aoc-panel-2025" role="tabpanel" aria-labelledby="aoc-tab-2025">
      <nav class="aoc-calendar" aria-label="2025 doors">
        <ul class="aoc-doors">
          {days.map(day => (
            <li class="aoc-door">
              <a class="aoc-door-link" href={`#aoc-day-${day.Day}`}>
                <span class="aoc-door-day">{day.Day}</span>
                <span class="aoc-door-title">{day.Title}</span>
                <span class="aoc-badge" data-status={day.Status}>{statusLabel[day.Status]}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      {days.map(day => (
        <section class="aoc-day" id={`aoc-day-${day.Day}`} aria-labelledby={`aoc-day-${day.Day}-heading`}>
          <h2 id={`aoc-day-${day.Day}-heading`}><span class="aoc-day-number">Day {day.Day}</span>{day.Title}</h2>
          <p class="aoc-day-outline">{day.Outline}</p>
          <p><a class="text-link" href={day.OfficialURL} target="_blank" rel="noopener">View on adventofcode.com ↗</a></p>
          <details class="aoc-solution">
            <summary>Show solution</summary>
            <div class="aoc-solution-body">
              <p class="aoc-solution-status" data-status={day.Status}>{statusLabel[day.Status]}</p>
            </div>
          </details>
        </section>
      ))}
    </section>

    <section class="aoc-panel" id="aoc-panel-2026" role="tabpanel" aria-labelledby="aoc-tab-2026" hidden>
      <div class="aoc-teaser">
        <h2>Starts December 1</h2>
        <p>Each day's door appears here when the event starts.</p>
      </div>
      {/* The empty calendar frame: it fills from 2026 day data once that data
          exists — no invented doors before then (#126). */}
      <div class="aoc-doors-empty" aria-hidden="true"></div>
    </section>

    <a class="to-top" href="#top">Back to top ↑</a>
    <script is:inline>
      const link = document.querySelector('.to-top');
      new IntersectionObserver(([entry]) =>
        link.classList.toggle('shown', !entry.isIntersecting)
      ).observe(document.querySelector('.aoc-intro'));
    </script>

    <script>
      // Two year tabs (#126): click or arrow keys move the selection, and
      // the hidden panels keep the page one document for find-in-page.
      const tabs = [...document.querySelectorAll('.aoc-tab')];
      const panels = tabs.map(tab => document.getElementById(tab.getAttribute('aria-controls')));

      function select(index, focus) {
        tabs.forEach((tab, at) => {
          const active = at === index;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          panels[at].hidden = !active;
        });
        if (focus) tabs[index].focus();
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => select(index, false));
        tab.addEventListener('keydown', event => {
          const move = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1
            : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 0;
          if (!move) return;
          event.preventDefault();
          select((index + move + tabs.length) % tabs.length, true);
        });
      });

      // A #tab-id hash opens that year directly, so year links are shareable.
      const initial = tabs.findIndex(tab => tab.id === location.hash.slice(1));
      if (initial > 0) select(initial, false);
    </script>
  </main>
</Base>

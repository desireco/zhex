---
import Base from "../layouts/Base.astro";
import data from "../../data.json";

// One honest label per door status, verbatim (#126); the years, their order,
// and every door count come from the data rows, never from the page (#137).
const statusLabel = {
  empty: "Not solved yet",
  working: "Working on this problem",
  part1: "Part 1 solved, part 2 in progress",
  solved: "Solved",
};
const days = data.Aoc;
// The convention's file name (#171): one file per day, words plus main.
const fileName = (day) => `day${String(day.Day).padStart(2, "0")}.zhex`;
const years = [...new Set(days.map(day => day.Year))];
// The live year follows the newest archive year; it holds no rows yet, so
// its tab renders the teaser. When that year's rows arrive, the teaser
// moves forward on its own.
const teaserYear = years[years.length - 1] + 1;
const latestYear = years[years.length - 1];
---
<Base title="Advent of Code — Zhex" description={`Advent of Code puzzles solved in Zhex — ${years.length} archive years, with the next one starting each December.`} current="advent-of-code">
  <main id="main" class="wrap">
    <section class="page-intro aoc-intro">
      <p class="eyebrow">The archive: {years.join(", ")}</p>
      <h1 id="aoc-title">Advent of Code.</h1>
      <p class="lede">Each December we work through that year's Advent of Code puzzles in Zhex, one small program per day; {years.length} archive years are here so far. Every door links to its puzzle on adventofcode.com, with our own summary of what the puzzle asks — most days cover both parts, and every part appears only after it is solved there.</p>
    </section>

    <div class="aoc-tabs" role="tablist" aria-label="Advent of Code years">
      {years.map(year => (
        <button class="aoc-tab" id={`aoc-tab-${year}`} type="button" role="tab" aria-selected={year === latestYear} aria-controls={`aoc-panel-${year}`} tabindex={year === latestYear ? 0 : -1}>{year}</button>
      ))}
      <button class="aoc-tab" id={`aoc-tab-${teaserYear}`} type="button" role="tab" aria-selected="false" aria-controls={`aoc-panel-${teaserYear}`} tabindex="-1">{teaserYear}</button>
    </div>

    {years.map(year => (
      <section class="aoc-panel" id={`aoc-panel-${year}`} role="tabpanel" aria-labelledby={`aoc-tab-${year}`} hidden={year !== latestYear}>
        <nav class="aoc-calendar" aria-label={`${year} doors`}>
          <ul class="aoc-doors">
            {days.filter(day => day.Year === year).map(day => (
              <li class="aoc-door">
                <a class="aoc-door-link" href={`#aoc-day-${day.Year}-${day.Day}`}>
                  <span class="aoc-door-day">{day.Day}</span>
                  {day.Title && <span class="aoc-door-title">{day.Title}</span>}
                  <span class="aoc-badge" data-status={day.Status}>{statusLabel[day.Status]}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
        {days.filter(day => day.Year === year).map(day => (
          <section class="aoc-day" id={`aoc-day-${day.Year}-${day.Day}`} aria-labelledby={`aoc-day-${day.Year}-${day.Day}-heading`}>
            <h2 id={`aoc-day-${day.Year}-${day.Day}-heading`}><span class="aoc-day-number">Day {day.Day}</span>{day.Title}</h2>
            {day.Outline && <p class="aoc-day-outline">{day.Outline}</p>}
            <p><a class="text-link" href={day.OfficialURL} target="_blank" rel="noopener">View on adventofcode.com ↗</a></p>
            <details class="aoc-solution">
              <summary>Show solution</summary>
              <div class="aoc-solution-body">
                {day.Wasm ? (
                  <div class="run-panel aoc-run-panel" data-wasm={day.Wasm}>
                    <label class="run-label" for={`aoc-day-${day.Year}-${day.Day}-stdin`}>Paste your puzzle input here</label>
                    <textarea id={`aoc-day-${day.Year}-${day.Day}-stdin`} rows={6} spellcheck="false">{day.Stdin}</textarea>
                    <button class="button run-button" type="button">Run <span aria-hidden="true">→</span></button>
                    <h4>Output</h4>
                    <pre aria-live="polite"><samp data-run-output>{day.Output}</samp></pre>
                  </div>
                ) : day.WasmNote ? (
                  <p class="wasm-note">Not compiled to WebAssembly yet — {day.WasmNote}.</p>
                ) : (
                  <p class="aoc-solution-status" data-status={day.Status}>{statusLabel[day.Status]}</p>
                )}
                {day.Code && (
                  <div class="program-code aoc-code">
                    <div class="code-label"><span>{fileName(day)}</span></div>
                    <pre><code><Fragment set:html={day.Code} /></code></pre>
                  </div>
                )}
              </div>
            </details>
          </section>
        ))}
      </section>
    ))}

    <section class="aoc-panel" id={`aoc-panel-${teaserYear}`} role="tabpanel" aria-labelledby={`aoc-tab-${teaserYear}`} hidden>
      <div class="aoc-teaser">
        <h2>Starts December 1</h2>
        <p>Each day's door appears here when the event starts.</p>
      </div>
      {/* The empty calendar frame: it fills from the year's day data once
          that data exists — no invented doors before then (#126, #137). */}
      <div class="aoc-doors-empty" aria-hidden="true"></div>
    </section>

    <a class="to-top" href="#top">Back to top ↑</a>
    <script is:inline>
      const link = document.querySelector('.to-top');
      new IntersectionObserver(([entry]) =>
        link.classList.toggle('shown', !entry.isIntersecting)
      ).observe(document.querySelector('.aoc-intro'));
    </script>

    <script>
      // Year tabs (#126): click or arrow keys move the selection, and the
      // hidden panels keep the page one document for find-in-page.
      const tabs = [...document.querySelectorAll('.aoc-tab')];
      const panels = tabs.map(tab => document.getElementById(tab.getAttribute('aria-controls')));

      function select(index, focus) {
        tabs.forEach((tab, at) => {
          const active = at === index;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          panels[at].hidden = !active;
        });
        if (focus) tabs[index].focus();
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => select(index, false));
        tab.addEventListener('keydown', event => {
          const move = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1
            : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 0;
          if (!move) return;
          event.preventDefault();
          select((index + move + tabs.length) % tabs.length, true);
        });
      });

      // A #aoc-tab-<year> or #aoc-day-<year>-<n> hash opens that year's tab
      // first, so a year or day link is shareable. On opening this module
      // script runs before the browser scrolls to the fragment. On a later
      // hash change (a pasted link, Back or Forward) the browser has already
      // tried and failed to scroll to a hidden target, so the scroll is ours.
      function openHash(scroll) {
        const day = /^#aoc-day-(\d+)-/.exec(location.hash);
        const initial = tabs.findIndex(tab => tab.id === (day ? `aoc-tab-${day[1]}` : location.hash.slice(1)));
        if (initial === -1) return;
        select(initial, false);
        if (scroll) document.getElementById(location.hash.slice(1))?.scrollIntoView();
      }
      openHash(false);
      window.addEventListener('hashchange', () => openHash(true));
    </script>

    <script>
      // Run panels (#128), the examples-page wiring over the shared shim:
      // the artifact is fetched lazily on first Run through fetchArtifact
      // (runZhex compiles a fresh instance per call, so each click is a
      // clean run), and the box takes the sample prefill or any pasted
      // puzzle input — "text" needs no shape check, the interpreter's own
      // traps are the backstop.
      import { runZhex } from "../scripts/zhex-run.mjs";
      import { fetchArtifact, loadFailedMessage } from "../scripts/artifact.mjs";

      const decoder = new TextDecoder();

      function withErrorLine(stdout, error) {
        if (!error) return stdout;
        return stdout && !stdout.endsWith("\n") ? `${stdout}\n${error}` : stdout + error;
      }

      for (const panel of document.querySelectorAll(".aoc-run-panel")) {
        const button = panel.querySelector("button");
        const input = panel.querySelector("textarea");
        const output = panel.querySelector("[data-run-output]");
        const pane = output.closest("pre");
        const showMessage = (text) => {
          pane.classList.add("run-error");
          output.textContent = text;
        };
        button.addEventListener("click", async () => {
          button.disabled = true;
          try {
            const bytes = await fetchArtifact(panel.dataset.wasm);
            const { stdout, error } = runZhex(bytes, { stdin: input ? input.value : "" });
            const text = decoder.decode(stdout);
            if (error) showMessage(withErrorLine(text, error));
            else {
              pane.classList.remove("run-error"); // a clean re-run unwraps the pane again
              output.textContent = text;
            }
          } catch (error) {
            showMessage(error?.message ?? loadFailedMessage); // curated artifact messages and runZhex's raw errors alike
          } finally {
            button.disabled = false;
          }
        });
      }
    </script>
  </main>
</Base>

---
import Base from "../layouts/Base.astro";
import data from "../../data.json";

// The playground's example index (#88): the slim slice of the example data
// the page needs to assemble an "Open in playground" payload — entry source,
// module siblings for the resolve hook, and the #107 input-box declaration.
// The page never imports the full example data with its highlighted sources.
const index = data.Examples.map(e => ({
  id: e.ID,
  source: e.Source,
  stdin: e.Stdin,
  kind: e.InputKind,
  lines: e.InputLines,
  hint: e.InputHint,
  modules: (e.Modules || []).map(m => ({ name: m.File.replace(/\.zhex$/, ""), source: m.Source })),
}));
---
<Base title="Playground — Zhex" description="Write Zhex in your browser and run it — nothing to install." current="playground">
  <main id="main" class="wrap">
    <section class="page-intro playground-intro">
      <p class="eyebrow">Try Zhex, right here</p>
      <h1 id="playground-title">Playground.</h1>
      <p class="lede">Write Zhex in your browser and run it — nothing to install.</p>
      <p class="aside">Programs read the input box as their text; a read past its end opens a live input line under the output, so the program can wait for typed lines. The browser has no filesystem, no program arguments, and no environment file — words that need them say so when a program runs. <a class="text-link" href="examples.html">The examples page →</a> links every card here for editing.</p>
    </section>

    <section class="playground" aria-labelledby="playground-title">
      <div class="pg-cover">
        <p>The interpreter loads in your browser when you open the playground — nothing runs on a server, and nothing you write leaves the page.</p>
        <button class="button pg-open" type="button">Open playground <span aria-hidden="true">→</span></button>
        <p class="pg-loading" role="status" hidden>Loading Zhex…</p>
        <p class="pg-unsupported" role="alert" hidden>This browser can't run the playground — it lacks WebAssembly support. Zhex needs roughly Chrome 119+, Firefox 120+, or Safari 18.2+.</p>
        <p class="pg-load-failed" role="alert" hidden>The playground could not load. Check your connection and reload the page to try again.</p>
      </div>

      <div class="pg-active" hidden>
        <div class="pg-input-card" hidden>
          <label class="run-label" for="pg-stdin">Program input</label>
          <p class="run-input-hint" id="pg-stdin-hint"></p>
          <textarea id="pg-stdin" rows={4} spellcheck="false" aria-describedby="pg-stdin-hint"></textarea>
          <p class="run-input-error" role="alert" hidden></p>
        </div>

        <div class="pg-modes" role="tablist" aria-label="Playground modes">
          <button class="pg-mode" id="pg-tab-run" type="button" role="tab" aria-selected="true" aria-controls="pg-panel-run">Run</button>
          <button class="pg-mode" id="pg-tab-repl" type="button" role="tab" aria-selected="false" aria-controls="pg-panel-repl" tabindex="-1">REPL</button>
        </div>

        <section class="pg-panel" id="pg-panel-run" role="tabpanel" aria-labelledby="pg-tab-run">
          <label class="run-label" for="pg-editor">Program</label>
          <textarea class="pg-editor" id="pg-editor" rows={16} spellcheck="false" autoCapitalize="off" autoComplete="off"></textarea>
          <div class="pg-run-actions">
            <button class="button pg-run" type="button">Run <span aria-hidden="true">→</span></button>
            <button class="button pg-stop pg-stop-run" type="button" disabled>Stop</button>
            <button class="button pg-copy" type="button">Copy link</button>
          </div>
          <p class="pg-copy-note" role="status" hidden></p>
          <div class="pg-result">
            <h4>Output</h4>
            <pre aria-live="polite"><samp data-pg-output></samp></pre>
            <div class="pg-live" data-pg-live hidden>
              <label class="run-label" for="pg-live-input">Type a line</label>
              <p class="pg-live-hint">The program reads each line as you send it. End input ends the program's input — a read after that reports end-of-file.</p>
              <div class="pg-live-row">
                <input class="pg-live-input" id="pg-live-input" type="text" spellcheck="false" autoCapitalize="off" autoComplete="off">
                <button class="button pg-send" type="button">Send</button>
                <button class="button pg-end-input" type="button">End input</button>
              </div>
            </div>
            <h4>Diagnostics</h4>
            <div class="pg-diagnostics" data-pg-diagnostics aria-live="polite"></div>
          </div>
        </section>

        <section class="pg-panel" id="pg-panel-repl" role="tabpanel" aria-labelledby="pg-tab-repl" hidden>
          <p class="pg-repl-help">Type an entry and press Enter — a finished entry runs at once, an unfinished one waits for a blank line. Tab indents. Entries read the Program input box; a read past its end reports end-of-file.</p>
          <div class="pg-transcript" data-pg-transcript aria-live="polite"></div>
          <label class="run-label" for="pg-entry">Entry</label>
          <textarea class="pg-editor pg-entry" id="pg-entry" rows={4} spellcheck="false" autoCapitalize="off" autoComplete="off"></textarea>
          <div class="pg-run-actions">
            <button class="button pg-tour" type="button">Run the tour</button>
            <button class="button pg-stop pg-stop-repl" type="button" disabled>Stop</button>
            <button class="button pg-copy pg-copy-repl" type="button">Copy link</button>
          </div>
          <p class="pg-copy-note pg-copy-note-repl" role="status" hidden></p>
        </section>
      </div>
    </section>

    <a class="to-top" href="#top">Back to top ↑</a>
    <script is:inline>
      const link = document.querySelector('.to-top');
      new IntersectionObserver(([entry]) =>
        link.classList.toggle('shown', !entry.isIntersecting)
      ).observe(document.querySelector('.playground-intro'));
    </script>
    <script is:inline define:vars={{ indexJson: JSON.stringify(index) }}>
      window.pgIndex = JSON.parse(indexJson);
    </script>

    <script>
      // The browser playground (#88) over the shared #91 engine (#224): the
      // engine lives in a Web Worker, so a program that never ends cannot
      // freeze the page — Stop ends the worker and the next run starts a
      // fresh one. The load still waits for the open click. Two modes over
      // the worker: Run (runSource, falling back to runInteractive when the
      // program outreads its box — #158) and REPL (newSession, with the
      // continuation probes mirroring the terminal REPL's law entry for
      // entry). Share links carry source, input, mode, and module siblings
      // in the URL fragment; example cards arrive through ?example=<id>.
      import { inputProblem } from "../scripts/input-check.mjs";
      import workerSource from "../scripts/pg-engine-worker.mjs?raw";

      // BASE_URL arrives without its trailing slash in this build format;
      // every engine asset joins against the slash-terminated base.
      const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
      const index = window.pgIndex || [];
      const cover = document.querySelector(".pg-cover");
      const openButton = document.querySelector(".pg-open");
      const loading = document.querySelector(".pg-loading");
      const unsupported = document.querySelector(".pg-unsupported");
      const loadFailed = document.querySelector(".pg-load-failed");
      const active = document.querySelector(".pg-active");
      const inputCard = document.querySelector(".pg-input-card");
      const stdinBox = document.querySelector("#pg-stdin");
      const stdinHint = document.querySelector("#pg-stdin-hint");
      const stdinError = document.querySelector(".pg-input-card .run-input-error");
      const tabs = [...document.querySelectorAll(".pg-mode")];
      const panels = tabs.map(tab => document.getElementById(tab.getAttribute("aria-controls")));
      const runPanel = document.querySelector("#pg-panel-run");
      const editor = document.querySelector("#pg-editor");
      const runButton = document.querySelector(".pg-run");
      const runStop = document.querySelector(".pg-stop-run");
      const replStop = document.querySelector(".pg-stop-repl");
      const output = document.querySelector("[data-pg-output]");
      const liveBlock = document.querySelector("[data-pg-live]");
      const liveInput = document.querySelector("#pg-live-input");
      const sendButton = document.querySelector(".pg-send");
      const endInputButton = document.querySelector(".pg-end-input");
      const diagnostics = document.querySelector("[data-pg-diagnostics]");
      const replPanel = document.querySelector("#pg-panel-repl");
      const transcript = document.querySelector("[data-pg-transcript]");
      const entry = document.querySelector("#pg-entry");

      const tourProgram = `# A first look: one word, two printed lines.
word greet(name: String) -> String
    "Hello, " + name + "!"

print(greet("Zhex"))
print(greet("you"))
`;
      const tourEntries = [
        'print "Hello, Zhex!"',
        "2 + 3",
        'word greet(name: String) -> String\n    "Hello, " + name + "!"',
        'greet("Zhex")',
        "greet(42)", // the deliberate failure: a String word handed a number
      ];

      // --- the engine worker ---------------------------------------------
      //
      // One worker serves until Stop ends it; the next run starts a fresh
      // one. call() posts a request and answers with the reply carrying the
      // same id; runInteractive's replies keep coming after the call lands
      // (started), so its id moves to `streams` and its output chunks and
      // final result go to the handler below. Stop terminates the worker and
      // bumps workerGen, so an answer from a dead run is dropped instead of
      // landing in a new one's pane.

      const stopError = new Error("stopped");
      const loadError = new Error("the engine could not load");
      const crashError = new Error("the engine stopped unexpectedly");
      const workerUrl = URL.createObjectURL(new Blob([workerSource], { type: "text/javascript" }));
      const engineBase = new URL(base, location.href).href;
      let worker = null;
      let workerReady = null;
      let resolveReady = null;
      let rejectReady = null;
      let workerGen = 0;
      let callSeq = 0;
      const calls = new Map();
      const streams = new Map();
      let session = null;
      let sessionEnded = false;
      let moduleMap = {};
      let runActive = false;
      let entryDepth = 0;

      function ensureWorker() {
        if (!worker) {
          workerReady = new Promise((resolve, reject) => {
            resolveReady = resolve;
            rejectReady = reject;
          });
          worker = new Worker(workerUrl);
          worker.onmessage = event => route(event.data);
          // An error while the engine still loads is the load failing; once
          // loaded, the same event means the engine died mid-run.
          worker.onerror = () => failWorker(rejectReady ? loadError : crashError);
          worker.postMessage({ type: "init", base: engineBase });
        }
        return workerReady;
      }

      function dropWorker() {
        if (worker) worker.terminate();
        worker = null;
        resolveReady = null;
        rejectReady = null;
        workerReady = null;
        session = null;
      }

      function failWorker(rejection) {
        dropWorker();
        rejectCalls(rejection);
        if (rejectReady) rejectReady(rejection);
      }

      function rejectCalls(rejection) {
        for (const pending of calls.values()) pending.reject(rejection);
        calls.clear();
        streams.clear();
      }

      function call(message, onEvent) {
        if (!worker) return Promise.reject(stopError);
        return new Promise((resolve, reject) => {
          const id = ++callSeq;
          calls.set(id, { resolve, reject, gen: workerGen, onEvent: onEvent || null });
          worker.postMessage({ ...message, id });
        });
      }

      function route(message) {
        if (message.type === "ready") {
          const resolve = resolveReady;
          resolveReady = null;
          rejectReady = null;
          if (worker) worker.postMessage({ type: "resolve", modules: moduleMap });
          if (resolve) resolve(true);
          return;
        }
        if (message.type === "load-failed") {
          failWorker(loadError);
          return;
        }
        if (message.id === undefined) return;
        const pending = calls.get(message.id);
        if (pending) {
          if (pending.gen !== workerGen) { calls.delete(message.id); return; }
          if (message.type === "error") {
            calls.delete(message.id);
            pending.reject(new Error(message.message));
            return;
          }
          if (pending.onEvent) {
            // The live run: this first reply (started) resolves the call,
            // and the id's later messages stream to the handler.
            calls.delete(message.id);
            streams.set(message.id, { gen: pending.gen, onEvent: pending.onEvent });
            pending.resolve(message);
            return;
          }
          calls.delete(message.id);
          pending.resolve(message);
          return;
        }
        const stream = streams.get(message.id);
        if (stream) {
          if (stream.gen !== workerGen) { streams.delete(message.id); return; }
          if (message.type === "result") streams.delete(message.id);
          stream.onEvent(message);
        }
      }

      function syncModules() {
        if (worker) worker.postMessage({ type: "resolve", modules: moduleMap });
      }

      function updateStopButtons() {
        const busy = runActive || entryDepth > 0;
        runStop.disabled = !busy;
        replStop.disabled = !busy;
      }

      function stopRun() {
        const hadRun = runActive;
        const hadEntry = entryDepth > 0;
        if (!worker && !hadRun && !hadEntry) return;
        workerGen++;
        rejectCalls(stopError);
        if (rejectReady) rejectReady(stopError);
        dropWorker();
        liveRun = null;
        runActive = false;
        // A half-typed entry keeps its text; only the run state resets.
        pending = false;
        blockPending = false;
        openDelimiter = false;
        submitting = false;
        updateStopButtons();
        if (hadRun) {
          liveBlock.hidden = true;
          liveInput.disabled = false;
          sendButton.disabled = false;
          endInputButton.disabled = false;
          runButton.disabled = false;
          diagnostics.textContent = "The program was stopped.";
        }
        if (hadEntry) {
          transcriptBlock("The program was stopped. The session starts fresh — words defined earlier are gone.", "pg-out");
        }
      }

      runStop.addEventListener("click", stopRun);
      replStop.addEventListener("click", stopRun);

      // --- payloads ------------------------------------------------------

      // Share links carry everything in the fragment; example cards name the
      // id and the page rebuilds the payload from the build-time index.
      function decodePayload(hash) {
        if (!hash.startsWith("#p=")) return null;
        try {
          const payload = JSON.parse(decodeURIComponent(hash.slice(3)));
          return typeof payload.s === "string" ? payload : null;
        } catch {
          return null;
        }
      }

      function examplePayload(id) {
        const found = index.find(e => e.id === id);
        if (!found) return null;
        return {
          s: found.source,
          m: Object.fromEntries(found.modules.map(m => [m.name, m.source])),
          i: { stdin: found.stdin, kind: found.kind, lines: found.lines, hint: found.hint },
          r: "run",
        };
      }

      // --- the engine load, behind the one click ------------------------

      openButton.addEventListener("click", async () => {
        if (typeof WebAssembly === "undefined") {
          unsupported.hidden = false;
          return;
        }
        openButton.disabled = true;
        loading.hidden = false;
        try {
          // The engine itself downloads inside the worker; the worker
          // script is a local blob, so nothing is fetched before this click.
          await ensureWorker();
        } catch (failure) {
          loading.hidden = true;
          if (failure === stopError) openButton.disabled = false;
          else loadFailed.hidden = false;
          return;
        }
        loading.hidden = true;
        activate();
      });

      function activate() {
        const payload = decodePayload(location.hash)
          || examplePayload(new URLSearchParams(location.search).get("example"));
        const mode = payload?.r === "repl" ? "repl" : "run";
        moduleMap = payload?.m || {};
        syncModules();

        editor.value = payload ? payload.s : tourProgram;
        setUpInput(payload?.i);
        if (mode === "repl") {
          entry.value = payload ? payload.s : "";
          selectMode(1, false);
        } else {
          selectMode(0, false);
        }
        cover.hidden = true;
        active.hidden = false;
        // A shipped Run link runs as it loads; a REPL link waits for the
        // visitor's Enter, like the terminal. The fragment-less empty state
        // is the tour: the program runs, and the REPL fires its entries.
        if (mode === "run") run();
      }

      function setUpInput(input) {
        const declared = input || { kind: "text", hint: "The program reads this box as its input." };
        if (declared.kind === "none") return; // a program that reads nothing offers no box
        stdinBox.value = declared.stdin || "";
        stdinHint.textContent = declared.hint || "The program reads this box as its input.";
        stdinBox.dataset.kind = declared.kind;
        stdinBox.dataset.lines = String(declared.lines || 0);
        inputCard.hidden = false;
      }

      function stdinValue() {
        return inputCard.hidden ? "" : stdinBox.value;
      }

      // --- mode switch (the #126 tab pattern) ---------------------------

      function selectMode(indexToSelect, focus) {
        tabs.forEach((tab, at) => {
          const isActive = at === indexToSelect;
          tab.setAttribute("aria-selected", String(isActive));
          tab.tabIndex = isActive ? 0 : -1;
          panels[at].hidden = !isActive;
        });
        // The REPL's empty state is the tour: a first arrival with nothing
        // typed fires it, exactly as shipped.
        if (indexToSelect === 1 && transcript.childElementCount === 0 && entry.value.trim() === "" && !sessionEnded) runTour();
        if (focus) tabs[indexToSelect].focus();
      }

      tabs.forEach((tab, indexToSelect) => {
        tab.addEventListener("click", () => selectMode(indexToSelect, false));
        tab.addEventListener("keydown", event => {
          const move = event.key === "ArrowRight" || event.key === "ArrowDown" ? 1
            : event.key === "ArrowLeft" || event.key === "ArrowUp" ? -1 : 0;
          if (!move) return;
          event.preventDefault();
          selectMode((indexToSelect + move + tabs.length) % tabs.length, true);
        });
      });

      // --- Run mode ------------------------------------------------------

      runButton.addEventListener("click", run);

      function run() {
        const problem = inputCard.hidden ? "" : inputProblem(stdinBox.dataset.kind || "text", Number(stdinBox.dataset.lines || 0), stdinBox.value);
        if (problem) {
          stdinError.textContent = problem;
          stdinError.hidden = false;
          return;
        }
        if (stdinError) stdinError.hidden = true;
        runButton.disabled = true;
        const source = editor.value;
        // A program that reads with no input supplied goes interactive at
        // once (#158, over the #122 seam); a prefilled run keeps the
        // one-shot path, restarting live only when the program outreads
        // the box. The REPL seam cannot park a synchronous entry, so this
        // is Run mode only.
        if (readsInput(source) && stdinValue() === "") {
          beginInteractive(source, [], "");
          return;
        }
        runActive = true;
        updateStopButtons();
        (async () => {
          try {
            await ensureWorker();
            const answer = await call({ type: "runSource", source, stdin: stdinValue() });
            runActive = false;
            updateStopButtons();
            if (readPastBox(answer.result)) {
              beginInteractive(source, suppliedLines(),
                "The program read past the input box, so it started again with the box's lines sent.");
              return;
            }
            runButton.disabled = false;
            output.textContent = answer.result.output;
            renderDiagnostics(source, answer.result);
          } catch (failure) {
            runActive = false;
            updateStopButtons();
            runButton.disabled = false;
            if (failure === stopError) return; // the stop already said so
            diagnostics.textContent = failure === loadError
              ? "The playground could not load. Check your connection and reload the page to try again."
              : `The run failed — ${failure.message}.`;
          }
        })();
      }

      // The word read-line as a standalone name — hyphens join names, so
      // read-line-helper is a different word and must not match.
      const readsInput = source => /(?<![\w-])read-line(?![\w-])/.test(source);

      // The one-shot run's exhausted-stdin signature: the console-input
      // end-of-input report, raised only when a read finds no input left.
      function readPastBox(result) {
        if (!result.report) return false;
        try {
          const report = JSON.parse(result.report);
          return report.code === "console-input" && report.message === "end of input";
        } catch {
          return false;
        }
      }

      // The box's lines, without the empty tail a trailing newline leaves.
      function suppliedLines() {
        const lines = stdinValue().split("\n");
        if (lines.length > 0 && lines[lines.length - 1] === "") lines.pop();
        return lines;
      }

      // --- the live run: output streams, sent lines deliver (#122) ------

      let liveRun = null;

      function beginInteractive(source, supplied, note) {
        liveRun = null;
        runButton.disabled = true;
        output.textContent = "";
        diagnostics.textContent = "";
        if (note) {
          const noteLine = document.createElement("p");
          noteLine.className = "pg-live-note";
          noteLine.textContent = note;
          diagnostics.append(noteLine);
        }
        liveInput.value = "";
        liveInput.disabled = false;
        sendButton.disabled = false;
        endInputButton.disabled = false;
        liveBlock.hidden = false;
        runActive = true;
        updateStopButtons();
        (async () => {
          try {
            await ensureWorker();
            await call({ type: "runInteractive", source }, message => {
              if (message.type === "output") {
                // One text node per run: a program printing in a loop would
                // otherwise leave thousands of sibling nodes behind.
                if (output.lastChild instanceof Text) output.lastChild.data += message.text;
                else output.append(message.text);
                return;
              }
              finishInteractive(source, message.result);
            });
            liveRun = true;
            for (const line of supplied) worker.postMessage({ type: "deliver", line });
            liveInput.focus();
          } catch (failure) {
            runActive = false;
            updateStopButtons();
            liveRun = null;
            liveBlock.hidden = true;
            runButton.disabled = false;
            if (failure === stopError) return; // the stop already said so
            diagnostics.textContent = `The interactive run could not start — ${failure.message}.`;
          }
        })();
      }

      function finishInteractive(source, result) {
        liveRun = null;
        runActive = false;
        updateStopButtons();
        liveBlock.hidden = true;
        output.textContent = result.output;
        renderDiagnostics(source, result);
        runButton.disabled = false;
      }

      function sendLine() {
        if (!liveRun || !worker) return;
        worker.postMessage({ type: "deliver", line: liveInput.value.replace(/\r$/, "") });
        liveInput.value = "";
        liveInput.focus();
      }

      function endInteractiveInput() {
        if (!liveRun || !worker) return;
        worker.postMessage({ type: "closeInput" });
        liveInput.disabled = true;
        sendButton.disabled = true;
        endInputButton.disabled = true;
      }

      sendButton.addEventListener("click", sendLine);
      endInputButton.addEventListener("click", endInteractiveInput);
      liveInput.addEventListener("keydown", event => {
        if (event.key !== "Enter") return;
        event.preventDefault();
        sendLine();
      });

      function renderDiagnostics(source, result) {
        diagnostics.textContent = "";
        if (result.report) {
          try {
            diagnosticBlock(diagnostics, source, JSON.parse(result.report));
            return;
          } catch {
            diagnostics.textContent = result.report; // the plain envelope, if the shape ever surprises us
          }
        } else if (result.diagnostics) {
          const pre = document.createElement("pre");
          pre.textContent = result.diagnostics;
          diagnostics.append(pre);
        } else if (result.exit !== 0) {
          diagnostics.textContent = `Exit status ${result.exit}.`;
        } else {
          diagnostics.textContent = "No problems.";
        }
      }

      // The --report=json envelope, rendered with the terminal's caret law:
      // file:line:column: message, the source excerpt, a caret spanning the
      // reported columns, then the hint.
      function diagnosticBlock(container, source, report) {
        const pre = document.createElement("pre");
        const lines = source.split("\n");
        const excerpt = report.line >= 1 && report.line <= lines.length ? lines[report.line - 1].replace(/\r$/, "") : "";
        let indent = report.column - 1;
        let width = 1;
        if (report.span_start_column > 0 && report.span_end_column - report.span_start_column > 1) {
          indent = report.span_start_column - 1;
          width = report.span_end_column - report.span_start_column;
        }
        if (indent < 0) indent = 0;
        if (width < 1) width = 1;
        pre.append(`${report.file}:${report.line}:${report.column}: ${report.message}\n`);
        if (excerpt) {
          pre.append(`    ${excerpt}\n`);
          const caret = document.createElement("span");
          caret.className = "pg-caret";
          caret.textContent = `    ${" ".repeat(indent)}${"^".repeat(width)}`;
          pre.append(caret);
        }
        if (report.hint) pre.append(`\nhint: ${report.hint}`);
        container.append(pre);
      }

      // --- share links ----------------------------------------------------

      for (const button of document.querySelectorAll(".pg-copy")) {
        button.addEventListener("click", () => {
          const replMode = button.classList.contains("pg-copy-repl");
          const payload = {
            s: replMode ? entry.value : editor.value,
            r: replMode ? "repl" : "run",
          };
          if (Object.keys(moduleMap).length > 0) payload.m = moduleMap;
          if (!inputCard.hidden) payload.i = { stdin: stdinBox.value, kind: stdinBox.dataset.kind || "text", lines: Number(stdinBox.dataset.lines || 0), hint: stdinHint.textContent };
          const url = `${location.origin}${location.pathname}#p=${encodeURIComponent(JSON.stringify(payload))}`;
          // The address bar carries the link too, so the URL stays shareable
          // even where the clipboard is blocked; a browser rejecting a long
          // URL must not block the clipboard write.
          try {
            history.replaceState(null, "", url.slice(location.origin.length));
          } catch {}
          const note = replMode ? document.querySelector(".pg-copy-note-repl") : document.querySelector(".pg-copy-note:not(.pg-copy-note-repl)");
          const write = navigator.clipboard?.writeText(url);
          if (!write) {
            note.textContent = "Copying needs a browser with clipboard support — select the address bar instead.";
            note.hidden = false;
            return;
          }
          write.then(() => {
            note.textContent = "Link copied.";
            note.hidden = false;
          }).catch(() => {
            note.textContent = "Copying was blocked — select the address bar instead.";
            note.hidden = false;
          }).finally(() => setTimeout(() => { note.hidden = true; }, 2500));
        });
      }

      // --- REPL mode: the terminal law, entry for entry ------------------
      //
      // Every entry runs on the worker, so the answers come back a message
      // later; the entries queue through one chain to keep their order, and
      // the session state lives in the worker (a fresh worker means a fresh
      // session).

      let pending = false;
      let blockPending = false;
      let openDelimiter = false;
      let submitting = false;
      let replChain = Promise.resolve();

      function queueRepl(step) {
        entryDepth += 1;
        updateStopButtons();
        const run = replChain.then(step);
        replChain = run.catch(() => {});
        const landed = () => { entryDepth -= 1; updateStopButtons(); };
        run.then(landed, landed);
      }

      function transcriptBlock(text, className) {
        const block = document.createElement("div");
        block.className = className;
        block.textContent = text;
        transcript.append(block);
      }

      const loadFailedCopy = "The playground could not load. Check your connection and reload the page to try again.";

      async function ensureSession() {
        await ensureWorker();
        if (!session) {
          await call({ type: "newSession", stdin: stdinValue() });
          session = true;
        }
      }

      async function runWordsStep() {
        transcriptBlock("words", "pg-in");
        try {
          await ensureSession();
          const answer = await call({ type: "words" });
          transcriptBlock(answer.list.join("\n"), "pg-out");
        } catch (failure) {
          if (failure !== stopError) transcriptBlock(failure === loadError ? loadFailedCopy : String(failure), "pg-fail");
        }
      }

      const queueWords = () => queueRepl(runWordsStep);

      async function fireEntry(source) {
        transcriptBlock(source, "pg-in");
        try {
          await ensureSession();
          const answer = await call({ type: "enter", source });
          const result = answer.result;
          if (answer.output) transcriptBlock(answer.output, "pg-out");
          if (result.echo) transcriptBlock(result.echo, "pg-out");
          if (answer.diagnostics) transcriptBlock(answer.diagnostics, "pg-fail");
          if (result.report) {
            try {
              diagnosticBlock(transcript, source, JSON.parse(result.report));
            } catch {
              transcriptBlock(result.report, "pg-fail");
            }
          } else if (result.error) {
            transcriptBlock(result.error, "pg-fail");
          }
          if (result.exit !== null && result.exit !== undefined) {
            transcriptBlock(`Exit status ${result.exit}. Reload the page for a fresh session.`, "pg-fail");
            sessionEnded = true;
            entry.disabled = true;
          }
        } catch (failure) {
          if (failure === stopError) return; // the stop already said so
          transcriptBlock(failure === loadError ? loadFailedCopy : String(failure), "pg-fail");
        }
      }

      // commentOnly mirrors the terminal driver: a source of only comment
      // lines cannot stand alone, so the entry stays pending.
      function commentOnly(source) {
        let comments = false;
        for (const line of source.split("\n")) {
          if (line === "") continue;
          if (!/^ *#/.test(line)) return false;
          comments = true;
        }
        return comments;
      }

      // continuationIndent mirrors the terminal editor: the open delimiter's
      // depth, else the last statement's indent, one level deeper while a
      // block body is still missing.
      function continuationIndent(probe, source) {
        if (probe.delimiter !== null && probe.delimiter !== undefined) return probe.delimiter;
        const last = source.split("\n").pop();
        let indent = last.match(/^ */)[0].length;
        if (probe.lastStatement !== null && probe.lastStatement !== undefined) indent = probe.lastStatement;
        if (probe.incomplete) indent += 4;
        return indent;
      }

      function insertAtCursor(text) {
        const at = entry.selectionStart ?? entry.value.length;
        const end = entry.selectionEnd ?? at;
        entry.value = entry.value.slice(0, at) + text + entry.value.slice(end);
        entry.setSelectionRange(at + text.length, at + text.length);
      }

      // The three continuation probes answer together in one round trip to
      // the worker; a stop while asking leaves the entry as the visitor
      // typed it (null sends submitLine home without touching anything).
      async function askProbe(source) {
        try {
          await ensureWorker();
          const answer = await call({ type: "probe", source });
          return answer.probe;
        } catch (failure) {
          if (failure === stopError) return null;
          throw failure;
        }
      }

      async function submitLine() {
        const at = entry.selectionStart ?? entry.value.length;
        const before = entry.value.slice(0, at);
        const startOfLine = before.lastIndexOf("\n") + 1;
        const line = before.slice(startOfLine).replace(/\r$/, "");
        const value = entry.value;

        if (submitting) return;
        submitting = true;
        try {
          if (!pending) {
            if (line.trim() === "") return;
            if (line === "words" && !commentOnly(before.slice(0, startOfLine))) {
              entry.value = "";
              queueWords();
              return;
            }
            if (commentOnly(value)) {
              pending = true;
              openDelimiter = false;
              blockPending = false;
              insertAtCursor("\n");
              return;
            }
            const probe = await askProbe(value);
            if (!probe) return;
            if (probe.incomplete) {
              pending = true;
              openDelimiter = probe.delimiter !== null && probe.delimiter !== undefined;
              blockPending = !openDelimiter;
              insertAtCursor("\n" + " ".repeat(continuationIndent(probe, value)));
              return;
            }
            entry.value = "";
            queueRepl(() => fireEntry(value));
            return;
          }

          const blank = line.trim() === "";
          if (!blank && line === "words" && commentOnly(before.slice(0, startOfLine))) {
            pending = false;
            entry.value = "";
            queueWords();
            return;
          }
          if (!blank || openDelimiter) {
            if (commentOnly(value)) {
              insertAtCursor("\n");
              return;
            }
            const probe = await askProbe(value);
            if (!probe) {
              pending = false;
              blockPending = false;
              return;
            }
            openDelimiter = probe.delimiter !== null && probe.delimiter !== undefined;
            if (openDelimiter || blockPending || probe.incomplete) {
              if (!openDelimiter && !blockPending) blockPending = true;
              insertAtCursor("\n" + " ".repeat(continuationIndent(probe, value)));
              return;
            }
            pending = false;
            blockPending = false;
            entry.value = "";
            queueRepl(() => fireEntry(value));
            return;
          }
          // A blank line with no open delimiter submits, without the blank.
          pending = false;
          blockPending = false;
          entry.value = "";
          queueRepl(() => fireEntry(before));
        } catch (failure) {
          if (failure !== stopError) transcriptBlock(failure === loadError ? loadFailedCopy : String(failure), "pg-fail");
        } finally {
          submitting = false;
        }
      }

      entry.addEventListener("keydown", event => {
        if (sessionEnded) return;
        if (event.key === "Tab" && !event.shiftKey) {
          event.preventDefault();
          insertAtCursor("    ");
          return;
        }
        if (event.key !== "Enter" || event.shiftKey) return;
        event.preventDefault();
        submitLine();
      });

      // The empty state's tour: an entry, a word definition, and a
      // deliberate failure showing its caret diagnostic — running exactly
      // as shipped.
      function runTour() {
        if (sessionEnded) return;
        for (const source of tourEntries) queueRepl(() => fireEntry(source));
      }

      document.querySelector(".pg-tour").addEventListener("click", runTour);

      // Editor nicety: Tab inserts the four-space indent everywhere.
      editor.addEventListener("keydown", event => {
        if (event.key !== "Tab" || event.shiftKey) return;
        event.preventDefault();
        const at = editor.selectionStart ?? 0;
        const end = editor.selectionEnd ?? at;
        editor.value = editor.value.slice(0, at) + "    " + editor.value.slice(end);
        editor.setSelectionRange(at + 4, at + 4);
      });
    </script>
  </main>
</Base>

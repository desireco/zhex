---
// #120: the docs landing retired — docs.html redirects to TL;DR.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/docs/tldr.html`;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta http-equiv="refresh" content={`0; url=${target}`}><link rel="canonical" href={`https://desireco.github.io${target}`}><title>Docs — Zhex</title><link rel="stylesheet" href={`${base}/styles.css`}></head><body><main class="wrap"><p>The docs landing moved. Continue to <a href={target}>TL;DR — Zhex in a minute</a>.</p></main></body></html>

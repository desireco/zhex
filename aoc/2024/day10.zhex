# Advent of Code 2024, day 10 — Hoof It (solution words).
# The topographic map holds heights 0 to 9. A trail climbs from a 0 to a 9,
# up exactly one per step, moving orthogonally. Part 1 scores each trailhead
# by the distinct 9s its trails reach — a breadth-first walk over a Map of
# visited "r:c" keys, the queue an index-walked List. Part 2 rates each
# trailhead by its distinct trails, every path counting separately; a
# recursive count walks the four uphill neighbors, and the strictly climbing
# trail keeps the call depth at ten.

## Parse the topographic map into its rows.
word parse(text: String) -> List<String>
    let grid: List<String> = []
    for line in text.split(text, "\n")
        if text.length(line) > 0
            let added = list.append(grid, line)
    grid

# The height at one position; every cell is a digit, so the catch only keeps
# the word pure.
word _height(grid: List<String>, r: Int, c: Int) -> Int
    text.to-int(text.slice(grid[r], c, c + 1)) catch -1

# Queue an in-bounds neighbor at the wanted height, encoded as
# row * width + column.
word _climb(grid: List<String>, queue: List<Int>, r: Int, c: Int, target: Int) -> Unit
    if r >= 0 and r < list.length(grid) and c >= 0 and c < text.length(grid[0])
        if _height(grid, r, c) == target
            let queued = list.append(queue, r * text.length(grid[0]) + c)

# How many distinct 9-height positions one trailhead's trails reach.
word _score(grid: List<String>, start-r: Int, start-c: Int) -> Int
    let visited: Map<String, Bool> = {}
    let queue: List<Int> = []
    let width = text.length(grid[0])
    let first = list.append(queue, start-r * width + start-c)
    var index = 0
    var nines = 0
    while index < list.length(queue)
        let pos = queue[index]
        let r = pos / width
        let c = pos % width
        let key = "" + r + ":" + c
        if not map.contains(visited, key)
            let seen = map.put(visited, key, true)
            if _height(grid, r, c) == 9
                nines = nines + 1
            else
                let next = _height(grid, r, c) + 1
                _climb(grid, queue, r - 1, c, next)
                _climb(grid, queue, r + 1, c, next)
                _climb(grid, queue, r, c - 1, next)
                _climb(grid, queue, r, c + 1, next)
        index = index + 1
    nines

## Sum the trailhead scores: the distinct 9s each 0-height position reaches.
word part-one(grid: List<String>) -> Int
    var total = 0
    for r in range(0, list.length(grid))
        for c in range(0, text.length(grid[0]))
            if _height(grid, r, c) == 0
                total = total + _score(grid, r, c)
    total

# How many distinct trails climb from one position to any 9.
word _paths(grid: List<String>, r: Int, c: Int) -> Int
    if _height(grid, r, c) == 9
        1
    else
        let next = _height(grid, r, c) + 1
        var total = 0
        if r > 0 and _height(grid, r - 1, c) == next
            total = total + _paths(grid, r - 1, c)
        if r < list.length(grid) - 1 and _height(grid, r + 1, c) == next
            total = total + _paths(grid, r + 1, c)
        if c > 0 and _height(grid, r, c - 1) == next
            total = total + _paths(grid, r, c - 1)
        if c < text.length(grid[0]) - 1 and _height(grid, r, c + 1) == next
            total = total + _paths(grid, r, c + 1)
        total

## Sum the trailhead ratings: every distinct trail counts, even ones sharing
## a summit.
word part-two(grid: List<String>) -> Int
    var total = 0
    for r in range(0, list.length(grid))
        for c in range(0, text.length(grid[0]))
            if _height(grid, r, c) == 0
                total = total + _paths(grid, r, c)
    total

# Advent of Code 2024, day 10 — Hoof It.
# Reads the topographic map from stdin until end of input, prints both
# answers.

word main()
    # shortcut: a map row is digits, so this sentinel cannot collide; it stands
    # in for the end-of-file failure because error.detail is not compiled to
    # wasm yet (#135)
    let input = buffer.new()
    var done = false
    while not done
        let line = read-line("") catch "~end-of-input~"
        if line == "~end-of-input~"
            done = true
        else
            let added = buffer.add-line(input, line)
    let grid = parse(buffer.to-text(input))
    print(part-one(grid))
    print(part-two(grid))

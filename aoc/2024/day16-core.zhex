# Advent of Code 2024, day 16 — Reindeer Maze (solution words).
# The maze holds walls, S, and E; the reindeer starts at S facing east,
# pays 1 per forward step and 1000 per 90-degree turn. Both parts run a
# shortest-cost search over position-and-direction states: part 1 reads
# the lowest score at E, part 2 counts the tiles on any best route by
# meeting a forward search from S with a backward search from E.

## Parse the maze into its rows.
word parse(text: String) -> List<String>
    let grid: List<String> = []
    for line in text.split(text, "\n")
        if text.length(line) > 0
            list.append(grid, line)
    grid

## The row holding a marker, or -1 when absent.
word _row(grid: List<String>, marker: String) -> Int
    var found = -1
    var index = 0
    while found == -1 and index < list.length(grid)
        if text.index-of(grid[index], marker) >= 0
            found = index
        index = index + 1
    found

## The column holding a marker on its row, or -1 when absent.
word _column(grid: List<String>, marker: String) -> Int
    let row = _row(grid, marker)
    if row == -1
        -1
    else
        text.index-of(grid[row], marker)

## The row delta of a direction index: 0 up, 1 east, 2 down, 3 west.
word _dr(direction: Int) -> Int
    if direction == 0
        -1
    elif direction == 2
        1
    else
        0

## The column delta of a direction index.
word _dc(direction: Int) -> Int
    if direction == 1
        1
    elif direction == 3
        -1
    else
        0

## One position-and-direction search state.
type Pos = record
    r: Int
    c: Int
    d: Int

## The map key of a state.
word _key(pos: Pos) -> String
    "" + pos.r + ":" + pos.c + ":" + pos.d

## A state's best cost, with 999999999 standing in for unreached.
word _get(dist: Map<String, Int>, key: String) -> Int
    match dist[key]
        case Option.Some(cost)
            cost
        case Option.None
            999999999

## Best costs from S facing east to every state, by queue relaxation: each
## improved state re-enters the queue, so costs converge like Dijkstra
## without a priority queue.
word _forward(grid: List<String>) -> Map<String, Int>
    let dist: Map<String, Int> = {}
    let queue: List<Pos> = []
    let start = Pos(_row(grid, "S"), _column(grid, "S"), 1)
    map.put(dist, _key(start), 0)
    list.append(queue, start)
    var head = 0
    while head < list.length(queue)
        let here = queue[head]
        head = head + 1
        let cost = _get(dist, _key(here))
        for nd in [(here.d + 1) % 4, (here.d + 3) % 4]
            let turn-key = _key(Pos(here.r, here.c, nd))
            if cost + 1000 < _get(dist, turn-key)
                map.put(dist, turn-key, cost + 1000)
                list.append(queue, Pos(here.r, here.c, nd))
        let nr = here.r + _dr(here.d)
        let nc = here.c + _dc(here.d)
        if nr >= 0 and nr < list.length(grid) and nc >= 0 and nc < text.length(grid[nr]) and text.slice(grid[nr], nc, nc + 1) != "#"
            let step-key = _key(Pos(nr, nc, here.d))
            if cost + 1 < _get(dist, step-key)
                map.put(dist, step-key, cost + 1)
                list.append(queue, Pos(nr, nc, here.d))
    dist

## Best costs from every state to E, over the reversed moves: a turn stays
## a turn, a forward step is entered from the cell behind, and E in any of
## its four facings costs 0 because arriving is enough.
word _backward(grid: List<String>) -> Map<String, Int>
    let dist: Map<String, Int> = {}
    let queue: List<Pos> = []
    for d in range(0, 4)
        let goal = Pos(_row(grid, "E"), _column(grid, "E"), d)
        map.put(dist, _key(goal), 0)
        list.append(queue, goal)
    var head = 0
    while head < list.length(queue)
        let here = queue[head]
        head = head + 1
        let cost = _get(dist, _key(here))
        for nd in [(here.d + 1) % 4, (here.d + 3) % 4]
            let turn-key = _key(Pos(here.r, here.c, nd))
            if cost + 1000 < _get(dist, turn-key)
                map.put(dist, turn-key, cost + 1000)
                list.append(queue, Pos(here.r, here.c, nd))
        let pr = here.r - _dr(here.d)
        let pc = here.c - _dc(here.d)
        if pr >= 0 and pr < list.length(grid) and pc >= 0 and pc < text.length(grid[pr]) and text.slice(grid[pr], pc, pc + 1) != "#"
            let step-key = _key(Pos(pr, pc, here.d))
            if cost + 1 < _get(dist, step-key)
                map.put(dist, step-key, cost + 1)
                list.append(queue, Pos(pr, pc, here.d))
    dist

## The lowest score any route from S to E can earn.
word part-one(grid: List<String>) -> Int
    let dist = _forward(grid)
    var best = 999999999
    for d in range(0, 4)
        let cost = _get(dist, "" + _row(grid, "E") + ":" + _column(grid, "E") + ":" + d)
        if cost < best
            best = cost
    best

## Count the tiles on at least one best route: a tile qualifies when some
## facing's forward and backward costs meet at exactly the best score.
word part-two(grid: List<String>) -> Int
    let forward = _forward(grid)
    let backward = _backward(grid)
    let best = part-one(grid)
    var tiles = 0
    for r in range(0, list.length(grid))
        for c in range(0, text.length(grid[r]))
            if text.slice(grid[r], c, c + 1) != "#"
                var on-route = false
                for d in range(0, 4)
                    let key = "" + r + ":" + c + ":" + d
                    if _get(forward, key) + _get(backward, key) == best
                        on-route = true
                if on-route
                    tiles = tiles + 1
    tiles

# Advent of Code 2024, day 7 — Bridge Repair.
# Reads the calibration document from stdin until end of input, prints both
# answers.
use day07-core

# shortcut: an equation line holds digits, colons, and spaces only, so this
# sentinel cannot collide; it stands in for the end-of-file failure because
# error.detail is not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        buffer.add-line(input, line)
let equations = day07-core.parse(buffer.to-text(input)) try
print(day07-core.part-one(equations))
print(day07-core.part-two(equations))

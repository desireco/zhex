# Advent of Code 2024, day 18 — RAM Run (solution words).
# Bytes fall onto a grid of safe cells, corrupting their coordinates. The
# memory space is 71 by 71 with 1024 fallen bytes on the real input; the
# page's example is 7 by 7 with 12 bytes, and its input is exactly 25
# lines long, which is how the two shapes are told apart here. Part 1
# breadth-first searches the fewest steps from the top left to the bottom
# right after the first bytes fall. Part 2 finds the first byte whose fall
# blocks every path: blocking is monotone — once no path survives, no
# later byte frees one — so a binary search over the fall count lands on
# the exact boundary.

## One falling byte's coordinates.
type Byte = record
    x: Int
    y: Int

## The grid size, the part-one fall count, and the falling bytes in order.
type Space = record
    size: Int
    fall: Int
    bytes: List<Byte>

## Parse the x,y lines and pick the example or real shape.
word parse(text: String) -> Space
    let bytes: List<Byte> = []
    for line in text.split(text, "\n")
        if text.length(line) > 0
            let comma = text.index-of(line, ",")
            let x = text.to-int(text.slice(line, 0, comma)) catch 0
            let y = text.to-int(text.slice(line, comma + 1, text.length(line))) catch 0
            let added = list.append(bytes, Byte(x, y))
    if list.length(bytes) == 25
        Space(7, 12, bytes)
    else
        Space(71, 1024, bytes)

## The row delta of a direction index: 0 up, 1 right, 2 down, 3 left.
word _dr(direction: Int) -> Int
    if direction == 0
        -1
    elif direction == 2
        1
    else
        0

## The column delta of a direction index.
word _dc(direction: Int) -> Int
    if direction == 1
        1
    elif direction == 3
        -1
    else
        0

## A position's distance, with -1 standing in for unreached.
word _get(dist: Map<String, Int>, key: String) -> Int
    match dist[key]
        case Option.Some(steps)
            steps
        case Option.None
            -1

## Fewest steps from (0,0) to the far corner after count bytes have
## fallen, or -1 when no path survives. The queue holds positions packed
## as row times size plus column.
word _bfs(space: Space, count: Int) -> Int
    let blocked: Map<String, Bool> = {}
    for index in range(0, count)
        let byte = space.bytes[index]
        map.put(blocked, "" + byte.x + ":" + byte.y, true)
    let dist: Map<String, Int> = {}
    let queue: List<Int> = []
    map.put(dist, "0:0", 0)
    list.append(queue, 0)
    var head = 0
    var steps = -1
    while head < list.length(queue) and steps == -1
        let pos = queue[head]
        head = head + 1
        let r = pos / space.size
        let c = pos % space.size
        let here = _get(dist, "" + r + ":" + c)
        if r == space.size - 1 and c == space.size - 1
            steps = here
        else
            for d in range(0, 4)
                let nr = r + _dr(d)
                let nc = c + _dc(d)
                let key = "" + nr + ":" + nc
                if nr >= 0 and nr < space.size and nc >= 0 and nc < space.size and not map.contains(blocked, key) and not map.contains(dist, key)
                    map.put(dist, key, here + 1)
                    let added = list.append(queue, nr * space.size + nc)
    steps

## The fewest steps to the exit after the first fallen bytes.
word part-one(space: Space) -> Int
    _bfs(space, space.fall)

## The first byte whose fall blocks every path, as "x,y".
word part-two(space: Space) -> String
    var open = space.fall
    var blocked = list.length(space.bytes)
    while blocked - open > 1
        let mid = (open + blocked) / 2
        if _bfs(space, mid) == -1
            blocked = mid
        else
            open = mid
    let byte = space.bytes[blocked - 1]
    "" + byte.x + "," + byte.y

# Advent of Code 2024, day 18 — RAM Run.
# Reads the falling-byte coordinates from stdin until end of input,
# prints both answers.

word main()
    # shortcut: a byte line is two numbers around one comma, so this sentinel
    # cannot collide; it stands in for the end-of-input failure because
    # error.detail is not compiled to wasm yet (#135)
    let input = buffer.new()
    var done = false
    while not done
        let line = read-line("") catch "~end-of-input~"
        if line == "~end-of-input~"
            done = true
        else
            let added = buffer.add-line(input, line)
    let space = parse(buffer.to-text(input))
    print(part-one(space))
    print(part-two(space))

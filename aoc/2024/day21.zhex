# Advent of Code 2024, day 21 — Keypad Conundrum.
# Reads the door codes from stdin until end of input, prints both answers.
use day21-core

# shortcut: a code is digits plus A, so this sentinel cannot collide; it
# stands in for the end-of-file failure because error.detail is not compiled
# to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        let added = buffer.add-line(input, line)
let codes = day21-core.parse(buffer.to-text(input))
print(day21-core.part-one(codes))
print(day21-core.part-two(codes))

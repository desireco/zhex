# Advent of Code 2024, day 23 — LAN Party.
# Reads the connection list from stdin until end of input, prints both
# answers.
use day23-core

# shortcut: every line is a two-letter pair, so this sentinel cannot
# collide; it stands in for the end-of-file failure because error.detail is
# not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        let added = buffer.add-line(input, line)
let edges = day23-core.parse(buffer.to-text(input))
print(day23-core.part-one(edges))
print(day23-core.part-two(edges))

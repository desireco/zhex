# Advent of Code 2024, day 12 — Garden Groups (solution words).
# The grid stays a list of row strings; cells are encoded as
# row * width + column when collected. Regions grow by an iterative
# worklist — recursion would meet the 256-call depth limit on wide
# grids. Part 1 prices area times perimeter (perimeter edges are the
# four sides of each plot that do not touch the same region). Part 2
# prices area times sides: a region's sides equal its corners, both
# the outward ones and the inward notches, so corners are counted per
# plot by looking at the three plots around each of its four corners.

## Parse the non-empty input lines into the garden rows.
word parse(text: String) -> List<String>
    let grid: List<String> = []
    for line in text.split(text, "\n")
        if text.length(line) > 0
            list.append(grid, line)
    grid

# Whether the plot at the position holds the given plant; out of bounds
# is no, and regions are maximal, so this is the in-region test too.
word _same(grid: List<String>, row: Int, column: Int, plant: String) -> Bool
    if row < 0 or row >= list.length(grid) or column < 0 or column >= text.length(grid[row])
        false
    else
        text.slice(grid[row], column, column + 1) == plant

# Whether the encoded cell is already collected.
word _has(cells: List<Int>, id: Int) -> Bool
    var found = false
    for other in cells
        if other == id
            found = true
    found

# Add the neighbor to the region when it holds the same plant and is
# not collected yet; returns Unit and mutates both lists.
word _reach(grid: List<String>, cells: List<Int>, seen: List<Int>, row: Int, column: Int, plant: String, width: Int) -> Unit
    let id = row * width + column
    if _same(grid, row, column, plant) and not _has(seen, id)
        list.append(cells, id)
        list.append(seen, id)

# Collect one region, worklist style with a cursor instead of a pop.
word _region(grid: List<String>, row: Int, column: Int, seen: List<Int>) -> List<Int>
    let width = text.length(grid[0])
    let plant = text.slice(grid[row], column, column + 1)
    let cells: List<Int> = []
    list.append(cells, row * width + column)
    list.append(seen, row * width + column)
    var at = 0
    while at < list.length(cells)
        let id = cells[at]
        at = at + 1
        _reach(grid, cells, seen, id / width - 1, id % width, plant, width)
        _reach(grid, cells, seen, id / width + 1, id % width, plant, width)
        _reach(grid, cells, seen, id / width, id % width - 1, plant, width)
        _reach(grid, cells, seen, id / width, id % width + 1, plant, width)
    cells

# The plot's perimeter contribution: sides without a same-plant neighbor.
word _edges(grid: List<String>, row: Int, column: Int) -> Int
    let plant = text.slice(grid[row], column, column + 1)
    var edges = 0
    if not _same(grid, row - 1, column, plant)
        edges = edges + 1
    if not _same(grid, row + 1, column, plant)
        edges = edges + 1
    if not _same(grid, row, column - 1, plant)
        edges = edges + 1
    if not _same(grid, row, column + 1, plant)
        edges = edges + 1
    edges

## Total every region's area times its perimeter.
word part-one(grid: List<String>) -> Int
    let seen: List<Int> = []
    let width = text.length(grid[0])
    var total = 0
    for row, line in grid
        for column in range(0, text.length(line))
            if not _has(seen, row * width + column)
                let cells = _region(grid, row, column, seen)
                var perimeter = 0
                for id in cells
                    perimeter = perimeter + _edges(grid, id / width, id % width)
                total = total + list.length(cells) * perimeter
    total

# One plot's corners: outward where two orthogonal neighbors leave the
# region, inward where both stay and the diagonal neighbor leaves.
word _corners(grid: List<String>, row: Int, column: Int) -> Int
    let plant = text.slice(grid[row], column, column + 1)
    let north = _same(grid, row - 1, column, plant)
    let south = _same(grid, row + 1, column, plant)
    let west = _same(grid, row, column - 1, plant)
    let east = _same(grid, row, column + 1, plant)
    var corners = 0
    if not north and not west
        corners = corners + 1
    if not north and not east
        corners = corners + 1
    if not south and not west
        corners = corners + 1
    if not south and not east
        corners = corners + 1
    if north and west and not _same(grid, row - 1, column - 1, plant)
        corners = corners + 1
    if north and east and not _same(grid, row - 1, column + 1, plant)
        corners = corners + 1
    if south and west and not _same(grid, row + 1, column - 1, plant)
        corners = corners + 1
    if south and east and not _same(grid, row + 1, column + 1, plant)
        corners = corners + 1
    corners

## Total every region's area times its number of fence sides.
word part-two(grid: List<String>) -> Int
    let seen: List<Int> = []
    let width = text.length(grid[0])
    var total = 0
    for row, line in grid
        for column in range(0, text.length(line))
            if not _has(seen, row * width + column)
                let cells = _region(grid, row, column, seen)
                var sides = 0
                for id in cells
                    sides = sides + _corners(grid, id / width, id % width)
                total = total + list.length(cells) * sides
    total

# Advent of Code 2024, day 12 — Garden Groups.
# Reads the garden map from stdin until end of input, prints both answers.

word main()
    # shortcut: a garden row is plant letters only, so this sentinel cannot
    # collide; it stands in for the end-of-file failure because error.detail
    # is not compiled to wasm yet (#135)
    let input = buffer.new()
    var done = false
    while not done
        let line = read-line("") catch "~end-of-input~"
        if line == "~end-of-input~"
            done = true
        else
            buffer.add-line(input, line)
    let grid = parse(buffer.to-text(input))
    print(part-one(grid))
    print(part-two(grid))

# Advent of Code 2024, day 13 — Claw Contraption.
# Reads the claw machines from stdin until end of input, prints both answers.
use day13-core

# The machine blocks are separated by blank lines, so the runner reads to
# end-of-file the same way day 5 does: branching on the end-of-file detail
# (error.detail), which is fenced in the browser build (#135), and the
# sentinel workaround days 1-4 use cannot detect end-of-file either. The
# door carries the fence note until the engine lane fixes #135.
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch problem
        if error.detail(problem, "reason") == "end-of-file"
            done = true
            ""
        else
            error.message(problem)
    if not done
        buffer.add-line(input, line)
let machines = day13-core.parse(buffer.to-text(input)) try
print(day13-core.part-one(machines))
print(day13-core.part-two(machines))

use day07
use test

let sample = "190: 10 19\n3267: 81 40 27\n83: 17 5\n156: 15 6\n7290: 6 8 6 15\n161011: 16 10 13\n192: 17 8 14\n21037: 9 7 18 13\n292: 11 6 16 20"
let equations = day07.parse(sample) try

test.check(day07.part-one(equations) == 3749, "day 7 part 1")
test.check(day07.part-two(equations) == 11387, "day 7 part 2")
print "day 7 tests passed"

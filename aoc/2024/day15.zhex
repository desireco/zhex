# Advent of Code 2024, day 15 — Warehouse Woes.
# Reads the warehouse map and moves from stdin until end of input, prints both answers.
use day15-core

# The map and the moves are separated by a blank line, so the runner
# reads to end-of-file the same way day 5 does: branching on the
# end-of-file detail (error.detail), which is fenced in the browser
# build (#135), and the sentinel workaround days 1-4 use cannot cover a
# blank line either — the browser read-line traps on an empty line
# before any catch could run (#155). The door carries the fence note
# until the engine lane fixes either gap.
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch problem
        if error.detail(problem, "reason") == "end-of-file"
            done = true
            ""
        else
            error.message(problem)
    if not done
        buffer.add-line(input, line)
let warehouse = day15-core.parse(buffer.to-text(input))
print(day15-core.part-one(warehouse))
print(day15-core.part-two(warehouse))

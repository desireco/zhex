use day20-core
use test

# The page's example track. Its best time is 84 picoseconds, far under the
# real racetrack's 100-picosecond threshold, so the checks use the page's
# own example conventions: part 1 counts cheats saving at least 12 (the
# page's group list holds exactly 8 there), part 2 cheats of up to 20
# steps saving at least 76.
let sample = "###############\n#...#...#.....#\n#.#.#.#.#.###.#\n#S#...#.#.#...#\n#######.#.#.###\n#######.#.#...#\n#######.#.###.#\n###..E#...#...#\n###.#######.###\n#...###...#...#\n#.#####.#.###.#\n#.#...#.#.#...#\n#.#.#.#.#.#.###\n#...#...#...###\n###############"
let track = day20-core.parse(sample)

test.check(day20-core.part-one(track, 12) == 8, "day 20 part 1")
test.check(day20-core.part-two(track, 76) == 3, "day 20 part 2")
print "day 20 tests passed"

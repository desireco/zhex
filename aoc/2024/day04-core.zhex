# Advent of Code 2024, day 4 — Ceres Search (solution words).
# The grid stays a list of row strings. Part 1 counts XMAS spellings in
# all eight directions from each X; part 2 counts MAS crosses around
# each A center.

type Offset = record
    dr: Int
    dc: Int

## Parse the non-empty input lines into the grid rows.
word parse(text: String) -> List<String>
    let grid: List<String> = []
    for line in text.split(text, "\n")
        if text.length(line) > 0
            list.append(grid, line)
    grid

word _cell(grid: List<String>, row: Int, column: Int) -> String
    if row < 0 or row >= list.length(grid) or column < 0 or column >= text.length(grid[row])
        ""
    else
        text.slice(grid[row], column, column + 1)

word _offsets() -> List<Offset>
    [Offset(0, 1), Offset(0, -1), Offset(1, 0), Offset(-1, 0), Offset(1, 1), Offset(1, -1), Offset(-1, 1), Offset(-1, -1)]

# Whether MAS continues from an X along one offset, bounds included.
word _spells-mas(grid: List<String>, row: Int, column: Int, step: Offset) -> Bool
    var spells = true
    var index = 1
    while spells and index <= 3
        let want = text.slice("MAS", index - 1, index)
        if _cell(grid, row + step.dr * index, column + step.dc * index) != want
            spells = false
        index = index + 1
    spells

## Count XMAS spellings in all eight directions, overlaps included.
word part-one(grid: List<String>) -> Int
    var count = 0
    for row, line in grid
        for column in range(0, text.length(line))
            if _cell(grid, row, column) == "X"
                for step in _offsets()
                    if _spells-mas(grid, row, column, step)
                        count = count + 1
    count

# Whether one diagonal pair holds M and S in either order.
word _is-mas-pair(first: String, second: String) -> Bool
    (first == "M" and second == "S") or (first == "S" and second == "M")

## Count X-shaped MAS crosses: an A center whose two diagonals each
## hold M and S on opposite ends.
word part-two(grid: List<String>) -> Int
    var count = 0
    for row in range(1, list.length(grid) - 1)
        for column in range(1, text.length(grid[row]) - 1)
            if _cell(grid, row, column) == "A"
                if _is-mas-pair(_cell(grid, row - 1, column - 1), _cell(grid, row + 1, column + 1)) and _is-mas-pair(_cell(grid, row - 1, column + 1), _cell(grid, row + 1, column - 1))
                    count = count + 1
    count

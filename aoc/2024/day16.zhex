# Advent of Code 2024, day 16 — Reindeer Maze.
# Reads the maze from stdin until end of input, prints both answers.
use day16-core

# shortcut: a maze row is map characters, so this sentinel cannot collide;
# it stands in for the end-of-input failure because error.detail is not
# compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        let added = buffer.add-line(input, line)
let grid = day16-core.parse(buffer.to-text(input))
print(day16-core.part-one(grid))
print(day16-core.part-two(grid))

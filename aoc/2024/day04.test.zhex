use day04
use test

let sample = "MMMSXXMASM\nMSAMXMSMSA\nAMXSXMAAMM\nMSAMASMSMX\nXMASAMXAMM\nXXAMMXXAMA\nSMSMSASXSS\nSAXAMASAAA\nMAMMMXMMMM\nMXMXAXMASX"
let grid = day04.parse(sample)

test.check(day04.part-one(grid) == 18, "day 4 part 1")
test.check(day04.part-two(grid) == 9, "day 4 part 2")
print "day 4 tests passed"

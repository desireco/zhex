# Advent of Code 2024, day 2 — Red-Nosed Reports (solution words).
# A report is a row of levels; it is safe when every step moves the same
# way by 1 to 3. Part 1 counts the safe reports; part 2 also accepts a
# report when removing one level makes it safe.

## Parse the space-separated level rows into one list per report.
word parse(text: String) -> List<List<Int>>
    let reports: List<List<Int>> = []
    for line in text.split(text, "\n")
        if text.length(line) > 0
            let levels: List<Int> = []
            for field in text.split(line, " ")
                list.append(levels, text.to-int(field) try)
            list.append(reports, levels)
    reports

# All steps must share one direction and stay within 1..3 in size.
word _safe(levels: List<Int>) -> Bool
    var increasing = true
    var decreasing = true
    var bounded = true
    for index in range(1, list.length(levels))
        let step = levels[index] - levels[index - 1]
        if step <= 0
            increasing = false
        if step >= 0
            decreasing = false
        if step < -3 or step > 3
            bounded = false
    (increasing or decreasing) and bounded

## Count the reports that are safe as they arrive.
word part-one(reports: List<List<Int>>) -> Int
    var safe-count = 0
    for report in reports
        if _safe(report)
            safe-count = safe-count + 1
    safe-count

word _without(levels: List<Int>, skip: Int) -> List<Int>
    let rest: List<Int> = []
    for index, value in levels
        if index != skip
            list.append(rest, value)
    rest

## Count the reports that are safe, one removable level tolerated.
word part-two(reports: List<List<Int>>) -> Int
    var safe-count = 0
    for report in reports
        if _safe(report)
            safe-count = safe-count + 1
        else
            var tolerated = false
            var skip = 0
            while not tolerated and skip < list.length(report)
                if _safe(_without(report, skip))
                    tolerated = true
                skip = skip + 1
            if tolerated
                safe-count = safe-count + 1
    safe-count

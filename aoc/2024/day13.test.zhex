use day13-core
use test

let sample = "Button A: X+94, Y+34\nButton B: X+22, Y+67\nPrize: X=8400, Y=5400\n\nButton A: X+26, Y+66\nButton B: X+67, Y+21\nPrize: X=12748, Y=12176\n\nButton A: X+17, Y+86\nButton B: X+84, Y=37\nPrize: X=7870, Y=6450\n\nButton A: X+69, Y+23\nButton B: X+27, Y=71\nPrize: X=18641, Y=10279"
let machines = day13-core.parse(sample) try

test.check(day13-core.part-one(machines) == 480, "day 13 part 1")
test.check(day13-core.part-two(machines) == 875318608908, "day 13 part 2")
print "day 13 tests passed"

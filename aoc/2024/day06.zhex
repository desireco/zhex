# Advent of Code 2024, day 6 — Guard Gallivant.
# Reads the lab map from stdin until end of input, prints both answers.
use day06-core

# shortcut: a lab row is ., #, and ^ characters, so this sentinel cannot
# collide; it stands in for the end-of-file failure because error.detail is
# not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        let added = buffer.add-line(input, line)
let grid = day06-core.parse(buffer.to-text(input))
print(day06-core.part-one(grid))
print(day06-core.part-two(grid))

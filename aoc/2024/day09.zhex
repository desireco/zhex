# Advent of Code 2024, day 9 — Disk Fragmenter.
# Reads the dense disk map from stdin until end of input, prints both
# answers.
use day09-core

# shortcut: the disk map is one line of digits, so this sentinel cannot
# collide; it stands in for the end-of-file failure because error.detail is
# not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        buffer.add-line(input, line)
let disk = day09-core.parse(buffer.to-text(input)) try
print(day09-core.part-one(disk))
print(day09-core.part-two(disk))

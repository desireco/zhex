# Advent of Code 2023, day 10 — Pipe Maze.
# Reads the pipe sketch from stdin until end of input, prints both answers.
use day10-core

# shortcut: a sketch row holds pipe shapes, dots, and the S marker, so
# this sentinel cannot collide; it stands in for the end-of-file failure
# because error.detail is not compiled to wasm yet
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        let added = buffer.add-line(input, line)
let grid = day10-core.parse(buffer.to-text(input))
print(day10-core.part-one(grid))
print(day10-core.part-two(grid))

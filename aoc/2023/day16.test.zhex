use day16-core
use test

let layout = ".|...\\....\n|.-.\\.....\n.....|-...\n........|.\n..........\n.........\\\n..../.\\\\..\n.-.-/..|..\n.|....-|.\\\n..//.|...."
test.check(day16-core.part-one(day16-core.parse(layout)) == 46, "day 16 part 1, energized tiles from the top left")
test.check(day16-core.part-two(day16-core.parse(layout)) == 51, "day 16 part 2, best edge entry")
print "day 16 tests passed"

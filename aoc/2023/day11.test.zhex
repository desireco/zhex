use day11
use test

let sample = "...#......\n.......#..\n#.........\n..........\n......#...\n.#........\n.........#\n..........\n.......#..\n#...#....."
let universe = day11.parse(sample)

test.check(day11.part-one(universe) == 374, "day 11 part 1")
test.check(day11.part-two(universe) == 82000210, "day 11 part 2")
print "day 11 tests passed"

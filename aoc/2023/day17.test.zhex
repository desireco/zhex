use day17
use test

let city = "2413432311323\n3215453535623\n3255245654254\n3446585845452\n4546657867536\n1438598798454\n4457876987766\n3637877979653\n4654967986887\n4564679986453\n1224686865563\n2546548887735\n4322674655533"
test.check(day17.part-one(day17.parse(city)) == 102, "day 17 part 1, least heat loss, crucible")
test.check(day17.part-two(day17.parse(city)) == 94, "day 17 part 2, least heat loss, ultra crucible")

let detour = "111111111111\n999999999991\n999999999991\n999999999991\n999999999991"
test.check(day17.part-two(day17.parse(detour)) == 71, "day 17 part 2, ultra crucible detour")
print "day 17 tests passed"

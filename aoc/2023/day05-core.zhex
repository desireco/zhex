# Advent of Code 2023, day 5 — If You Give A Seed A Fertilizer (solution
# words). The almanac lists seeds and a chain of maps, each line converting
# one span of source numbers onto a same-sized span of destination numbers
# with unmapped numbers passing through. Part 1 walks each seed through the
# chain and takes the lowest location. Part 2 reads the seed line as
# first/length pairs — billions of seeds — so the walk is symbolic: spans
# are split at every map boundary they cross and each piece shifts by the
# one range that contains it, never per-seed.

## One map line: destination start, source start, length.
type RangeMap = record
    destination: Int
    source: Int
    length: Int

## The almanac: seed numbers and the map levels, in chain order.
type Almanac = record
    seeds: List<Int>
    levels: List<List<RangeMap>>

# The numbers a space-separated line holds.
word _numbers(line: String) -> List<Int>
    let numbers: List<Int> = []
    for token in text.split(line, " ")
        if text.length(token) > 0
            list.append(numbers, text.to-int(token) try)
    numbers

## Parse the seed line and every map block into the chain.
word parse(text: String) -> Almanac
    let seeds: List<Int> = []
    let levels: List<List<RangeMap>> = []
    var current: List<RangeMap> = []
    for line in text.split(text, "\n")
        if text.length(line) > 0
            if text.starts-with(line, "seeds:")
                for number in _numbers(text.slice(line, 7, text.length(line))) try
                    list.append(seeds, number)
            elif text.ends-with(line, "map:")
                if list.length(current) > 0
                    list.append(levels, current)
                let fresh: List<RangeMap> = []
                current = fresh
            else
                let numbers = _numbers(line) try
                list.append(current, RangeMap(numbers[0], numbers[1], numbers[2]))
    if list.length(current) > 0
        list.append(levels, current)
    Almanac(seeds, levels)

# Where one number lands in one map level; unmapped numbers stay.
word _map-one(value: Int, ranges: List<RangeMap>) -> Int
    var result = value
    var handled = false
    for range-map in ranges
        if not handled and value >= range-map.source and value < range-map.source + range-map.length
            result = value - range-map.source + range-map.destination
            handled = true
    result

word _location(seed: Int, levels: List<List<RangeMap>>) -> Int
    var value = seed
    for ranges in levels
        value = _map-one(value, ranges)
    value

## The lowest location the listed seed numbers reach.
word part-one(almanac: Almanac) -> Int
    var lowest = _location(almanac.seeds[0], almanac.levels)
    for seed in almanac.seeds
        let location = _location(seed, almanac.levels)
        if location < lowest
            lowest = location
    lowest

## One inclusive span of seed numbers.
type Span = record
    first: Int
    last: Int

word _max(a: Int, b: Int) -> Int
    if a > b
        a
    else
        b

word _min(a: Int, b: Int) -> Int
    if a < b
        a
    else
        b

# Carry whole spans through one map level. Each span is cut against the
# first range it meets: the outside pieces go back on the pending list for
# the remaining ranges, the overlapping middle shifts by that range, and a
# span no range touches passes through unchanged. The index loop walks a
# list it appends to, so the pieces are re-examined, never lost.
word _map-spans(spans: List<Span>, ranges: List<RangeMap>) -> List<Span>
    let mapped: List<Span> = []
    let pending: List<Span> = []
    for span in spans
        list.append(pending, span)
    var index = 0
    while index < list.length(pending)
        let span = pending[index]
        var handled = false
        for range-map in ranges
            if not handled
                let source-last = range-map.source + range-map.length - 1
                if range-map.source <= span.last and span.first <= source-last
                    if span.first < range-map.source
                        list.append(pending, Span(span.first, range-map.source - 1))
                    if source-last < span.last
                        list.append(pending, Span(source-last + 1, span.last))
                    let lo = _max(span.first, range-map.source)
                    let hi = _min(span.last, source-last)
                    list.append(mapped, Span(lo - range-map.source + range-map.destination, hi - range-map.source + range-map.destination))
                    handled = true
        if not handled
            list.append(mapped, span)
        index = index + 1
    mapped

## The lowest location any seed in the seed ranges reaches, spans carried
## symbolically through every level.
word part-two(almanac: Almanac) -> Int
    let spans: List<Span> = []
    var index = 0
    while index + 1 < list.length(almanac.seeds)
        list.append(spans, Span(almanac.seeds[index], almanac.seeds[index] + almanac.seeds[index + 1] - 1))
        index = index + 2
    var current = spans
    for ranges in almanac.levels
        current = _map-spans(current, ranges)
    let opening = current[0]
    var lowest = opening.first
    for span in current
        if span.first < lowest
            lowest = span.first
    lowest

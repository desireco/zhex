# Advent of Code 2023, day 18 — Lavaduct Lagoon.
# Reads the dig plan from stdin until end of input, prints both answers.
use day18-core

# shortcut: a plan line holds a letter, a number, and a parenthesized
# hex color, so this sentinel cannot collide; it stands in for the
# end-of-file failure because error.detail is not compiled to wasm yet
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        buffer.add-line(input, line)
let plan = day18-core.parse(buffer.to-text(input)) try
print(day18-core.part-one(plan))
print(day18-core.part-two(plan))

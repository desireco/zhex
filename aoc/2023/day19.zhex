# Advent of Code 2023, day 19 — Aplenty (solution words). Parts walk
# the workflows from "in" until an A or R; part 1 sums the ratings of
# the parts that land on A. Part 2 asks how many of the 4000^4 rating
# combinations would be accepted, answered by carrying whole rating
# ranges through the workflows: each conditional rule splits its
# category's range into the piece that passes (sent to the rule's
# target) and the piece that fails (carried to the next rule), and an
# accepted fragment counts its volume, the product of its four span
# sizes. The recursion is the workflow chain, a handful of hops deep.

## One rule: a category index 0-3 (x, m, a, s), an operation 0 (<),
## 1 (>), or 2 (bare target), the comparison value, and where a match
## goes.
type Rule = record
    cat: Int
    op: Int
    val: Int
    target: String

## The sorter: workflows by name, and the parts to run.
type Sorter = record
    workflows: Map<String, List<Rule>>
    parts: List<List<Int>>

## Parse the workflow lines, the blank separator, and the part lines.
word parse(text: String) -> Sorter
    let workflows: Map<String, List<Rule>> = {}
    let parts: List<List<Int>> = []
    var in-parts = false
    for line in text.split(text, "\n")
        if text.length(line) > 0
            if in-parts
                let ratings: List<Int> = []
                for field in text.split(text.slice(line, 1, text.length(line) - 1), ",")
                    list.append(ratings, text.to-int(text.slice(field, 2, text.length(field))) try)
                list.append(parts, ratings)
            else
                let name = text.slice(line, 0, text.index-of(line, "{"))
                let rules: List<Rule> = []
                for piece in text.split(text.slice(line, text.index-of(line, "{") + 1, text.length(line) - 1), ",")
                    if text.contains(piece, ":")
                        let sides = text.split(piece, ":")
                        let cond = sides[0]
                        list.append(rules, Rule(text.index-of("xmas", text.slice(cond, 0, 1)), _op-of(cond), text.to-int(text.slice(cond, 2, text.length(cond))) try, sides[1]))
                    else
                        list.append(rules, Rule(0, 2, 0, piece))
                workflows[name] = rules
        else
            in-parts = true
    Sorter(workflows, parts)

# A condition's operation: 0 for <, 1 for >.
word _op-of(cond: String) -> Int
    if text.contains(cond, "<")
        0
    else
        1

# Where one part goes next: the first matching rule's target.
word _first-target(rules: List<Rule>, part: List<Int>) -> String
    var target = "R"
    var found = false
    var at = 0
    while not found and at < list.length(rules)
        let rule = rules[at]
        if rule.op == 2 or (rule.op == 0 and part[rule.cat] < rule.val) or (rule.op == 1 and part[rule.cat] > rule.val)
            target = rule.target
            found = true
        at = at + 1
    target

## The sum of all four ratings over the accepted parts.
word part-one(sorter: Sorter) -> Int
    var total = 0
    for part in sorter.parts
        var current = "in"
        while current != "A" and current != "R"
            match sorter.workflows[current]
                case Option.Some(rules)
                    current = _first-target(rules, part)
                case Option.None
                    current = "R"
        if current == "A"
            for rating in part
                total = total + rating
    total

# A copy of the ranges with one slot replaced.
word _with(ranges: List<Int>, at: Int, value: Int) -> List<Int>
    let copy: List<Int> = []
    for index in range(0, list.length(ranges))
        if index == at
            list.append(copy, value)
        else
            list.append(copy, ranges[index])
    copy

# An accepted fragment's volume: the product of its four span sizes.
word _volume(ranges: List<Int>) -> Int
    var product = 1
    for cat in range(0, 4)
        product = product * (ranges[cat * 2 + 1] - ranges[cat * 2] + 1)
    product

# Split one rule's category: pass the matching span to the target,
# carry the rest past the rule, and stop when nothing remains.
word _walk-rules(workflows: Map<String, List<Rule>>, rules: List<Rule>, at: Int, ranges: List<Int>) -> Int
    if at >= list.length(rules)
        0
    else
        let rule = rules[at]
        if rule.op == 2
            _count(workflows, rule.target, ranges)
        else
            var passing = ranges
            var failing = ranges
            if rule.op == 0
                passing = _with(ranges, rule.cat * 2 + 1, rule.val - 1)
                failing = _with(ranges, rule.cat * 2, rule.val)
            else
                passing = _with(ranges, rule.cat * 2, rule.val + 1)
                failing = _with(ranges, rule.cat * 2 + 1, rule.val)
            if passing[rule.cat * 2] > passing[rule.cat * 2 + 1]
                _walk-rules(workflows, rules, at + 1, failing)
            elif failing[rule.cat * 2] > failing[rule.cat * 2 + 1]
                _count(workflows, rule.target, passing)
            else
                _count(workflows, rule.target, passing) + _walk-rules(workflows, rules, at + 1, failing)

# How many rating combinations in one fragment the workflows accept.
word _count(workflows: Map<String, List<Rule>>, current: String, ranges: List<Int>) -> Int
    if current == "A"
        _volume(ranges)
    elif current == "R"
        0
    else
        match workflows[current]
            case Option.Some(rules)
                _walk-rules(workflows, rules, 0, ranges)
            case Option.None
                0

## How many of the 4000^4 rating combinations are accepted.
word part-two(sorter: Sorter) -> Int
    _count(sorter.workflows, "in", [1, 4000, 1, 4000, 1, 4000, 1, 4000])

# Advent of Code 2023, day 19 — Aplenty.
# Reads workflows and parts from stdin until end of input, prints both
# answers.

word main()
    # The input separates workflows from parts with a blank line, so the
    # runner branches on the end-of-file detail (error.detail). That word is
    # fenced in the browser build (#135), and the sentinel workaround cannot
    # detect end-of-file either. The door carries the fence note until the
    # engine lane fixes #135.
    let input = buffer.new()
    var done = false
    while not done
        let line = read-line("") catch problem
            if error.detail(problem, "reason") == "end-of-file"
                done = true
                ""
            else
                error.message(problem)
        if not done
            buffer.add-line(input, line)
    let sorter = parse(buffer.to-text(input)) try
    print(part-one(sorter))
    print(part-two(sorter))

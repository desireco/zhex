# Advent of Code 2023, day 9 — Mirage Maintenance (solution words). Each
# history becomes its sequence of neighboring differences, then that
# sequence's differences, down to all zeroes; the extrapolations work back
# up that ladder. The next value (part 1) adds each level's last number on
# the way down; the previous value (part 2) subtracts each level's first
# number instead. Both are one while per history — no recursion, so the
# call-depth limit never matters.

## Parse every history into its numbers.
word parse(text: String) -> List<List<Int>>
    let histories: List<List<Int>> = []
    for line in text.split(text, "\n")
        if text.length(line) > 0
            let history: List<Int> = []
            for token in text.split(line, " ")
                if text.length(token) > 0
                    list.append(history, text.to-int(token) try)
            list.append(histories, history)
    histories

word _nonzero(value: Int) -> Bool
    value != 0

# One rung down the ladder: the differences of neighboring values.
word _differences(values: List<Int>) -> List<Int>
    let next: List<Int> = []
    for index in range(0, list.length(values) - 1)
        list.append(next, values[index + 1] - values[index])
    next

## The sum over all histories of the next value: every level's last number
## on the way down adds in.
word part-one(histories: List<List<Int>>) -> Int
    var total = 0
    for history in histories
        var level = history
        var next = 0
        while list.any(level, _nonzero(_))
            next = next + level[list.length(level) - 1]
            level = _differences(level)
        total = total + next
    total

## The sum over all histories of the previous value: each level's first
## number pushed on the way down, then folded popping back up as first
## minus the value below it.
word part-two(histories: List<List<Int>>) -> Int
    var total = 0
    for history in histories
        let firsts: Stack<Int> = stack.new()
        var level = history
        while list.any(level, _nonzero(_))
            stack.push(firsts, level[0])
            level = _differences(level)
        var previous = 0
        while stack.length(firsts) > 0
            previous = stack.pop(firsts) - previous
        total = total + previous
    total

# Advent of Code 2023, day 9 — Mirage Maintenance.
# Reads the histories from stdin until end of input, prints both answers.

word main()
    # shortcut: a history line holds signed numbers and spaces, so this
    # sentinel cannot collide; it stands in for the end-of-file failure because
    # error.detail is not compiled to wasm yet
    let input = buffer.new()
    var done = false
    while not done
        let line = read-line("") catch "~end-of-input~"
        if line == "~end-of-input~"
            done = true
        else
            buffer.add-line(input, line)
    let histories = parse(buffer.to-text(input)) try
    print(part-one(histories))
    print(part-two(histories))

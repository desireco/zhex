use day08
use test

let sample = "RL\n\nAAA = (BBB, CCC)\nBBB = (DDD, EEE)\nCCC = (ZZZ, GGG)\nDDD = (DDD, DDD)\nEEE = (EEE, EEE)\nGGG = (GGG, GGG)\nZZZ = (ZZZ, ZZZ)"
let network = day08.parse(sample)

test.check(day08.part-one(network) == 2, "day 8 part 1, first example")
test.check(day08.part-two(network) == 2, "day 8 part 2, first example")

let second = "LLR\n\nAAA = (BBB, BBB)\nBBB = (AAA, ZZZ)\nZZZ = (ZZZ, ZZZ)"
let second-network = day08.parse(second)
test.check(day08.part-one(second-network) == 6, "day 8 part 1, second example")
test.check(day08.part-two(second-network) == 6, "day 8 part 2, second example")

let ghosts = "LR\n\n11A = (11B, XXX)\n11B = (XXX, 11Z)\n11Z = (11B, XXX)\n22A = (22B, XXX)\n22B = (22C, 22C)\n22C = (22Z, 22Z)\n22Z = (22B, 22B)\nXXX = (XXX, XXX)"
let ghost-network = day08.parse(ghosts)
test.check(day08.part-two(ghost-network) == 6, "day 8 part 2, ghost example")
print "day 8 tests passed"

test.check(day08.guard(day08.parse("")) == "no network in input", "empty input reports no network")
test.check(day08.guard(day08.parse("RL")) == "no network in input", "instructions-only input reports no network")
test.check(day08.guard(day08.parse("RL\n\nBBB = (CCC, DDD)")) == "node AAA is missing from the network", "missing AAA reported")
test.check(day08.guard(day08.parse("RL\n\nAAA = (BBB, CCC)")) == "node AAA names missing neighbor BBB", "dangling neighbor reported")
test.check(day08.guard(network) == "", "sample network passes the guard")
print "day 8 guard tests passed"

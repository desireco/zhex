# Advent of Code 2023, day 3 — Gear Ratios.
# Reads the engine schematic from stdin until end of input, prints both
# answers.
use day03-core

# shortcut: a schematic row holds digits, periods, and symbols, so this
# sentinel cannot collide; it stands in for the end-of-file failure because
# error.detail is not compiled to wasm yet
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        buffer.add-line(input, line)
let schematic = day03-core.parse(buffer.to-text(input))
print(day03-core.part-one(schematic))
print(day03-core.part-two(schematic))

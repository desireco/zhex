# Advent of Code 2023, day 8 — Haunted Wasteland (solution words). One
# line of left/right instructions walks a network of three-letter nodes,
# each naming its left and right neighbors; the instructions start over
# whenever they run out. Part 1 counts the steps from AAA to ZZZ. Part 2
# starts at every node ending in A at once and needs all walkers on nodes
# ending in Z together — each walker cycles after its first Z, so the
# answer is the least common multiple of the cycle lengths (Euclid's gcd,
# hand-rolled: the language has no gcd or lcm word yet).

## One junction: where its left and right sides lead.
type Junction = record
    left: String
    right: String

## The network: the instructions and the junctions by name.
type Network = record
    directions: String
    nodes: Map<String, Junction>

## Parse the instruction line and every "NAME = (LEFT, RIGHT)" junction.
word parse(text: String) -> Network
    var directions = ""
    let nodes: Map<String, Junction> = {}
    for line in text.split(text, "\n")
        if text.length(line) > 0
            if text.length(directions) == 0
                directions = line
            elif text.contains(line, "=")
                let placed = map.put(nodes, text.slice(line, 0, 3), Junction(text.slice(line, 7, 10), text.slice(line, 12, 15)))
    Network(directions, nodes)

# Where one step from a name leads: its left or right neighbor.
word _neighbor(nodes: Map<String, Junction>, name: String, letter: String) -> String
    var result = name
    match nodes[name]
        case Option.Some(junction)
            if letter == "L"
                result = junction.left
            else
                result = junction.right
        case Option.None
            result = name
    result

## The steps the single walk from AAA needs to reach ZZZ.
word part-one(network: Network) -> Int
    var current = "AAA"
    var steps = 0
    var turn = 0
    while current != "ZZZ"
        current = _neighbor(network.nodes, current, text.slice(network.directions, turn, turn + 1))
        steps = steps + 1
        turn = turn + 1
        if turn == text.length(network.directions)
            turn = 0
    steps

# The steps one walker needs to reach its first node ending in Z.
word _ghost-length(network: Network, start: String) -> Int
    var current = start
    var steps = 0
    var turn = 0
    while not text.ends-with(current, "Z")
        current = _neighbor(network.nodes, current, text.slice(network.directions, turn, turn + 1))
        steps = steps + 1
        turn = turn + 1
        if turn == text.length(network.directions)
            turn = 0
    steps

# Euclid's algorithm; the language ships no gcd word.
word _gcd(a: Int, b: Int) -> Int
    var x = a
    var y = b
    while y > 0
        let older = y
        y = x % y
        x = older
    x

word _lcm(a: Int, b: Int) -> Int
    a / _gcd(a, b) * b

## The step count at which every A-starting walker sits on a Z node: the
## least common multiple of the walkers' cycle lengths.
word part-two(network: Network) -> Int
    var answer = 1
    for name, junction in network.nodes
        if text.ends-with(name, "A")
            answer = _lcm(answer, _ghost-length(network, name))
    answer

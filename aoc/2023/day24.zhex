# Advent of Code 2023, day 24 — Never Tell Me The Odds (solution words).
# The language has no floats, so both parts stay exact in 64-bit
# integers. Part 1 intersects each pair's xy paths as rationals kept in
# numerator/denominator form: future-ness is a sign check, and the test
# area compares the integer part directly and cross-multiplies only the
# bounded remainder, so no product ever leaves the 64-bit range. Part 2
# searches the rock's small velocity: the first two hailstones' xy lines
# pin the rock's x and y exactly, every further hailstone must cross
# that point (one product escaping 64 bits goes through _big-zero's
# 32-bit limbs), and the z velocity then falls out of the collision
# times.

## One hailstone: where it is now and where it is heading.
type Stone = record
    px: Int
    py: Int
    pz: Int
    vx: Int
    vy: Int
    vz: Int

## Parse the hailstone list.
word parse(text: String) -> List<Stone>
    let stones: List<Stone> = []
    for line in text.split(text, "\n")
        if text.length(line) > 0
            let numbers: List<Int> = []
            for token in text.split(text.replace(line, "@", ","), ",")
                list.append(numbers, text.to-int(text.trim(token)) try)
            let added = list.append(stones, Stone(numbers[0], numbers[1], numbers[2], numbers[3], numbers[4], numbers[5]))
    stones

# Whether p + v * (tn / td) lands in [lo, hi], with td positive, in exact
# arithmetic: a huge quotient puts the crossing far outside, the integer
# part compares directly, and only the bounded remainder cross-multiplies.
# shortcut: exact for the puzzle's ranges (positions to ~4e14, speeds to
# ~1000); a speed past ~9000 would overflow the integer part
word _axis-in(p: Int, v: Int, tn: Int, td: Int, lo: Int, hi: Int) -> Bool
    if v == 0
        p >= lo and p <= hi
    else
        let q = tn / td
        if q > 1000000000000000
            false
        else
            let base = p + v * q
            let f = v * (tn % td)
            let av = if v < 0
                -v
            else
                v
            let below = base - lo <= -av or (base - lo < av and (base - lo) * td + f < 0)
            let above = base - hi >= av or (base - hi > -av and (base - hi) * td + f > 0)
            not below and not above

# Whether two hailstones' xy paths cross at a future moment inside the
# test area; parallel paths never cross.
word _crosses(a: Stone, b: Stone, lo: Int, hi: Int) -> Bool
    let dx = b.px - a.px
    let dy = b.py - a.py
    let den = a.vx * b.vy - a.vy * b.vx
    if den == 0
        false
    else
        var td = den
        var tn = dx * b.vy - dy * b.vx
        var sn = dx * a.vy - dy * a.vx
        if td < 0
            td = -td
            tn = -tn
            sn = -sn
        if tn <= 0 or sn <= 0
            false
        else
            _axis-in(a.px, a.vx, tn, td, lo, hi) and _axis-in(a.py, a.vy, tn, td, lo, hi)

## How many pairs of hailstones cross inside the test area in the future.
word part-one(stones: List<Stone>, lo: Int = 200000000000000, hi: Int = 400000000000000) -> Int
    var count = 0
    var i = 0
    while i < list.length(stones)
        var j = i + 1
        while j < list.length(stones)
            if _crosses(stones[i], stones[j], lo, hi)
                count = count + 1
            j = j + 1
        i = i + 1
    count

# Whether a * b + c is zero for products past 64 bits, on 32-bit limbs:
# |a| below 2^63, |b| below 2^24, |c| below 2^45.
word _big-zero(a: Int, b: Int, c: Int) -> Bool
    if a == 0
        c == 0
    else
        let neg = a < 0
        var mag = if neg
            -a
        else
            a
        let lo = mag % 4294967296
        let hi = mag / 4294967296
        let p-lo = lo * b
        let p-hi = hi * b
        if p-hi >= 16384
            false
        else
            let m = p-hi * 4294967296 + p-lo
            if neg
                c == m
            else
                c == -m

# Whether every hailstone from the third on crosses the xy point the
# first two pin with this velocity: (X - Pi) x di = 0, the long product
# through _big-zero.
word _hits-all(stones: List<Stone>, cx: Int, cy: Int, q: Int, r: Int, d: Int) -> Bool
    let s0 = stones[0]
    let a0 = s0.vx - cx
    let b0 = s0.vy - cy
    var ok = true
    var i = 2
    while ok and i < list.length(stones)
        let si = stones[i]
        let ai = si.vx - cx
        let bi = si.vy - cy
        let mx = s0.px - si.px + a0 * q
        let my = s0.py - si.py + b0 * q
        let l1 = mx * bi - my * ai
        let l2 = a0 * r * bi - b0 * r * ai
        if not _big-zero(l1, d, l2)
            ok = false
        i = i + 1
    ok

## The rock the search found: its x, y velocity, its x, y start, and
## whether the search held one at all.
type Rock = record
    vx: Int
    vy: Int
    x: Int
    y: Int
    found: Bool

# The rock's x, y velocity and start, found by searching the small
# velocity space: hailstones 0 and 1's xy lines must meet on every other
# hailstone's line at an integer point, in the future.
# shortcut: the collision time and coordinates are bounded (5e11 and
# ~2e15), the puzzle's ranges; a pathological input could exceed them
word _rock-xy(stones: List<Stone>, vmax: Int) -> Rock
    let s0 = stones[0]
    let s1 = stones[1]
    var cx = 0 - vmax
    var rvx = 0
    var rvy = 0
    var rx = 0
    var ry = 0
    var found = false
    while not found and cx <= vmax
        var cy = 0 - vmax
        while not found and cy <= vmax
            let a0 = s0.vx - cx
            let b0 = s0.vy - cy
            let a1 = s1.vx - cx
            let b1 = s1.vy - cy
            let den = a0 * b1 - b0 * a1
            if den != 0
                var num = (s1.px - s0.px) * b1 - (s1.py - s0.py) * a1
                var d = den
                if d < 0
                    d = -d
                    num = -num
                if num > 0 and num <= 500000000000 * d
                    let q = num / d
                    let r = num % d
                    if _hits-all(stones, cx, cy, q, r, d)
                        if (a0 * r) % d == 0 and (b0 * r) % d == 0
                            found = true
                            rvx = cx
                            rvy = cy
                            rx = s0.px + a0 * q + (a0 * r) / d
                            ry = s0.py + b0 * q + (b0 * r) / d
            cy = cy + 1
        cx = cx + 1
    Rock(rvx, rvy, rx, ry, found)

# The rock's z at a candidate z velocity: hailstone 0's collision time
# fixes it, hailstone 1 must land the same z.
word _rock-z-at(stones: List<Stone>, rock: Rock, cz: Int) -> Option<Int>
    let s0 = stones[0]
    let s1 = stones[1]
    var n0 = rock.x - s0.px
    var d0 = s0.vx - rock.vx
    if d0 == 0
        n0 = rock.y - s0.py
        d0 = s0.vy - rock.vy
    let n1 = rock.x - s1.px
    let d1 = s1.vx - rock.vx
    if d0 == 0 or d1 == 0
        Option.None
    elif (n0 < 0) != (d0 < 0) and n0 != 0
        Option.None
    elif (n1 < 0) != (d1 < 0) and n1 != 0
        Option.None
    else
        let num = n0 * (s0.vz - cz)
        let num1 = n1 * (s1.vz - cz)
        if num % d0 != 0 or num1 % d1 != 0
            Option.None
        else
            let pz = s0.pz + num / d0
            if s1.pz + num1 / d1 == pz
                Option.Some(pz)
            else
                Option.None

## The sum of the rock's starting coordinates. The marker 0 - 1 answers
## an input no search bound held; every real puzzle input finds its rock.
word part-two(stones: List<Stone>, vmax: Int = 1000) -> Int
    let rock = _rock-xy(stones, vmax)
    if not rock.found
        0 - 1
    else
        var cz = 0 - vmax
        var answer = 0
        var done = false
        while not done and cz <= vmax
            let spot = _rock-z-at(stones, rock, cz)
            match spot
                case Option.Some(pz)
                    done = true
                    answer = rock.x + rock.y + pz
                case Option.None
                    cz = cz + 1
        if done
            answer
        else
            0 - 1

# Advent of Code 2023, day 24 — Never Tell Me The Odds.
# Reads hailstones from stdin until end of input, prints both answers.

word main()
    # shortcut: a hailstone line holds digits, commas, an @, and spacing, so
    # this sentinel cannot collide; it stands in for the end-of-file failure
    # because error.detail is not compiled to wasm yet (#135)
    let input = buffer.new()
    var done = false
    while not done
        let line = read-line("") catch "~end-of-input~"
        if line == "~end-of-input~"
            done = true
        else
            let added = buffer.add-line(input, line)
    let stones = parse(buffer.to-text(input)) try
    # the puzzle checks its five-stone example inside 7..27 with a slow rock
    # and the real list inside 2e14..4e14; the door runs the example
    let example = list.length(stones) < 10
    let lo = if example
        7
    else
        200000000000000
    let hi = if example
        27
    else
        400000000000000
    let vmax = if example
        10
    else
        1000
    print(part-one(stones, lo, hi))
    print(part-two(stones, vmax))

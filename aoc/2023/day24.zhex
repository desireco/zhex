# Advent of Code 2023, day 24 — Never Tell Me The Odds.
# Reads hailstones from stdin until end of input, prints both answers.
use day24-core

# shortcut: a hailstone line holds digits, commas, an @, and spacing, so
# this sentinel cannot collide; it stands in for the end-of-file failure
# because error.detail is not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        let added = buffer.add-line(input, line)
let stones = day24-core.parse(buffer.to-text(input)) try
# the puzzle checks its five-stone example inside 7..27 with a slow rock
# and the real list inside 2e14..4e14; the door runs the example
let example = list.length(stones) < 10
let lo = if example
    7
else
    200000000000000
let hi = if example
    27
else
    400000000000000
let vmax = if example
    10
else
    1000
print(day24-core.part-one(stones, lo, hi))
print(day24-core.part-two(stones, vmax))

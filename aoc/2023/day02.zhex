# Advent of Code 2023, day 2 — Cube Conundrum.
# Reads the game list from stdin until end of input, prints both answers.
use day02-core

# shortcut: a game line holds letters, digits, and separators only, so this
# sentinel cannot collide; it stands in for the end-of-file failure because
# error.detail is not compiled to wasm yet
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        let added = buffer.add-line(input, line)
let games = day02-core.parse(buffer.to-text(input)) try
print(day02-core.part-one(games))
print(day02-core.part-two(games))

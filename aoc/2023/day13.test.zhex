use day13-core
use test

let sample = "#.##..##.\n..#.##.#.\n##......#\n##......#\n..#.##.#.\n..##..##.\n#.#.##.#.\n\n#...##..#\n#....#..#\n..##..###\n#####.##.\n#####.##.\n..##..###\n#....#..#"
let patterns = day13-core.parse(sample)

test.check(day13-core.part-one(patterns) == 405, "day 13 part 1")
test.check(day13-core.part-two(patterns) == 400, "day 13 part 2")
print "day 13 tests passed"

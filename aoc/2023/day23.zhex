# Advent of Code 2023, day 23 — A Long Walk.
# Reads the trail map from stdin until end of input, prints both answers.
use day23-core

# shortcut: a trail row holds path, forest, and slope arrows, so this
# sentinel cannot collide; it stands in for the end-of-file failure
# because error.detail is not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        let added = buffer.add-line(input, line)
let grid = day23-core.parse(buffer.to-text(input))
print(day23-core.part-one(grid))
print(day23-core.part-two(grid))

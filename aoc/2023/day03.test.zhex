use day03
use test

let sample = "467..114..\n...*......\n..35..633.\n......#...\n617*......\n.....+.58.\n..592.....\n......755.\n...$.*....\n.664.598.."
let schematic = day03.parse(sample)

test.check(day03.part-one(schematic) == 4361, "day 3 part 1")
test.check(day03.part-two(schematic) == 467835, "day 3 part 2")
print "day 3 tests passed"

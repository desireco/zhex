# Advent of Code 2023, day 25 — Snowverload (solution words). The three
# wires to unplug are a minimum cut of size three, found by max flow:
# push up to four edge-disjoint paths from the first component to each
# other one; the first terminal that stops at three flows sits across
# the cut, and the wires left dry by the blocked search split the
# components into the two groups. Wires are undirected, so each
# direction carries capacity one and opposite flows cancel.

## The wiring diagram: components by number, each one's incident wire
## numbers, and each wire's far end (wire k pairs with k + 1 when k is
## even, k - 1 when odd).
type Wiring = record
    count: Int
    adj: List<List<Int>>
    far: List<Int>

# A component's number, or -1 while the diagram has not named it.
word _id-of(ids: Map<String, Int>, name: String) -> Int
    match ids[name]
        case Option.Some(id)
            id
        case Option.None
            0 - 1

# A component's number, naming it on first sight.
word _name(ids: Map<String, Int>, name: String, count: Int) -> Int
    let known = _id-of(ids, name)
    if known >= 0
        known
    else
        let stored = map.put(ids, name, count)
        count

## Parse the wiring diagram; every wire appears exactly once.
word parse(text: String) -> Wiring
    let ids: Map<String, Int> = {}
    var count = 0
    let adj: List<List<Int>> = []
    let far: List<Int> = []
    for line in text.split(text, "\n")
        if text.length(line) > 0
            let parts = text.split(line, ": ")
            let from = _name(ids, parts[0], count)
            if from == count
                count = count + 1
                let added = list.append(adj, [])
            for name in text.split(text.trim(parts[1]), " ")
                let to = _name(ids, name, count)
                if to == count
                    count = count + 1
                    let added = list.append(adj, [])
                list.append(adj[from], list.length(far))
                list.append(far, to)
                list.append(adj[to], list.length(far))
                list.append(far, from)
    Wiring(count, adj, far)

# A wire's residual partner.
word _pair(wire: Int) -> Int
    if wire % 2 == 0
        wire + 1
    else
        wire - 1

# Whether a breadth-first search over wires with capacity left reaches
# `to` from `from`, recording each component's arriving wire in `came`
# (-1 unvisited, -2 the start).
word _reaches(w: Wiring, caps: List<Int>, from: Int, to: Int, came: List<Int>) -> Bool
    var i = 0
    while i < w.count
        came[i] = 0 - 1
        i = i + 1
    came[from] = 0 - 2
    let queue: List<Int> = [from]
    var head = 0
    var found = from == to
    while not found and head < list.length(queue)
        let node = queue[head]
        head = head + 1
        let wires = w.adj[node]
        var wi = 0
        while not found and wi < list.length(wires)
            let wire = wires[wi]
            let next = w.far[wire]
            if caps[wire] > 0 and came[next] == 0 - 1
                came[next] = wire
                if next == to
                    found = true
                else
                    let added = list.append(queue, next)
            wi = wi + 1
    found

# How many wires (to a limit of four) carry `from` to `to` at once,
# flipping capacities along each path found.
word _flow(w: Wiring, caps: List<Int>, from: Int, to: Int) -> Int
    let came: List<Int> = []
    var i = 0
    while i < w.count
        list.append(came, 0)
        i = i + 1
    var carried = 0
    var more = true
    while more and carried < 4
        if _reaches(w, caps, from, to, came)
            carried = carried + 1
            var node = to
            while node != from
                let wire = came[node]
                caps[wire] = caps[wire] - 1
                let back = _pair(wire)
                caps[back] = caps[back] + 1
                node = w.far[back]
        else
            more = false
    carried

## The product of the two groups three unplugged wires leave: the first
## component whose four-path flow stops at three, with the groups read
## off the wires the blocked search left dry.
word part-one(w: Wiring) -> Int
    var t = 1
    var answer = 0
    while t < w.count and answer == 0
        let caps: List<Int> = []
        var i = 0
        while i < list.length(w.far)
            list.append(caps, 1)
            i = i + 1
        if _flow(w, caps, 0, t) == 3
            let came: List<Int> = []
            var j = 0
            while j < w.count
                list.append(came, 0)
                j = j + 1
            # to = count cannot be reached, so the search just marks the
            # dry side
            let reached = _reaches(w, caps, 0, w.count, came)
            var side = 1
            var k = 1
            while k < w.count
                if came[k] >= 0
                    side = side + 1
                k = k + 1
            answer = side * (w.count - side)
        t = t + 1
    answer

# Advent of Code 2023, day 25 — Snowverload.
# Reads the wiring diagram from stdin until end of input, prints the answer.

word main()
    # shortcut: a wiring line holds names, a colon, and spaces, so this
    # sentinel cannot collide; it stands in for the end-of-file failure
    # because error.detail is not compiled to wasm yet (#135)
    let input = buffer.new()
    var done = false
    while not done
        let line = read-line("") catch "~end-of-input~"
        if line == "~end-of-input~"
            done = true
        else
            let added = buffer.add-line(input, line)
    let wiring = parse(buffer.to-text(input))
    print(part-one(wiring))
    # the finale has one part; the second star comes with the first
    print("*")

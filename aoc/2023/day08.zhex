# Advent of Code 2023, day 8 — Haunted Wasteland.
# Reads the network from stdin until end of input, prints both answers.
use day08-core

# The network separates its instructions from its junctions with a blank
# line, so the runner branches on the end-of-file detail (error.detail).
# That word is fenced in the browser build (#135), and the sentinel
# workaround days 1-4 and 6-7 use cannot cover this day either: the
# browser read-line traps on an empty line before any catch could run
# (#155). The door carries the fence note until the engine lane fixes
# either gap.
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch problem
        if error.detail(problem, "reason") == "end-of-file"
            done = true
            ""
        else
            error.message(problem)
    if not done
        buffer.add-line(input, line)
let network = day08-core.parse(buffer.to-text(input))
print(day08-core.part-one(network))
print(day08-core.part-two(network))

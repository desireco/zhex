# Advent of Code 2023, day 14 — Parabolic Reflector Dish.
# Reads the platform from stdin until end of input, prints both answers.
use day14-core

# shortcut: the platform holds dots, hashes, and capital O rocks only, so
# this sentinel cannot collide; it stands in for the end-of-file failure
# because error.detail is not compiled to wasm yet
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        let added = buffer.add-line(input, line)
let dish = day14-core.parse(buffer.to-text(input))
print(day14-core.part-one(dish))
print(day14-core.part-two(dish))

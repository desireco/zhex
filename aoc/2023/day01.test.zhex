use day01-core
use test

let sample = "1abc2\npqr3stu8vwx\na1b2c3d4e5f\ntreb7uchet"
let spelled-sample = "two1nine\neightwothree\nabcone2threexyz\nxtwone3four\n4nineeightseven2\nzoneight234\n7pqrstsixteen"
let lines = day01-core.parse(sample)
let spelled-lines = day01-core.parse(spelled-sample)

test.check(day01-core.part-one(lines) == 142, "day 1 part 1")
test.check(day01-core.part-two(spelled-lines) == 281, "day 1 part 2")
print "day 1 tests passed"

# Advent of Code 2023, day 21 — Step Counter.
# Reads the garden map from stdin until end of input, prints both answers.
use day21-core

# shortcut: a garden row holds plots, rocks, and the S marker, so this
# sentinel cannot collide; it stands in for the end-of-file failure
# because error.detail is not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        buffer.add-line(input, line)
let grid = day21-core.parse(buffer.to-text(input))
# the puzzle walks its 11-row example 6 and 100 steps and a real garden
# 64 and 26501365; the door runs the example
let example = list.length(grid) < 64
let steps = if example
    6
else
    64
let total = if example
    100
else
    26501365
print(day21-core.part-one(grid, steps))
print(day21-core.part-two(grid, total))

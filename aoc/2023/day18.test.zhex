use day18-core
use test

let plan-text = "R 6 (#70c710)\nD 5 (#0dc571)\nL 2 (#5713f0)\nD 2 (#d2c081)\nR 2 (#59c680)\nD 2 (#411b91)\nL 5 (#8ceee2)\nU 2 (#caa173)\nL 1 (#1b58a2)\nU 2 (#caa171)\nR 2 (#7807d2)\nU 3 (#a77fa3)\nL 2 (#015232)\nU 2 (#7a21e3)"
let plan = day18-core.parse(plan-text) try
test.check(day18-core.part-one(plan) == 62, "day 18 part 1, lagoon from the listed steps")
test.check(day18-core.part-two(plan) == 952408144115, "day 18 part 2, lagoon from the hex colors")
print "day 18 tests passed"

# Advent of Code 2023, day 4 — Scratchcards.
# Reads the card pile from stdin until end of input, prints both answers.
use day04-core

# shortcut: a card line holds "Card N", numbers, and the bar, so this
# sentinel cannot collide; it stands in for the end-of-file failure because
# error.detail is not compiled to wasm yet
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        buffer.add-line(input, line)
let matches = day04-core.parse(buffer.to-text(input)) try
print(day04-core.part-one(matches))
print(day04-core.part-two(matches))

# Advent of Code 2023, day 2 — Cube Conundrum (solution words).
# Each game line reveals handfuls of cubes; parse keeps, per game, the
# largest count seen per color. Part 1 sums the IDs of games whose per-color
# maxima fit the bag (12 red, 13 green, 14 blue); part 2 takes each game's
# maxima as the fewest cubes per color that could have been in the bag and
# sums their products.

## One game: its ID and the largest count seen per color.
type Game = record
    id: Int
    red: Int
    green: Int
    blue: Int

word _parse-game(line: String) -> Game
    let colon = text.index-of(line, ":")
    let id = text.to-int(text.slice(line, 5, colon)) try
    var red = 0
    var green = 0
    var blue = 0
    for reveal in text.split(text.slice(line, colon + 1, text.length(line)), ";")
        let clean = text.trim(reveal)
        if text.length(clean) > 0
            for count-color in text.split(clean, ",")
                let parts = text.split(text.trim(count-color), " ")
                let count = text.to-int(text.trim(parts[0])) try
                let color = text.trim(parts[1])
                if color == "red" and count > red
                    red = count
                elif color == "green" and count > green
                    green = count
                elif color == "blue" and count > blue
                    blue = count
    Game(id, red, green, blue)

## Parse the game lines into their per-color maxima.
word parse(text: String) -> List<Game>
    let games: List<Game> = []
    for line in text.split(text, "\n")
        if text.length(line) > 0
            let added = list.append(games, _parse-game(line) try)
    games

## Sum the IDs of the games the bag could have produced.
word part-one(games: List<Game>) -> Int
    var total = 0
    for game in games
        if game.red <= 12 and game.green <= 13 and game.blue <= 14
            total = total + game.id
    total

## Sum the products of each game's fewest cubes per color.
word part-two(games: List<Game>) -> Int
    var total = 0
    for game in games
        total = total + game.red * game.green * game.blue
    total

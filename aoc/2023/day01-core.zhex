# Advent of Code 2023, day 1 — Trebuchet?! (solution words).
# The calibration document hides one value per line: the two-digit number
# from its first and last digit. Part 1 reads only digit characters; part 2
# also reads digits spelled out as one..nine, and a word's last letter may
# start the next one (eightwo reads as 8 then 2), so the scan checks every
# position instead of replacing words in order.

# The digit a one-character string holds, -1 when it holds none.
word _digit(ch: String) -> Int
    text.to-int(ch) catch -1

# The spelled-out digit starting at the line's end slice, -1 for none.
word _word-digit(rest: String) -> Int
    if text.starts-with(rest, "one")
        1
    elif text.starts-with(rest, "two")
        2
    elif text.starts-with(rest, "three")
        3
    elif text.starts-with(rest, "four")
        4
    elif text.starts-with(rest, "five")
        5
    elif text.starts-with(rest, "six")
        6
    elif text.starts-with(rest, "seven")
        7
    elif text.starts-with(rest, "eight")
        8
    elif text.starts-with(rest, "nine")
        9
    else
        -1

# The line's value from its first and last digit, spelled-out words
# counting only when asked.
word _line-value(line: String, spelled: Bool) -> Int
    var first = -1
    var last = -1
    for index in range(0, text.length(line))
        var value = _digit(text.slice(line, index, index + 1))
        if spelled and value < 0
            value = _word-digit(text.slice(line, index, text.length(line)))
        if value >= 0
            if first < 0
                first = value
            last = value
    first * 10 + last

## Parse the calibration document into its nonempty lines.
word parse(text: String) -> List<String>
    let lines: List<String> = []
    for line in text.split(text, "\n")
        if text.length(line) > 0
            list.append(lines, line)
    lines

## Sum the values reading digit characters only.
word part-one(lines: List<String>) -> Int
    var total = 0
    for line in lines
        total = total + _line-value(line, false)
    total

## Sum the values with spelled-out digits counted too.
word part-two(lines: List<String>) -> Int
    var total = 0
    for line in lines
        total = total + _line-value(line, true)
    total

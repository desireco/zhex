use day10-core
use test

let square = ".....\n.S-7.\n.|.|.\n.L-J.\n....."
test.check(day10-core.part-one(day10-core.parse(square)) == 4, "day 10 part 1, square example")
test.check(day10-core.part-two(day10-core.parse(square)) == 1, "day 10 part 2, square example")

let complex = "..F7.\n.FJ|.\nSJ.L7\n|F--J\nLJ..."
test.check(day10-core.part-one(day10-core.parse(complex)) == 8, "day 10 part 1, complex example")
test.check(day10-core.part-two(day10-core.parse(complex)) == 1, "day 10 part 2, complex example")

let nested = "..........\n.S------7.\n.|F----7|.\n.||....||.\n.||....||.\n.|L-7F-J|.\n.|..||..|.\n.L--JL--J.\n.........."
test.check(day10-core.part-one(day10-core.parse(nested)) == 22, "day 10 part 1, nested example")
test.check(day10-core.part-two(day10-core.parse(nested)) == 4, "day 10 part 2, nested example")

let sprawling = "FF7FSF7F7F7F7F7F---7\nL|LJ||||||||||||F--J\nFL-7LJLJ||||||LJL-77\nF--JF--7||LJLJ7F7FJ-\nL---JF-JLJ.||-FJLJJ7\n|F|F-JF---7F7-L7L|7|\n|FFJF7L7F-JF7|JL---7\n7-L-JL7||F7|L7F-7F7|\nL.L7LFJ|||||FJL7||LJ\nL7JLJL-JLJLJL--JLJ.L"
test.check(day10-core.part-one(day10-core.parse(sprawling)) == 80, "day 10 part 1, sprawling example")
test.check(day10-core.part-two(day10-core.parse(sprawling)) == 10, "day 10 part 2, sprawling example")
print "day 10 tests passed"

# A loop whose S (shape J) connects north through a 7: the north branch of
# _connects-back must accept | 7 F, and a junk L above S must be refused.
let corner = "F7\nLS"
test.check(day10-core.part-one(day10-core.parse(corner)) == 2, "day 10 part 1, S connects north through 7")
test.check(day10-core.part-two(day10-core.parse(corner)) == 0, "day 10 part 2, S connects north through 7")
let junk-above = ".L..\n.S-7\n.|.|\n.L-J"
test.check(day10-core.part-one(day10-core.parse(junk-above)) == 4, "day 10 part 1, junk L above S survives")
test.check(day10-core.part-two(day10-core.parse(junk-above)) == 1, "day 10 part 2, junk L above S ignored")

use day22
use test

let snapshot = "1,0,1~1,2,1\n0,0,2~2,0,2\n0,2,3~2,2,3\n0,0,4~0,2,4\n2,0,5~2,2,5\n0,1,6~2,1,6\n1,1,8~1,1,9"
let bricks = day22.parse(snapshot) try
test.check(day22.part-one(bricks) == 5, "day 22 part 1, safely disintegrable bricks")
test.check(day22.part-two(bricks) == 7, "day 22 part 2, summed chain falls")
print "day 22 tests passed"

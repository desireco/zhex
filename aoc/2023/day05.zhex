# Advent of Code 2023, day 5 — If You Give A Seed A Fertilizer.
# Reads the almanac from stdin until end of input, prints both answers.
use day05-core

# The almanac separates its blocks with blank lines, so the runner branches
# on the end-of-file detail (error.detail). That word is fenced in the
# browser build (#135), and the sentinel workaround days 1-4 use cannot
# detect end-of-file either. The door carries the fence note until the
# engine lane fixes #135.
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch problem
        if error.detail(problem, "reason") == "end-of-file"
            done = true
            ""
        else
            error.message(problem)
    if not done
        buffer.add-line(input, line)
let almanac = day05-core.parse(buffer.to-text(input)) try
print(day05-core.part-one(almanac))
print(day05-core.part-two(almanac))

# Advent of Code 2023, day 11 — Cosmic Expansion.
# Reads the image from stdin until end of input, prints both answers.
use day11-core

# shortcut: the image holds dots and hashes only, so this sentinel cannot
# collide; it stands in for the end-of-file failure because error.detail
# is not compiled to wasm yet
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        buffer.add-line(input, line)
let universe = day11-core.parse(buffer.to-text(input))
print(day11-core.part-one(universe))
print(day11-core.part-two(universe))

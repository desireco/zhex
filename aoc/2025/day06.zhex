# Advent of Code 2025, day 6 — Trash Compactor.
# Reads the worksheet from stdin until end of input, prints both answers.
use day06-core

# shortcut: a worksheet row is digits, spaces, +, and *, so this sentinel
# cannot collide; it stands in for the end-of-file failure because
# error.detail is not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        let added = buffer.add-line(input, line)
let worksheet = day06-core.parse(buffer.to-text(input)) try
print(day06-core.part-one(worksheet))
print(day06-core.part-two(worksheet))

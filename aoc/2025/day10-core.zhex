# Advent of Code 2025, day 10 — Factory (solution words).
# Each input line is one machine: a light diagram in brackets (the target
# pattern; machines start dark), button wirings in parentheses naming the
# 0-based lights each press flips, and joltage numbers in braces. Part 1
# finds the fewest presses per machine by breadth-first search over the
# subset of pressed buttons. Part 2 requires every light to be toggled
# exactly its joltage number of times, and minimizes the total presses.

type Machine = record
    target: Int
    lights: Int
    buttons: List<List<Int>>
    joltage: List<Int>

word _pow2(n: Int) -> Int
    var value = 1
    for i in range(0, n)
        value = value * 2
    value

## Parse one machine per line: diagram, buttons, joltage.
word parse(text: String) -> List<Machine>
    let machines: List<Machine> = []
    for line in text.split(text, "\n")
        if text.length(line) > 0
            let tokens = text.split(line, " ")
            let diagram = text.slice(tokens[0], 1, text.length(tokens[0]) - 1)
            var target = 0
            for i in range(0, text.length(diagram))
                if text.slice(diagram, i, i + 1) == "#"
                    target = target + _pow2(i)
            let buttons: List<List<Int>> = []
            for i in range(1, list.length(tokens) - 1)
                let inner = text.slice(tokens[i], 1, text.length(tokens[i]) - 1)
                let lights: List<Int> = []
                for digit in text.split(inner, ",")
                    list.append(lights, text.to-int(digit) try)
                list.append(buttons, lights)
            let joltage: List<Int> = []
            let last = tokens[list.length(tokens) - 1]
            let numbers = text.slice(last, 1, text.length(last) - 1)
            for digit in text.split(numbers, ",")
                list.append(joltage, text.to-int(digit) try)
            list.append(machines, Machine(target, text.length(diagram), buttons, joltage))
    machines

# Flip one light of an encoded state by place value: no bitwise words,
# so the digit comes off with / and % and the place is added or removed.
word _toggle(state: Int, light: Int) -> Int
    let place = _pow2(light)
    if (state / place) % 2 == 0
        state + place
    else
        state - place

# Fewest presses from all-off to the target: breadth-first over encoded
# states, each button pressed at most once (a second press reverts it).
# The queue never pops — a head index walks an append-only list, which
# keeps first-in-first-out order for the shortest press count.
word _fewest-presses(machine: Machine) -> Int
    if machine.target == 0
        0
    else
        let visited: List<Bool> = []
        for i in range(0, _pow2(machine.lights))
            list.append(visited, false)
        let states: List<Int> = []
        let depths: List<Int> = []
        list.append(states, 0)
        list.append(depths, 0)
        visited[0] = true
        var head = 0
        var answer = -1
        while answer < 0 and head < list.length(states)
            let state = states[head]
            let depth = depths[head]
            head = head + 1
            for button in machine.buttons
                var next = state
                for light in button
                    next = _toggle(next, light)
                if next == machine.target
                    answer = depth + 1
                else
                    if not visited[next]
                        visited[next] = true
                        list.append(states, next)
                        list.append(depths, depth + 1)
        answer

## Sum over machines of the fewest presses reaching each target.
word part-one(machines: List<Machine>) -> Int
    var total = 0
    for machine in machines
        total = total + _fewest-presses(machine)
    total

# Fewest presses of the button at `index` that stay possible: one more
# would push its most-used light's joltage negative.
word _max-presses(button: List<Int>, joltage: List<Int>) -> Int
    var bound = joltage[button[0]]
    for light in button
        if joltage[light] < bound
            bound = joltage[light]
    bound

# Minimal total presses assigning counts to buttons from `index` on.
# `joltage` holds the remaining required toggles per light, mutated for
# each trial count and restored on backtrack; an assignment wins only
# when every remainder lands on exactly zero.
word _search(buttons: List<List<Int>>, joltage: List<Int>, index: Int, running: Int, best: Int) -> Int
    if running >= best
        best
    else
        if index == list.length(buttons)
            var zero = true
            for value in joltage
                if value != 0
                    zero = false
            if zero
                running
            else
                best
        else
            let button = buttons[index]
            var result = best
            var count = 0
            while count <= _max-presses(button, joltage) and running + count < result
                for light in button
                    joltage[light] = joltage[light] - count
                let found = _search(buttons, joltage, index + 1, running + count, result)
                if found < result
                    result = found
                for light in button
                    joltage[light] = joltage[light] + count
                count = count + 1
            result

# shortcut: no real input lacks a solution — both references assume one;
# -1 would surface loudly rather than fake a total.
word _fewest-joltage-presses(machine: Machine) -> Int
    let found = _search(machine.buttons, machine.joltage, 0, 0, 1000000000)
    if found == 1000000000
        -1
    else
        found

## Sum over machines of the fewest presses toggling each light exactly
## its joltage number of times.
word part-two(machines: List<Machine>) -> Int
    var total = 0
    for machine in machines
        total = total + _fewest-joltage-presses(machine)
    total

# Advent of Code 2025, day 4 — Printing Department.
# Reads the floor diagram from stdin until end of input, prints both answers.
use day04-core

# shortcut: a diagram row is always @ and . characters, so this sentinel
# cannot collide; it stands in for the end-of-file failure because
# error.detail is not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        let added = buffer.add-line(input, line)
let grid = day04-core.parse(buffer.to-text(input))
print(day04-core.part-one(grid))
print(day04-core.part-two(grid))

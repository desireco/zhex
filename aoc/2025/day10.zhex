# Advent of Code 2025, day 10 — Factory.
# Reads machine lines from stdin until end of input, prints both answers.
use day10-core

# shortcut: a machine line always starts with a bracketed light diagram,
# so this sentinel cannot collide; it stands in for the end-of-file
# failure because error.detail is not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        let added = buffer.add-line(input, line)
let machines = day10-core.parse(buffer.to-text(input)) try
print(day10-core.part-one(machines))
print(day10-core.part-two(machines))

# Advent of Code 2025, day 12 — Christmas Tree Farm.
# Reads the shape grids and region lines from stdin until end of input,
# prints both answers.
use day12-core

# shortcut: an input line is #/. grid rows or "WxH: counts", so this
# sentinel cannot collide; it stands in for the end-of-file failure
# because error.detail is not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        buffer.add-line(input, line)
let farm = day12-core.parse(buffer.to-text(input)) try
print(day12-core.part-one(farm))
print(day12-core.part-two(farm))

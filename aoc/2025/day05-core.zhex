# Advent of Code 2025, day 5 — Cafeteria (solution words).
# The database lists fresh ingredient ID ranges, a blank line, then the
# available ingredient IDs; the ranges are inclusive and may overlap, and
# an ID is fresh when it falls inside any range. Part 1 counts how many of
# the available IDs are fresh; part 2 measures the ranges themselves — the
# total number of distinct IDs they cover, overlaps counted once.

## One inclusive fresh-ID range.
type IdRange = record
    first: Int
    last: Int

## The database: the fresh ranges and the available IDs.
type Database = record
    ranges: List<IdRange>
    ids: List<Int>

## Parse the two sections around the blank line.
word parse(text: String) -> Database
    let ranges: List<IdRange> = []
    let ids: List<Int> = []
    var in-ranges = true
    for line in text.split(text, "\n")
        if in-ranges and text.length(line) == 0
            in-ranges = false
        elif text.length(line) > 0
            if in-ranges
                let dash = text.index-of(line, "-")
                let first = text.to-int(text.slice(line, 0, dash)) try
                let last = text.to-int(text.slice(line, dash + 1, text.length(line))) try
                list.append(ranges, IdRange(first, last))
            else
                list.append(ids, text.to-int(line) try)
    Database(ranges, ids)

word _covers(fresh-range: IdRange, id: Int) -> Bool
    id >= fresh-range.first and id <= fresh-range.last

## Count the available IDs that fall inside any fresh range.
word part-one(database: Database) -> Int
    var fresh = 0
    for id in database.ids
        if list.any(database.ranges, _covers(_, id))
            fresh = fresh + 1
    fresh

word _range-first(fresh-range: IdRange) -> Int
    fresh-range.first

## Measure the union of the fresh ranges: sorted by first ID, a range
## extends the current span while it overlaps and opens a new one after a
## gap, so overlapping IDs count exactly once.
word part-two(database: Database) -> Int
    let sorted = list.sort-by(database.ranges, _range-first(_))
    let opening = sorted[0]
    var total = 0
    var low = opening.first
    var high = opening.last
    for fresh-range in sorted
        if fresh-range.first > high
            total = total + (high - low + 1)
            low = fresh-range.first
            high = fresh-range.last
        elif fresh-range.last > high
            high = fresh-range.last
    total + (high - low + 1)

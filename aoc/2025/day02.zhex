# Advent of Code 2025, day 2 — Gift Shop.
# Reads the price list from stdin until end of input, prints both answers.
use day02-core

# shortcut: a range is always digits around a dash, so this sentinel cannot
# collide; it stands in for the end-of-file failure because error.detail is
# not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        let added = buffer.add-line(input, line)
let ids = day02-core.parse(buffer.to-text(input)) try
print(day02-core.part-one(ids))
print(day02-core.part-two(ids))

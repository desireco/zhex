# Advent of Code 2025, day 11 — Reactor.
# Reads wiring lines from stdin until end of input, prints both answers.
use day11-core

# shortcut: a wiring line always contains a colon, so this sentinel
# cannot collide; it stands in for the end-of-file failure because
# error.detail is not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        let added = buffer.add-line(input, line)
let wiring = day11-core.parse(buffer.to-text(input))
print(day11-core.part-one(wiring))
print(day11-core.part-two(wiring))

# Advent of Code 2025, day 9 — Movie Theater.
# Reads red-tile coordinates from stdin until end of input, prints both answers.
use day09-core

# shortcut: a coordinate line is always digits, a comma, digits, so this
# sentinel cannot collide; it stands in for the end-of-file failure because
# error.detail is not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        buffer.add-line(input, line)
let tiles = day09-core.parse(buffer.to-text(input)) try
print(day09-core.part-one(tiles))
print(day09-core.part-two(tiles))

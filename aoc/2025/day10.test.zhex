use day10-core
use test

let sample = "[.##.] (3) (1,3) (2) (2,3) (0,2) (0,1) {3,5,4,7}\n[...#.] (0,2,3,4) (2,3) (0,4) (0,1,2) (1,2,3,4) {7,5,12,7,2}\n[.###.#] (0,1,2,3,4) (0,3,4) (0,1,2,4,5) (1,2) {10,11,11,5,10,5}"
let machines = day10-core.parse(sample) try

test.check(day10-core.part-one(machines) == 7, "day 10 part 1")
test.check(day10-core.part-two(machines) == 33, "day 10 part 2")
print "day 10 tests passed"

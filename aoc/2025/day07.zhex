# Advent of Code 2025, day 7 — Laboratories.
# Reads the diagram from stdin until end of input, prints both answers.
use day07-core

# shortcut: a diagram row is ., ^, and S characters, so this sentinel
# cannot collide; it stands in for the end-of-file failure because
# error.detail is not compiled to wasm yet (#135)
let input = buffer.new()
var done = false
while not done
    let line = read-line("") catch "~end-of-input~"
    if line == "~end-of-input~"
        done = true
    else
        buffer.add-line(input, line)
let grid = day07-core.parse(buffer.to-text(input))
print(day07-core.part-one(grid))
print(day07-core.part-two(grid))

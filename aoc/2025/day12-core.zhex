# Advent of Code 2025, day 12 — Christmas Tree Farm (solution words).
# The input lists six present shapes as #/. grids, then one line per tree
# region: a width-x-length size and how many of each shape should fit.
# Presents sit on the grid, may rotate and flip, may not overlap or
# stack, and their . holes interlock around other presents. Part 1
# counts the regions that fit everything: cheap filters first (the
# #-cell sum, then a slot count that many presents always satisfy), a
# packing backtracker only when both abstain. Part 2 is the twelve-day
# event's finale — nothing left to compute.

type Form = record
    width: Int
    height: Int
    cells: List<Int>
    pixels: Int

type Region = record
    width: Int
    height: Int
    counts: List<Int>

type Farm = record
    shapes: List<List<Form>>
    regions: List<Region>

# One shape orientation from its grid rows: the # cells as flat offsets
# into the orientation's own width-by-height bounding box.
word _form(rows: List<String>) -> Form
    let width = text.length(rows[0])
    let cells: List<Int> = []
    var pixels = 0
    for r in range(0, list.length(rows))
        for c in range(0, text.length(rows[r]))
            if text.slice(rows[r], c, c + 1) == "#"
                list.append(cells, r * width + c)
                pixels = pixels + 1
    Form(width, list.length(rows), cells, pixels)

# A form's comparable rendering, to drop duplicate orientations.
word _key(form: Form) -> String
    let dims = int.to-string(form.width) + "x" + int.to-string(form.height) + ":"
    dims + text.join(list.map(form.cells, int.to-string(_)), ",")

# Rotate a form a quarter turn right: cell (r, c) lands at (c, h-1-r).
word _rotate-right(form: Form) -> Form
    let cells: List<Int> = []
    for cell in form.cells
        let r = cell / form.width
        let c = cell % form.width
        list.append(cells, c * form.height + form.height - 1 - r)
    Form(form.height, form.width, list.sort(cells), form.pixels)

word _flip-h(form: Form) -> Form
    let cells: List<Int> = []
    for cell in form.cells
        let r = cell / form.width
        let c = cell % form.width
        list.append(cells, r * form.width + form.width - 1 - c)
    Form(form.width, form.height, list.sort(cells), form.pixels)

word _flip-v(form: Form) -> Form
    let cells: List<Int> = []
    for cell in form.cells
        let r = cell / form.width
        let c = cell % form.width
        list.append(cells, (form.height - 1 - r) * form.width + c)
    Form(form.width, form.height, list.sort(cells), form.pixels)

word _add-form(forms: List<Form>, keys: List<String>, form: Form)
    let key = _key(form)
    var seen = false
    for known in keys
        if known == key
            seen = true
    if not seen
        list.append(keys, key)
        let added = list.append(forms, form)

# Every distinct orientation: four rotations, each with its two mirror
# images, duplicates dropped by key.
word _orientations(base: Form) -> List<Form>
    let forms: List<Form> = []
    let keys: List<String> = []
    var current = base
    for turn in range(0, 4)
        _add-form(forms, keys, current)
        _add-form(forms, keys, _flip-h(current))
        _add-form(forms, keys, _flip-v(current))
        current = _rotate-right(current)
    forms

# One "12x5: 1 0 1 0 3 2" region line.
word _region(line: String) -> Region
    let colon = text.index-of(line, ":")
    let size = text.split(text.slice(line, 0, colon), "x")
    let width = text.to-int(size[0]) try
    let height = text.to-int(size[1]) try
    let counts: List<Int> = []
    for count in text.split(text.slice(line, colon + 2, text.length(line)), " ")
        list.append(counts, text.to-int(count) try)
    Region(width, height, counts)

## Parse the shape blocks, the region block last, blank-line separated.
word parse(text: String) -> Farm
    let blocks: List<List<String>> = []
    var block: List<String> = []
    for line in text.split(text, "\n")
        if text.length(line) > 0
            let added = list.append(block, line)
        else
            if list.length(block) > 0
                list.append(blocks, block)
                block = []
    if list.length(block) > 0
        let added = list.append(blocks, block)
    let shapes: List<List<Form>> = []
    for i in range(0, list.length(blocks) - 1)
        let rows: List<String> = []
        for r in range(1, list.length(blocks[i]))
            list.append(rows, blocks[i][r])
        list.append(shapes, _orientations(_form(rows)))
    let regions: List<Region> = []
    for line in blocks[list.length(blocks) - 1]
        list.append(regions, _region(line) try)
    Farm(shapes, regions)

word _pow2(n: Int) -> Int
    var value = 1
    for i in range(0, n)
        value = value * 2
    value

# Fill one anchor column of a region and emit the reachable states. The
# occupancy `occ` holds bits for the cells this column's presents cover
# (bit = column-offset * height + row, no bitwise words, so bits are
# place values tested with / and %); `pend` holds the coverage earlier
# columns already committed into this column's window. Every node emits
# its state shifted past the finished column, then tries one more
# present anchored here. Recursion depth is the presents-per-column
# bound plus one — single digits.
word _fill-column(next: Map<Int, Bool>, occ: Int, pend: Int, code: Int, anchor: Int, width: Int, height: Int, from-shape: Int, shapes: List<List<Form>>, base: Int)
    let shifted = (pend + occ) / _pow2(height)
    let state = shifted * base + code
    if not map.contains(next, state)
        let added = map.put(next, state, true)
    var s = from-shape
    while s < list.length(shapes)
        if (code / _pow2(3 * s)) % 8 > 0
            var f = 0
            while f < list.length(shapes[s])
                let form = shapes[s][f]
                var row = 0
                while row + form.height <= height
                    var bits = 0
                    var ok = true
                    var i = 0
                    while ok and i < list.length(form.cells)
                        let cell = form.cells[i]
                        let bit-col = cell % form.width
                        let bit-row = row + cell / form.width
                        if anchor + bit-col >= width
                            ok = false
                        else
                            let place = _pow2(bit-col * height + bit-row)
                            if ((pend + occ) / place) % 2 == 1
                                ok = false
                            else
                                bits = bits + place
                        i = i + 1
                    if ok
                        _fill-column(next, occ + bits, pend, code - _pow2(3 * s), anchor, width, height, s, shapes, base)
                    row = row + 1
                f = f + 1
        s = s + 1

# Whether the presents pack into the region, by a column sweep: the
# frontier holds every reachable (pending-coverage, remaining-counts)
# state after each anchor column, counts packed three bits per shape.
# shortcut: the state key needs max-shape-width * height + counts bits
# under 63 — 3-wide shapes cap height at 14; taller regions must be
# decided by the filters, which the real input satisfies.
word _region-packs(width: Int, height: Int, shapes: List<List<Form>>, counts: List<Int>) -> Bool
    var code = 0
    for s in range(0, list.length(counts))
        code = code + counts[s] * _pow2(3 * s)
    let base = _pow2(3 * list.length(counts))
    var frontier: Map<Int, Bool> = {}
    let seeded = map.put(frontier, code, true)
    var answer = false
    var anchor = 0
    while not answer and anchor < width and map.length(frontier) > 0
        let next: Map<Int, Bool> = {}
        for key, value in frontier
            if key % base == 0
                answer = true
            else
                _fill-column(next, 0, key / base, key % base, anchor, width, height, 0, shapes, base)
        frontier = next
        anchor = anchor + 1
    if not answer
        for key, value in frontier
            if key % base == 0
                answer = true
    answer

# Whether a region holds its whole present list: the #-cell sum filter,
# then the slot filter (that many max-size presents always fit), then
# the backtracker. The sample's third region passes both filters and
# still fails to pack — the example's whole lesson.
word _region-fits(farm: Farm, region: Region) -> Bool
    let plan: List<Int> = []
    var needed = 0
    var max-width = 0
    var max-height = 0
    for shape in range(0, list.length(region.counts))
        for copy in range(0, region.counts[shape])
            list.append(plan, shape)
            let first = farm.shapes[shape][0]
            needed = needed + first.pixels
            if first.width > max-width
                max-width = first.width
            if first.height > max-height
                max-height = first.height
    if needed > region.width * region.height
        false
    else
        if list.length(plan) == 0
            true
        else
            if list.length(plan) <= (region.width / max-width) * (region.height / max-height)
                true
            else
                let counts: List<Int> = []
                for count in region.counts
                    list.append(counts, count)
                _region-packs(region.width, region.height, farm.shapes, counts)

## Count the regions whose presents all fit.
word part-one(farm: Farm) -> Int
    var total = 0
    for region in farm.regions
        if _region-fits(farm, region)
            total = total + 1
    total

## The event's finale: with every star collected there is nothing left
## to compute — the customary completion answer is the star itself.
word part-two(farm: Farm) -> String
    "*"

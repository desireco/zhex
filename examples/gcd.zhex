# Greatest common divisor by Euclid's method.
# Recursion and a flow seeded with a computed call.

word gcd(a: Int, b: Int) -> Int
    if b == 0
        a
    else
        gcd(b, a % b)

let a-line = read-line("First number: ") try
let a = text.to-int(a-line) try
let b-line = read-line("Second number: ") try
let b = text.to-int(b-line) try

if a < 0 or b < 0
    print("Enter two nonnegative integers.")
else
    flow gcd(a, b)
        print

word factorial(n: Int) -> Int
    var product = 1

    for factor in range(1, n + 1)
        product = product * factor

    product

let number-line = read-line("Factorial of (0..20): ") try
let number = text.to-int(number-line) try

if number < 0 or number > 20
    print("Enter a number from 0 to 20.")
else
    flow number
        factorial
        print

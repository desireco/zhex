## A with block fixes one seed value: every step receives the seed as
## its first argument, never the previous step's result, and the last
## step's value is the block's value.

let name = "zhex"

let shout = flow name
with text
    upper
    length
    slice 1, 3
print(shout)

let values = [1, 2]

let kept = values
with list
    append(3)
    length
print(kept)

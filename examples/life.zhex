# Conway's Game of Life on a 7 by 7 board. Reads beyond the board recover as dead cells.
word next-cell(grid: Array<Int>, row: Int, column: Int) -> Int
    let current = grid[row, column] try
    var around = 0
    for r in range(row - 1, row + 2)
        for c in range(column - 1, column + 2)
            if r != row or c != column
                let neighbor = grid[r, c] catch
                    0
                if neighbor == 1
                    around = around + 1

    if current == 1
        if around == 2 or around == 3
            1
        else
            0
    else
        if around == 3
            1
        else
            0

word advance(grid: Array<Int>) -> Array<Int>
    let following: Array<Int> = array.new([7, 7], 0) try
    for row in range(0, 7)
        for column in range(0, 7)
            following[row, column] = next-cell(grid, row, column) try
    following

word show(grid: Array<Int>) -> Unit
    for row in range(0, 7)
        var line = ""
        for column in range(0, 7)
            if grid[row, column] try == 1
                line = line + "#"
            else
                line = line + "."
        print(line)

let start: Array<Int> = array.new([7, 7], 0) try
start[2, 3] = 1
start[3, 4] = 1
start[4, 2] = 1
start[4, 3] = 1
start[4, 4] = 1

print("Generation 0")
flow start
    show try
print("Generation 1")
flow start
    advance try
    show try
print("Generation 2")
flow start
    advance try
    advance try
    show try
print("Generation 3")
flow start
    advance try
    advance try
    advance try
    show try
print("Generation 4")
flow start
    advance try
    advance try
    advance try
    advance try
    show try

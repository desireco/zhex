# Conway's Game of Life on a 7 by 7 board with a fixed-dead exterior.
word next-cell(grid: Array<Int>, row: Int, column: Int) -> Int
    let current = grid[row, column]
    var around = 0
    for r in range(row - 1, row + 2)
        for c in range(column - 1, column + 2)
            if r >= 0 and r < 7 and c >= 0 and c < 7 and (r != row or c != column)
                if grid[r, c] == 1
                    around = around + 1

    if current == 1
        if around == 2 or around == 3
            1
        else
            0
    else
        if around == 3
            1
        else
            0

word advance(grid: Array<Int>) -> Array<Int>
    let following: Array<Int> = array.new([7, 7], 0)
    for row in range(0, 7)
        for column in range(0, 7)
            following[row, column] = next-cell(grid, row, column)
    following

word show(grid: Array<Int>, generation: Int) -> Array<Int>
    print("Generation " + int.to-string(generation))
    for row in range(0, 7)
        var line = ""
        for column in range(0, 7)
            if grid[row, column] == 1
                line = line + "#"
            else
                line = line + "."
        print(line)
    grid

let start: Array<Int> = array.new([7, 7], 0)
start[2, 3] = 1
start[3, 4] = 1
start[4, 2] = 1
start[4, 3] = 1
start[4, 4] = 1

flow start
    show(0)
    advance
    show(1)
    advance
    show(2)
    advance
    show(3)
    advance
    show(4)

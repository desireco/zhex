use diff
use test

# One change as a comparable tag: keep:/delete:/insert: plus the line, so a
# whole diff pins to one comma-joined string.
word tag(change: diff.Change) -> String
    match change
        case diff.Change.Keep(line)
            "keep:" + line
        case diff.Change.Delete(line)
            "delete:" + line
        case diff.Change.Insert(line)
            "insert:" + line

word shape(a: String, b: String) -> String
    text.join(list.map(diff.lines(a, b), tag(_)), ",")

word round-trips(a: String, b: String, label: String)
    let patched = diff.apply(a, diff.lines(a, b)) catch "FAILED"
    test.check(patched == b, label)

word fails(text: String, changes: List<diff.Change>, label: String)
    let patched = diff.apply(text, changes) catch "failed"
    test.check(patched == "failed", label)

# all keep: identical texts are one Keep per line
test.check(shape("a\nb", "a\nb") == "keep:a,keep:b", "identical texts are all keeps")
round-trips("a\nb", "a\nb", "identical texts apply unchanged")

# empty texts: the split convention keeps one empty line, so even the
# empty-against-empty diff is a single Keep of ""
test.check(shape("", "") == "keep:", "empty against empty keeps the one empty line")
round-trips("", "", "empty round trips")
round-trips("", "a\nb", "insert into empty round trips")
round-trips("a\nb", "", "delete to empty round trips")

# single insert mid-list
test.check(shape("a\nc", "a\nb\nc") == "keep:a,insert:b,keep:c", "single mid insert")
round-trips("a\nc", "a\nb\nc", "mid insert round trips")

# single delete mid-list
test.check(shape("a\nb\nc", "a\nc") == "keep:a,delete:b,keep:c", "single mid delete")
round-trips("a\nb\nc", "a\nc", "mid delete round trips")

# full replacement
round-trips("x\ny", "p\nq", "full replacement round trips")
test.check(shape("x\ny", "p\nq") == "delete:x,delete:y,insert:p,insert:q", "full replacement deletes then inserts")

# adjacent edits: two neighboring lines change and one line is added
round-trips("a\nb\nc\nd", "a\nB\nC\nd\ne", "adjacent edits round trips")

# block move shape: a run reappears elsewhere (delete here, insert there)
round-trips("a\nb\nc\nd", "c\nd\na\nb", "block move round trips")

# CRLF inputs normalize to LF before diffing and come back as LF
round-trips("a\r\nb\r\n", "a\r\nx\r\n", "CRLF inputs normalize like md.parse")

# property sweep: deterministic LCG line lists over a 5-token alphabet,
# the law apply(diff(a, b), a) == b
word next-seed(state: Int) -> Int
    (state * 1103515245 + 12345) % 2147483648

var seed = 20261121
for case-index in range(0, 300)
    var a-lines = list.new()
    var b-lines = list.new()
    for a-index in range(0, 6 + case-index % 7)
        seed = next-seed(seed)
        a-lines = list.append(a-lines, "l" + int.to-string(seed % 5))
    for b-index in range(0, 6 + (case-index * 3) % 7)
        seed = next-seed(seed)
        b-lines = list.append(b-lines, "l" + int.to-string(seed % 5))
    round-trips(text.join(a-lines, "\n"), text.join(b-lines, "\n"), "round trip case " + int.to-string(case-index))

# the checked apply channel: misalignment fails diff-apply
fails("x\n", [diff.Change.Delete("y")], "delete mismatching the cursor line fails")
fails("a\nb\n", [diff.Change.Keep("a")], "keep after a mismatch fails")
fails("a\nb\n", [diff.Change.Keep("a"), diff.Change.Keep("b")], "unconsumed trailing text fails")
fails("a\n", [diff.Change.Keep("a"), diff.Change.Delete("a")], "cursor past the last line fails")

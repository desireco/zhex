# A stored-ZIP writer: entries in, bytes out. Every archive entry is
# written uncompressed (method 0, the STORED mode), so the local file
# headers, the central directory, and the end-of-central-directory record
# are the whole format — no compressor, no checksum beyond CRC32.
#
# Pinned contracts:
# - One archive is a flat List<Int> of bytes, each 0..255, little-endian
#   multi-byte fields included; hand it to file.write-bytes to land it.
# - Entry order is preserved; the caller controls which entry comes first
#   (for #213's EPUB assembly: keep `mimetype` first — stored mode already
#   writes it uncompressed, which is exactly the EPUB rule).
# - Local headers carry version 2.0, flags 0, method 0, zero time and
#   date, and no name or extra encoding beyond the raw bytes given; names
#   and data are byte lists, and nothing sanitizes a path — the caller
#   owns the entry names it writes. text.to-code-points yields Unicode
#   code points, which are bytes only for ASCII; encoding non-ASCII text
#   as UTF-8 is the caller's job (#213's assembly decides its encoder).
# - An empty entries list renders the 22-byte end-of-central-directory
#   record alone, a valid empty archive.
# - The CRC32 table (the classic 256-entry reflected table over the
#   0xEDB88320 polynomial) is rebuilt at each crc32 call, inside the
#   word — Zhex has no module-level computed constants yet, and archive
#   calls crc32 once per entry, so the table cost rides the entry count.
# - Zhex has no bitwise operators, so xor32 decomposes both operands into
#   bits with / and % and reassembles the sum of differing powers of two;
#   shifts are divisions, masks are remainders. Values stay nonnegative,
#   so truncation direction never matters.

type Entry = record
    name: String
    bytes: List<Int>

## Bitwise xor of two nonnegative 32-bit values, bit by bit: a differing
## bit contributes its power of two.
word _xor32(a: Int, b: Int) -> Int
    var out = 0
    var bit = 1
    var i = 0
    while i < 32
        if (a / bit) % 2 != (b / bit) % 2
            out = out + bit
        bit = bit * 2
        i = i + 1
    out

## One row of the reflected CRC32 table: eight shift-and-reduce steps
## over the 0xEDB88320 polynomial.
word _table-row(index: Int) -> Int
    var c = index
    var round = 0
    while round < 8
        if c % 2 == 1
            c = _xor32(c / 2, 3988292384)
        else
            c = c / 2
        round = round + 1
    c

## The 256-entry table, rebuilt per crc32 call (see the module doc).
word _table() -> List<Int>
    var table: List<Int> = list.new()
    var i = 0
    while i < 256
        table = list.append(table, _table-row(i))
        i = i + 1
    table

## The classic table-driven CRC32 of a byte list: the check value of
## "123456789" is 3421780262.
## > crc32(text.to-code-points("123456789"))
## 3421780262
## > crc32([])
## 0
word crc32(bytes: List<Int>) -> Int
    var table = _table()
    var crc = 4294967295
    for b in bytes
        crc = _xor32(crc / 256, table[_xor32(crc, b) % 256])
    _xor32(crc, 4294967295)

## Appends one byte chunk to another, in order.
word _extend(out: List<Int>, chunk: List<Int>) -> List<Int>
    var acc = out
    for b in chunk
        acc = list.append(acc, b)
    acc

## Appends a 16-bit little-endian field.
word _le16(out: List<Int>, n: Int) -> List<Int>
    list.append(list.append(out, n % 256), (n / 256) % 256)

## Appends a 32-bit little-endian field.
word _le32(out: List<Int>, n: Int) -> List<Int>
    var acc = _le16(out, n % 65536)
    _le16(acc, n / 65536)

## The 30-byte local file header plus the name: signature 0x04034b50,
## version 2.0, flags 0, method 0, zero time and date, then CRC, sizes,
## name length, and an empty extra field.
## shortcut: size is written modulo 2^32, so an entry over 4 GiB corrupts the archive, upgrade to ZIP64 when books get that big.
word _local-header(name-bytes: List<Int>, crc: Int, size: Int) -> List<Int>
    var out: List<Int> = list.new()
    out = _le32(out, 67324752)
    out = _le16(out, 20)
    out = _le16(out, 0)
    out = _le16(out, 0)
    out = _le16(out, 0)
    out = _le16(out, 0)
    out = _le32(out, crc)
    out = _le32(out, size)
    out = _le32(out, size)
    out = _le16(out, list.length(name-bytes))
    out = _le16(out, 0)
    _extend(out, name-bytes)

## The 46-byte central directory header plus the name, mirroring the
## local header and adding the local header's offset; disk numbers and
## attribute fields stay zero.
word _central-header(name-bytes: List<Int>, crc: Int, size: Int, offset: Int) -> List<Int>
    var out: List<Int> = list.new()
    out = _le32(out, 33639248)
    out = _le16(out, 20)
    out = _le16(out, 20)
    out = _le16(out, 0)
    out = _le16(out, 0)
    out = _le16(out, 0)
    out = _le16(out, 0)
    out = _le32(out, crc)
    out = _le32(out, size)
    out = _le32(out, size)
    out = _le16(out, list.length(name-bytes))
    out = _le16(out, 0)
    out = _le16(out, 0)
    out = _le16(out, 0)
    out = _le16(out, 0)
    out = _le32(out, 0)
    out = _le32(out, offset)
    _extend(out, name-bytes)

## The 22-byte end-of-central-directory record.
## shortcut: count is written modulo 2^16, so over 65535 entries corrupts the archive, upgrade to ZIP64 when a book needs more files.
word _eocd(count: Int, directory-size: Int, directory-offset: Int) -> List<Int>
    var out: List<Int> = list.new()
    out = _le32(out, 101010256)
    out = _le16(out, 0)
    out = _le16(out, 0)
    out = _le16(out, count)
    out = _le16(out, count)
    out = _le32(out, directory-size)
    out = _le32(out, directory-offset)
    _le16(out, 0)

## Assembles stored (uncompressed) entries into one ZIP byte list:
## each entry's local header and data in order, then the central
## directory, then the end-of-central-directory record. A one-entry
## archive of an empty name and no data is 98 bytes.
## > list.length(archive([Entry("a", [])]))
## 100
word archive(entries: List<Entry>) -> List<Int>
    var body: List<Int> = list.new()
    var directory: List<Int> = list.new()
    var offset = 0
    var count = 0
    for e in entries
        let name-bytes = text.to-code-points(e.name)
        let crc = crc32(e.bytes)
        let size = list.length(e.bytes)
        let local = _local-header(name-bytes, crc, size)
        body = _extend(body, local)
        body = _extend(body, e.bytes)
        directory = _extend(directory, _central-header(name-bytes, crc, size, offset))
        offset = offset + list.length(local) + size
        count = count + 1
    let archive-with-directory = _extend(body, directory)
    _extend(archive-with-directory, _eocd(count, list.length(directory), offset))

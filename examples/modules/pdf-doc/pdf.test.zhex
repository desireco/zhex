# PDF module tests: the escape law (ASCII literal, punctuation escaped,
# Latin-1 in octal, over-fence failure), the text-block operators, the
# content /Length, the assembled document's header, xref offsets, and
# trailer, plus the chapter vocabulary: the wrap stand-in's boundaries
# through chapter-lines, multi-page assembly, and page-break placement.
# The viewer verification — pdfinfo and qpdf --check on the written
# file — runs in the ticket's gate, not here; this file pins structure.
use pdf
use test

# the escape law
test.check(pdf.escape("a(b)\\c") try == "a\\(b\\)\\\\c", "punctuation escapes")
test.check(pdf.escape("na" + text.from-code-points([233]) + "ve") try == "na\\351ve", "Latin-1 byte becomes octal")
test.check(pdf.escape("plain ascii") try == "plain ascii", "ASCII stays literal")
let over = pdf.escape(text.from-code-points([20320])) catch "failed"
test.check(over == "failed", "a code point above the Latin-1 fence fails")

# the text-block operators
let block = pdf.text-block(24, 16, ["One", "Two"]) try
test.check(text.starts-with(block, "BT\n/F1 24 Tf\n72 770 Td\n"), "Tf size and first-baseline Td")
test.check(text.contains(block, "0 -16 TD\n(Two) Tj"), "later lines step one leading via TD")
test.check(text.contains(block, "(One) Tj"), "text draws with Tj")
test.check(text.ends-with(block, "ET"), "the block closes with ET")

# the content stream /Length counts the operators it wraps
let body = pdf.content-body("BT ET")
test.check(body == "<< /Length 5 >>\nstream\nBT ET\nendstream", "content body pins shape and length")

# the two-page document: header, object shapes, xref law, trailer
let ops = pdf.text-block(12, 16, ["line"]) try
let doc = pdf.document([
    pdf.obj(1, pdf.catalog-body()),
    pdf.obj(2, pdf.pages-body([4, 6])),
    pdf.obj(3, pdf.font-body()),
    pdf.obj(4, pdf.page-body(2, 5)),
    pdf.obj(5, pdf.content-body(ops)),
    pdf.obj(6, pdf.page-body(2, 7)),
    pdf.obj(7, pdf.content-body(ops))
])
test.check(text.starts-with(doc, "%PDF-1.4\n"), "the header comes first")
test.check(text.slice(doc, 9, 17) == "1 0 obj\n", "the first xref entry points at object 1")
test.check(pdf.catalog-body() == "<< /Type /Catalog /Pages 2 0 R >>", "catalog pins the page tree")
test.check(pdf.pages-body([4, 6]) == "<< /Type /Pages /Kids [4 0 R 6 0 R ] /Count 2 >>", "page tree pins both kids")
test.check(pdf.font-body() == "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>", "font pins base-14 Helvetica")
test.check(text.contains(doc, "/Count 2"), "the page tree counts two pages")
test.check(list.length(text.split(doc, "/Type /Page ")) == 3, "two page objects")
test.check(list.length(text.split(doc, "stream\nBT")) == 3, "two content streams")
test.check(pdf.obj(3, "body") == "3 0 obj\nbody\nendobj\n", "objects pin their number and wrapper")

# startxref names the byte (character, under the ASCII law) offset of xref
let at = text.index-of(doc, "startxref\n")
let tail = text.slice(doc, at + 10, text.length(doc))
let digits = text.slice(tail, 0, text.index-of(tail, "\n"))
let xref-offset = text.to-int(digits) try
test.check(text.slice(doc, xref-offset, xref-offset + 4) == "xref", "startxref points at the xref table")
test.check(text.ends-with(doc, "%%EOF\n"), "the trailer ends the file")

# the wrap stand-in's boundaries, observed through chapter-lines:
# an exact-width line fits unbroken, a wider pair wraps at the width,
# an over-long word overflows alone rather than breaking mid-word,
# and an empty paragraph renders as one empty line
let exact = pdf.chapter-lines(pdf.Chapter("T", ["aaaa bb"]), 7) try
test.check(text.join(exact, "|") == "T||aaaa bb", "an exact-width line stays one line")
let wrapped = pdf.chapter-lines(pdf.Chapter("T", ["aaa bbb ccc"]), 7) try
test.check(text.join(wrapped, "|") == "T||aaa bbb|ccc", "words wrap at the width")
let long-word = pdf.chapter-lines(pdf.Chapter("T", ["abcdefghij xy"]), 4) try
test.check(text.join(long-word, "|") == "T||abcdefghij|xy", "an over-long word overflows alone")
let empty-para = pdf.chapter-lines(pdf.Chapter("T", [""]), 10) try
test.check(text.join(empty-para, "|") == "T||", "an empty paragraph renders one empty line")

# chapter-lines escapes through the chapter path and a blank line
# separates paragraphs
let escaped = pdf.chapter-lines(pdf.Chapter("a(b)", ["c\\d", "second"]), 20) try
test.check(text.join(escaped, "|") == "a\\(b\\)||c\\\\d||second", "chapter lines arrive escaped")

# the Latin-1 fence fails through the chapter path too
let fenced = text.join(pdf.chapter-lines(pdf.Chapter("T", [text.from-code-points([20320]) + "!"]), 10) catch ["failed"], "|")
test.check(fenced == "failed", "a chapter paragraph outside the fence fails pdf-latin1")

# multi-page assembly: width 20, four body lines per page (two on a
# chapter's first page beside the 24pt title); chapter two runs long
# enough to break onto continuation pages
let chapters = [
    pdf.Chapter("One", ["aaa bbb ccc ddd eee fff ggg hhh"]),
    pdf.Chapter("Two", [
        "p1 aa bb",
        "p2 cc dd",
        "p3 ee ff",
        "p4 gg hh"
    ]),
    pdf.Chapter("Three", ["short body"])
]
let pages = pdf.book-pages(chapters, 20, 4) try

# chapter one: one paragraph wraps to two lines, both fit the title page;
# chapter two: four paragraphs plus separator blanks = seven body lines —
# two on the title page, then four, then one spills to a third page;
# chapter three starts fresh — pins below fix the exact placement
test.check(list.length(pages) == 5, "the book runs to five pages")
test.check(text.contains(pages[0], "/F1 24 Tf"), "a chapter's first page sets the 24pt title size")
test.check(text.contains(pages[0], "(One) Tj"), "the title page draws the chapter title")
test.check(text.contains(pages[1], "(Two) Tj"), "chapter two follows on the next page")
test.check(text.starts-with(pages[2], "BT\n/F1 12 Tf"), "a continuation page is a plain 12pt text-block")
test.check(text.contains(pages[4], "/F1 24 Tf") and text.contains(pages[4], "(Three) Tj"), "chapter three starts on its own fresh page")
var title-pages = 0
for p in pages
    if text.contains(p, "/F1 24 Tf")
        title-pages = title-pages + 1
test.check(title-pages == 3, "one title page per chapter, three chapters")

# the whole book: page tree counts the pages, and the xref law holds
let book = pdf.book(chapters, 20, 4) try
test.check(text.contains(book, "/Count 5"), "the page tree counts five pages")
test.check(text.starts-with(book, "%PDF-1.4\n"), "the book header comes first")
let book-at = text.index-of(book, "startxref\n")
let book-tail = text.slice(book, book-at + 10, text.length(book))
let book-digits = text.slice(book-tail, 0, text.index-of(book-tail, "\n"))
let book-xref = text.to-int(book-digits) try
test.check(text.slice(book, book-xref, book-xref + 4) == "xref", "startxref points at the book's xref table")
test.check(text.ends-with(book, "%%EOF\n"), "the book trailer ends the file")

print "pdf module tests passed"

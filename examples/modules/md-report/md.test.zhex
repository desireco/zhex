use md
use test

word expect-count(doc: md.Doc, n: Int, label: String)
    test.check(list.length(doc.blocks) == n, label)

word expect-heading(doc: md.Doc, i: Int, level: Int, text: String, label: String)
    match doc.blocks[i]
        case md.Block.Heading(got-level, got-text)
            test.check(got-level == level, label + ": level")
            test.check(got-text == text, label + ": text")
        case _
            test.check(false, label + ": not a heading")

word expect-paragraph(doc: md.Doc, i: Int, text: String, label: String)
    match doc.blocks[i]
        case md.Block.Paragraph(got)
            test.check(got == text, label)
        case _
            test.check(false, label + ": not a paragraph")

word expect-rule(doc: md.Doc, i: Int, label: String)
    match doc.blocks[i]
        case md.Block.Rule
            test.check(true, label)
        case _
            test.check(false, label + ": not a rule")

# headings
expect-count(md.parse("# Title"), 1, "one heading, one block")
expect-heading(md.parse("# Title"), 0, 1, "Title", "level-one heading")
expect-heading(md.parse("###### Deep"), 0, 6, "Deep", "level-six heading")
expect-heading(md.parse("##"), 0, 2, "", "bare marker is an empty heading")
expect-heading(md.parse("##   spaced   "), 0, 2, "spaced", "heading text is trimmed")
expect-paragraph(md.parse("#NoSpace"), 0, "#NoSpace", "marker without a space is text")
expect-paragraph(md.parse("####### seven"), 0, "####### seven", "seven markers are text")

# paragraphs
expect-count(md.parse(""), 0, "empty text has no blocks")
expect-count(md.parse("\n\n\n"), 0, "only blank lines have no blocks")
expect-paragraph(md.parse("one"), 0, "one", "single line")
expect-paragraph(md.parse("one\ntwo"), 0, "one\ntwo", "lines join with newlines")
expect-count(md.parse("one\n\ntwo"), 2, "blank line splits paragraphs")
expect-paragraph(md.parse("\n\none\n"), 0, "one", "leading and trailing blanks are ignored")

# rules
expect-rule(md.parse("---"), 0, "dashes are a rule")
expect-rule(md.parse("***"), 0, "stars are a rule")
expect-rule(md.parse("___"), 0, "underscores are a rule")
expect-rule(md.parse("------"), 0, "long runs are one rule")
expect-paragraph(md.parse("--"), 0, "--", "two dashes are text")
expect-paragraph(md.parse("-*-"), 0, "-*-", "mixed markers are text")

# mixed documents and blank-line rules
let mixed = md.parse("# T\n\nintro\nline\n\n---\n\noutro")
expect-count(mixed, 4, "mixed document block count")
expect-heading(mixed, 0, 1, "T", "mixed: heading")
expect-paragraph(mixed, 1, "intro\nline", "mixed: multi-line paragraph")
expect-rule(mixed, 2, "mixed: rule")
expect-paragraph(mixed, 3, "outro", "mixed: closing paragraph")
let tight = md.parse("para\n# Head")
expect-count(tight, 2, "a heading ends a paragraph without a blank line")

# list items and quotes
word expect-bullet(doc: md.Doc, i: Int, marker: String, text: String, indent: Int, label: String)
    match doc.blocks[i]
        case md.Block.BulletItem(got-marker, got-text, got-indent)
            test.check(got-marker == marker, label + ": marker")
            test.check(got-text == text, label + ": text")
            test.check(got-indent == indent, label + ": indent")
        case _
            test.check(false, label + ": not a bullet item")

word expect-ordered(doc: md.Doc, i: Int, marker: String, text: String, indent: Int, label: String)
    match doc.blocks[i]
        case md.Block.OrderedItem(got-marker, got-text, got-indent)
            test.check(got-marker == marker, label + ": marker")
            test.check(got-text == text, label + ": text")
            test.check(got-indent == indent, label + ": indent")
        case _
            test.check(false, label + ": not an ordered item")

word expect-quote(doc: md.Doc, i: Int, text: String, indent: Int, label: String)
    match doc.blocks[i]
        case md.Block.Quote(got-text, got-indent)
            test.check(got-text == text, label + ": text")
            test.check(got-indent == indent, label + ": indent")
        case _
            test.check(false, label + ": not a quote")

# bullet markers are kept verbatim
expect-bullet(md.parse("- dash"), 0, "-", "dash", 0, "dash bullet")
expect-bullet(md.parse("* star"), 0, "*", "star", 0, "star bullet")
expect-bullet(md.parse("+ plus"), 0, "+", "plus", 0, "plus bullet")
expect-bullet(md.parse("-"), 0, "-", "", 0, "bare marker is an empty item")
expect-paragraph(md.parse("-nodash"), 0, "-nodash", "bullet marker without a space is text")

# ordered markers: digits then . or )
expect-ordered(md.parse("1. one"), 0, "1.", "one", 0, "dot ordered item")
expect-ordered(md.parse("2) two"), 0, "2)", "two", 0, "paren ordered item")
expect-ordered(md.parse("10. ten"), 0, "10.", "ten", 0, "multi-digit ordered item")
expect-paragraph(md.parse("1.no-space"), 0, "1.no-space", "ordered marker without a space is text")
expect-paragraph(md.parse("1.5"), 0, "1.5", "a digit run without a delimiter is text")

# indent fields: two leading spaces per level, odd counts floor
let nested = md.parse("- top\n  - child\n    - grandchild\n- back")
expect-count(nested, 4, "nested list keeps four flat items")
expect-bullet(nested, 0, "-", "top", 0, "nested: level zero")
expect-bullet(nested, 1, "-", "child", 1, "nested: one level")
expect-bullet(nested, 2, "-", "grandchild", 2, "nested: two levels")
expect-bullet(nested, 3, "-", "back", 0, "nested: back to level zero")
expect-ordered(md.parse("  1. inside"), 0, "1.", "inside", 1, "ordered items indent too")

# blank lines split lists; a heading or plain line ends one without them
expect-count(md.parse("- a\n\n- b"), 2, "a blank line splits a list into two blocks")
expect-paragraph(md.parse("- a\nplain"), 1, "plain", "a plain follower line is paragraph text")

# quotes: text after > is trimmed, indent counted like lists
expect-quote(md.parse("> quoted"), 0, "quoted", 0, "quote line")
expect-quote(md.parse(">"), 0, "", 0, "bare > is an empty quote")
expect-quote(md.parse("  > indented"), 0, "indented", 1, "quote indent counts two spaces")
expect-count(md.parse("> a\n\n> b"), 2, "a blank line splits quotes into two blocks")

# mixed document with the parser I blocks
let doc = md.parse("# T\n\n- a\n  - b\n\n1. one\n\n> note\n\nend")
expect-count(doc, 6, "mixed document block count")
expect-heading(doc, 0, 1, "T", "mixed: heading")
expect-bullet(doc, 1, "-", "a", 0, "mixed: bullet")
expect-bullet(doc, 2, "-", "b", 1, "mixed: nested bullet")
expect-ordered(doc, 3, "1.", "one", 0, "mixed: ordered")
expect-quote(doc, 4, "note", 0, "mixed: quote")
expect-paragraph(doc, 5, "end", "mixed: closing paragraph")

# the round trip for this subset
let source = "# T\n\nintro\nline\n\n---\n\noutro"
test.check(md.render(md.parse(source)) == source, "render(parse(source)) round trips")

# list and quote round trips: tight runs are byte-stable, loose ones tighten
test.check(md.render(md.parse("- a\n- b")) == "- a\n- b", "bullet list round trips")
test.check(md.render(md.parse("- a\n  - b\n- c")) == "- a\n  - b\n- c", "nested bullet list round trips")
test.check(md.render(md.parse("1. one\n2) two")) == "1. one\n2) two", "ordered markers survive the round trip")
test.check(md.render(md.parse("> a\n> b")) == "> a\n> b", "quote run round trips")
test.check(md.render(md.parse(">")) == ">", "bare quote round trips")
test.check(md.render(md.parse("- a\n\n- b")) == "- a\n- b", "a blank line inside a list is dropped on render")
test.check(md.render(doc) == "# T\n\n- a\n  - b\n\n1. one\n\n> note\n\nend", "mixed document round trips")

# CRLF tolerance
expect-paragraph(md.parse("one\r\ntwo"), 0, "one\ntwo", "crlf lines join with lf")
test.check(md.render(md.parse("a\r\n\r\nb")) == "a\n\nb", "crlf separators normalize on render")

# fenced code blocks
word expect-code(doc: md.Doc, i: Int, fence: String, info: String, lines: List<String>, label: String)
    match doc.blocks[i]
        case md.Block.Code(got-fence, got-info, got-lines)
            test.check(got-fence == fence, label + ": fence")
            test.check(got-info == info, label + ": info")
            test.check(text.join(got-lines, "\n") == text.join(lines, "\n"), label + ": lines")
        case _
            test.check(false, label + ": not a code block")

let fenced = md.parse("```\ncode\n```")
expect-count(fenced, 1, "one fenced block, one block")
expect-code(fenced, 0, "```", "", ["code"], "plain fenced block")
expect-code(md.parse("```zhex\nlet x = 1\n```"), 0, "```", "zhex", ["let x = 1"], "info string is kept verbatim")
expect-code(md.parse("```   go   \nx\n```"), 0, "```", "go", ["x"], "info string is trimmed")
expect-code(md.parse("````\n```\n````"), 0, "````", "", ["```"], "a shorter all-backtick line stays content")
expect-count(md.parse("```\nabc"), 1, "an unclosed fence closes at end of text")
expect-code(md.parse("```\nabc"), 0, "```", "", ["abc"], "an unclosed fence keeps its lines")
expect-code(md.parse("```\n  kept\n```"), 0, "```", "", ["  kept"], "content indentation is verbatim")
expect-count(md.parse("```\na\n\nb\n```"), 1, "a blank line inside a fence is content")
expect-paragraph(md.parse("``\nx"), 0, "``\nx", "two backticks are not a fence")
expect-paragraph(md.parse("~~~\nx\n~~~"), 0, "~~~\nx\n~~~", "tilde fences are not recognized")

# tables
word same-cells(got: List<String>, want: List<String>) -> Bool
    text.join(got, "\n") == text.join(want, "\n")

word expect-table(doc: md.Doc, i: Int, header: List<String>, rows: List<List<String>>, label: String)
    match doc.blocks[i]
        case md.Block.Table(got-header, got-rows)
            test.check(same-cells(got-header, header), label + ": header")
            test.check(list.length(got-rows) == list.length(rows), label + ": row count")
            var j = 0
            while j < list.length(rows)
                test.check(same-cells(got-rows[j], rows[j]), label + ": row " + j)
                j = j + 1
        case _
            test.check(false, label + ": not a table")

let tab = md.parse("| a | b |\n| --- | --- |\n| 1 | 2 |")
expect-count(tab, 1, "one table, one block")
expect-table(tab, 0, ["a", "b"], [["1", "2"]], "plain table")
expect-table(md.parse("| a | b |\n| :-- | --: |\n| 1 | 2 |"), 0, ["a", "b"], [["1", "2"]], "alignment markers parse and drop")
expect-table(md.parse("| a | b |\n| --- | --- |\n| 1 |"), 0, ["a", "b"], [["1", ""]], "a short row pads with an empty cell")
expect-table(md.parse("| a | b |\n| --- | --- |\n| 1 | 2 | 3 |"), 0, ["a", "b"], [["1", "2"]], "an overlong row drops its excess cells")
expect-table(md.parse("| a\\|b | c |\n| --- | --- |\n| x | y |"), 0, ["a\\|b", "c"], [["x", "y"]], "a backslashed pipe stays in the cell")
expect-paragraph(md.parse("| a | b |\n| --- |\n| 1 |"), 0, "| a | b |\n| --- |\n| 1 |", "a narrower delimiter row is paragraph text")
let after-table = md.parse("| a |\n| --- |\n| 1 |\n\nafter")
expect-count(after-table, 2, "a blank line ends the table")
expect-table(after-table, 0, ["a"], [["1"]], "table before the blank line")
expect-paragraph(after-table, 1, "after", "paragraph after the table")

# mixed document with all eight block kinds
let full = md.parse("# T\n\nintro\n\n---\n\n- a\n\n1. one\n\n> note\n\n```\nx\n```\n\n| h |\n| --- |\n| r |\n\noutro")
expect-count(full, 9, "every block kind in one document")
expect-heading(full, 0, 1, "T", "full: heading")
expect-paragraph(full, 1, "intro", "full: paragraph")
expect-rule(full, 2, "full: rule")
expect-bullet(full, 3, "-", "a", 0, "full: bullet item")
expect-ordered(full, 4, "1.", "one", 0, "full: ordered item")
expect-quote(full, 5, "note", 0, "full: quote")
expect-code(full, 6, "```", "", ["x"], "full: code block")
expect-table(full, 7, ["h"], [["r"]], "full: table")
expect-paragraph(full, 8, "outro", "full: closing paragraph")

# code and table round trips
test.check(md.render(md.parse("```\ncode\n```")) == "```\ncode\n```", "plain code block round trips")
test.check(md.render(md.parse("````\n```\n````")) == "````\n```\n````", "a code block containing backticks round trips")
test.check(md.render(md.parse("```zhex\nlet x = 1\n```")) == "```zhex\nlet x = 1\n```", "info string survives the round trip")
test.check(md.render(md.parse("| a | b |\n| --- | --- |\n| 1 | 2 |")) == "| a | b |\n| --- | --- |\n| 1 | 2 |", "a plain table round trips")
test.check(md.render(md.parse("| a | b |\n| :-- | --: |\n| 1 | 2 |")) == "| a | b |\n| --- | --- |\n| 1 | 2 |", "alignment markers drop on the round trip")
test.check(md.render(md.parse("| a | b |\n| --- | --- |\n| 1 |")) == "| a | b |\n| --- | --- |\n| 1 |   |", "a padded cell renders padded")
test.check(md.render(full) == "# T\n\nintro\n\n---\n\n- a\n\n1. one\n\n> note\n\n```\nx\n```\n\n| h |\n| --- |\n| r |\n\noutro", "the full mixed document round trips")

# outline and section slicing
word expect-section(row: md.Section, index: Int, level: Int, text: String, label: String)
    test.check(row.index == index, label + ": index")
    test.check(row.level == level, label + ": level")
    test.check(row.text == text, label + ": text")

let spine = md.parse("# Book\n\nintro\n\n---\n\n- item\n\n1. one\n\n> note\n\n```\ncode\n```\n\n| h |\n| --- |\n| r |\n\n## Chapter\n\ntext\n\n### Deep\n\ndeep text\n\n## Second\n\nlast")
expect-count(spine, 14, "spine block count")
let rows = md.outline(spine)
test.check(list.length(rows) == 4, "outline lists every heading among all block kinds")
expect-section(rows[0], 0, 1, "Book", "outline row: first heading")
expect-section(rows[1], 8, 2, "Chapter", "outline row carries its block index")
expect-section(rows[2], 10, 3, "Deep", "outline row: level-three heading")
expect-section(rows[3], 12, 2, "Second", "outline row: last heading")
test.check(list.length(md.outline(md.parse("no headings here"))) == 0, "a heading-less document has an empty outline")
test.check(list.length(md.outline(md.parse(""))) == 0, "an empty document has an empty outline")

# a level-one section runs to the end; nested subsections ride along
let whole = md.section(spine, 0) try
expect-count(whole, 14, "a level-one section spans every block")
test.check(md.render(whole) == md.render(spine), "a level-one section renders the whole document")
let chapter = md.section(spine, 8) try
expect-count(chapter, 4, "a section keeps its nested subsections")
expect-heading(chapter, 0, 2, "Chapter", "section starts at its own heading")
expect-heading(chapter, 2, 3, "Deep", "a deeper subsection rides along")
expect-paragraph(chapter, 3, "deep text", "the subsection body rides along")
test.check(md.render(chapter) == "## Chapter\n\ntext\n\n### Deep\n\ndeep text", "a mid section renders heading to same-level heading")
let deep = md.section(spine, 10) try
expect-count(deep, 2, "a deepest section stops at any following heading")
let last = md.section(spine, 12) try
expect-count(last, 2, "the last section runs to the end of the document")
expect-heading(last, 0, 2, "Second", "the last section starts at its heading")
expect-paragraph(last, 1, "last", "the last section keeps its trailing body")

# section-text is the slice rendered, one composition away
test.check(md.section-text(spine, 8) try == "## Chapter\n\ntext\n\n### Deep\n\ndeep text", "section-text renders the slice")

# failure paths: slicing can fail, so section is a checked Result whose
# failure rides the interpreter's out-of-range diagnostic
word failed-slice(doc: md.Doc, index: Int, label: String) -> md.Doc
    let slice = md.section(doc, index) catch problem
        test.check(text.contains(error.message(problem), "out of range"), label + ": out-of-range message")
        md.Doc([])
    test.check(list.length(slice.blocks) == 0, label + ": fails to an empty Doc")
    slice

let _not-heading = failed-slice(spine, 1, "section on a non-heading index")
let _past-end = failed-slice(spine, 99, "section past the last block")
let _negative = failed-slice(spine, -1, "section on a negative index")
let _empty-doc = failed-slice(md.parse(""), 0, "section on an empty document")

# section editing — list operations on the flat block list, keyed by the
# Section index md.outline reports; spine headings sit at 0, 8, 10, 12 and
# the Chapter section spans blocks 8..12 with Deep riding along

# remove-section drops the whole slice, subsections with it
let no-chapter = md.remove-section(spine, 8) try
expect-count(no-chapter, 10, "remove drops the section slice")
expect-heading(no-chapter, 8, 2, "Second", "remove keeps later sections, shifted up")
test.check(md.render(no-chapter) == "# Book\n\nintro\n\n---\n\n- item\n\n1. one\n\n> note\n\n```\ncode\n```\n\n| h |\n| --- |\n| r |\n\n## Second\n\nlast", "remove renders the document without the section")
let no-book = md.remove-section(spine, 0) try
expect-count(no-book, 0, "removing the level-one section takes every block")

# replace-section swaps the slice for another Doc's blocks
let swapped = md.replace-section(spine, 8, md.parse("## New\n\nfresh")) try
expect-count(swapped, 12, "replace keeps the block count honest")
expect-heading(swapped, 8, 2, "New", "replace lands the replacement at the index")
expect-paragraph(swapped, 9, "fresh", "replace carries the replacement body")
expect-heading(swapped, 10, 2, "Second", "replace keeps later sections in place")
test.check(md.render(swapped) == "# Book\n\nintro\n\n---\n\n- item\n\n1. one\n\n> note\n\n```\ncode\n```\n\n| h |\n| --- |\n| r |\n\n## New\n\nfresh\n\n## Second\n\nlast", "replace renders the edited document")

# insert-section splices another Doc's blocks in before a block index
let with-preface = md.insert-section(spine, 8, md.parse("## Preface\n\nwords")) try
expect-count(with-preface, 16, "insert splices the addition's blocks in")
expect-heading(with-preface, 8, 2, "Preface", "insert lands before the given block index")
expect-heading(with-preface, 10, 2, "Chapter", "insert pushes the old blocks down")
let at-top = md.insert-section(spine, 0, md.parse("# Cover")) try
expect-heading(at-top, 0, 1, "Cover", "insert at zero is the new first block")
let at-end = md.insert-section(spine, 14, md.parse("## Tail")) try
expect-heading(at-end, 14, 2, "Tail", "insert at the block count appends")
test.check(md.render(md.parse(md.render(no-chapter))) == md.render(no-chapter), "an edited document round trips through parse and render")

# promote and demote shift every heading in the slice, clamped at 1 and 6
let lifted = md.promote(spine, 8)
expect-heading(lifted, 8, 1, "Chapter", "promote lifts the section heading")
expect-heading(lifted, 10, 2, "Deep", "promote lifts nested headings with it")
expect-paragraph(lifted, 9, "text", "promote leaves non-headings alone")
let pinned = md.promote(spine, 0)
expect-heading(pinned, 0, 1, "Book", "promote clamps a level-one heading at one")
expect-heading(pinned, 8, 1, "Chapter", "the clamp still shifts inner headings")
expect-heading(pinned, 10, 2, "Deep", "inner headings shift under the clamped top")
let sunk = md.demote(spine, 12)
expect-heading(sunk, 12, 3, "Second", "demote lowers the section heading")
expect-heading(md.demote(md.parse("###### Deep"), 0), 0, 6, "Deep", "demote clamps at level six")
test.check(md.render(md.promote(spine, 1)) == md.render(spine), "promote on a non-heading index is a no-op")
test.check(md.render(md.promote(spine, 99)) == md.render(spine), "promote past the end is a no-op")

# move-section lifts the slice out and splices it before a block index
let moved-up = md.move-section(spine, 8, 0) try
expect-count(moved-up, 14, "move keeps every block")
expect-heading(moved-up, 0, 2, "Chapter", "move lands the section before the target")
expect-heading(moved-up, 4, 1, "Book", "the displaced blocks shift down")
let moved-down = md.move-section(spine, 12, 0) try
expect-heading(moved-down, 0, 2, "Second", "a later section moves before an earlier one")
expect-heading(moved-down, 2, 1, "Book", "the rest keeps its order")
let moved-end = md.move-section(spine, 8, 14) try
expect-heading(moved-end, 10, 2, "Chapter", "move to the block count sends the section to the end")
test.check(md.render(md.move-section(spine, 8, 12) try) == md.render(spine), "moving to the slice's own edge is the identity")
test.check(md.render(md.move-section(spine, 8, 9) try) == md.render(spine), "a to inside the section's own range is the identity")

# failure paths: every fallible op rides md.section's checked out-of-range
# channel, naming the offending index
let bad-remove = md.remove-section(spine, 99) catch problem
    test.check(text.contains(error.message(problem), "out of range"), "remove past the end: out-of-range message")
    md.Doc([])
expect-count(bad-remove, 0, "remove past the end fails to an empty Doc")
let non-heading = md.remove-section(spine, 1) catch problem
    test.check(text.contains(error.message(problem), "out of range"), "remove on a non-heading: the channel's past-end read")
    md.Doc([])
let bad-insert = md.insert-section(spine, 15, md.parse("# X")) catch problem
    test.check(text.contains(error.message(problem), "out of range"), "insert past the block count: out-of-range message")
    md.Doc([])
let bad-negative = md.insert-section(spine, -1, md.parse("# X")) catch problem
    test.check(text.contains(error.message(problem), "out of range"), "insert at a negative index: out-of-range message")
    md.Doc([])
let bad-move-to = md.move-section(spine, 8, 15) catch problem
    test.check(text.contains(error.message(problem), "out of range"), "move past the block count: out-of-range message")
    md.Doc([])
let bad-move-from = md.move-section(spine, 1, 0) catch problem
    test.check(text.contains(error.message(problem), "out of range"), "move on a non-heading index: out-of-range message")
    md.Doc([])

# the round-trip law, as the module docs state it: render(parse(text))
# == text for canonical text, and one pass canonicalizes the shape
# divergences (loose lists, alignment markers, cell padding, CRLF) so
# the second pass is the identity
word _round-trips(text: String, label: String)
    test.check(md.render(md.parse(text)) == text, label)

word _canonicalizes(text: String, label: String)
    let once = md.render(md.parse(text))
    test.check(md.render(md.parse(once)) == once, label)

# corpus-grade fixtures under the equality law — four documents whose
# rendered positions carry no escapable punctuation
let tech-doc = "# Build Report\n\nThe pipeline runs three stages and writes one artifact\n\n## Compile\n\nSource files compile to a module\n\n```zhex\nlet x = 1\nlet y = x * 2\n```\n\n## Timing\n\n| stage | ms  | note |\n| ----- | --- | ---- |\n| build | 90  | fast |\n| link  | 140 | slow |\n\nSee the timing table above"
_round-trips(tech-doc, "technical doc with code and a table round trips")

let outline-doc = "# Handbook\n\nIntro words for the top section\n\n## Part One\n\nFirst part prose\n\n### Step A\n\nDetail for step a\n\n### Step B\n\nDetail for step b\n\n## Part Two\n\nSecond part prose\n\n---\n\n## Part Three\n\nThird part prose after a rule"
_round-trips(outline-doc, "outline-heavy doc round trips")

let list-doc = "# Checklist\n\nThree groups of work\n\n- first task\n- second task\n  - nested detail\n  - another detail\n- third task\n\n1. plan the work\n2. do the work\n3) review the work\n\n> a quoted remark\n> another remark\n\nClosing paragraph"
_round-trips(list-doc, "list-heavy doc round trips")

let everything-doc = "# Title\n\nOpening paragraph\n\n---\n\n- bullet one\n  - bullet two\n\n1. ordered one\n2. ordered two\n\n> quoted line\n\n```\ncode line\n```\n\n| h1 | h2 |\n| --- | --- |\n| a  | b  |\n\nClosing paragraph"
_round-trips(everything-doc, "every block kind in one doc round trips")

# messy but punctuation-free texts under the canonicalization law — the
# first pass tightens and normalizes, the second is the identity
_canonicalizes("- one\n\n- two\n\n  - nested", "a loose list canonicalizes")
_canonicalizes("| a | b |\n| :-- | --: |\n| 1 |", "an aligned short-cell table canonicalizes")
_canonicalizes("one\r\n\r\n- a\r\n- b", "crlf input canonicalizes to lf")
_canonicalizes("```\nplain line\n```", "a code block is already canonical")

# the documented exclusion: escapable punctuation in a rendered position
# escapes on every pass, so neither law can hold — parse never unescapes
test.check(md.render(md.parse("Hello *world*")) == "Hello \\*world\\*", "punctuation escapes on the first pass")
test.check(md.render(md.parse(md.render(md.parse("Hello *world*")))) != md.render(md.parse("Hello *world*")), "escaping is not idempotent")

# property-style sweep: deterministic composed documents from canonical
# block fragments, a few hundred cases checked under the equality law
type Gen = record
    seed: Int
    text: String

word _step(seed: Int) -> Int
    (seed * 1103515245 + 12345) % 2147483648

word _pick(pool: List<String>, seed: Int) -> String
    pool[seed % list.length(pool)]

word _kinds() -> List<String>
    ["heading", "paragraph", "rule", "bullet", "ordered", "quote", "code", "table"]

word _fragment(kind: String, seed: Int) -> String
    if kind == "heading"
        _pick(["# Alpha", "## Beta Settings", "### Gamma Notes", "#### Delta"], seed)
    elif kind == "paragraph"
        _pick(["plain words here", "second line of prose", "numbers 1 2 3", "one line\ntwo lines"], seed)
    elif kind == "rule"
        "---"
    elif kind == "bullet"
        _pick(["- first", "- second", "- third", "  - nested one", "- a\n- b", "- x\n  - y\n- z"], seed)
    elif kind == "ordered"
        _pick(["1. plan", "2. do", "1. one\n2. two", "3) middle", "  1. inner"], seed)
    elif kind == "quote"
        _pick(["> a quoted line", "> another quote", "> one\n> two"], seed)
    elif kind == "code"
        _pick(["```\nplain line\n```", "```zhex\nlet x = 1\n```", "```\na\n\nb\n```"], seed)
    else
        _pick(["| aaa | bbb |\n| --- | --- |\n| 111 | 222 |", "| xyz |\n| --- |\n| 789 |", "| aaa |\n| --- |\n| zzz |"], seed)

# One composed document from the seed: 1-6 fragments, never two adjacent
# fragments of the same kind (a blank line between same-kind item runs
# would tighten on render, which the equality law excludes by design).
word _case(seed: Int) -> Gen
    var s = seed
    let count = 1 + s % 6
    s = _step(s)
    let kinds = _kinds()
    var frags: List<String> = list.new()
    var prev = ""
    var j = 0
    while j < count
        var index = s % 8
        s = _step(s)
        if kinds[index] == prev
            index = (index + 1) % 8
        let _frag = list.append(frags, _fragment(kinds[index], s))
        s = _step(s)
        prev = kinds[index]
        j = j + 1
    Gen(s, text.join(frags, "\n\n"))

var sweep-seed = 987654321
var sweep-i = 0
while sweep-i < 240
    let generated = _case(sweep-seed)
    sweep-seed = generated.seed
    _round-trips(generated.text, "sweep case " + sweep-i)
    sweep-i = sweep-i + 1

print "md parse, section editing, and round-trip tests passed"

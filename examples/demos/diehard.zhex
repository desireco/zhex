# Conway's Game of Life on a 24 by 24 board with a fixed-dead exterior: the
# seven-cell diehard methuselah churns for exactly 130 generations and then
# vanishes completely, so the run ends on an empty board. The demos page
# replays this run frame by frame.
word next-cell(grid: Array<Int>, row: Int, column: Int) -> Int
    let current = grid[row, column]
    var around = 0
    for r in range(row - 1, row + 2)
        for c in range(column - 1, column + 2)
            if r >= 0 and r < 24 and c >= 0 and c < 24 and (r != row or c != column)
                if grid[r, c] == 1
                    around = around + 1

    if current == 1
        if around == 2 or around == 3
            1
        else
            0
    else
        if around == 3
            1
        else
            0

word advance(grid: Array<Int>) -> Array<Int>
    let following: Array<Int> = array.new([24, 24], 0)
    for row in range(0, 24)
        for column in range(0, 24)
            following[row, column] = next-cell(grid, row, column)
    following

word show(grid: Array<Int>, generation: Int) -> Array<Int>
    print("Generation " + int.to-string(generation))
    for row in range(0, 24)
        var line = ""
        for column in range(0, 24)
            if grid[row, column] == 1
                line = line + "#"
            else
                line = line + "."
        print line
    grid

word stamp(grid: Array<Int>, top: Int, left: Int, pattern: List<String>) -> Array<Int>
    for row in range(0, list.length(pattern))
        let line = pattern[row]
        for column in range(0, text.length(line))
            if text.slice(line, column, column + 1) == "#"
                grid[top + row, left + column] = 1
    grid

word generations(grid: Array<Int>, count: Int) -> Array<Int>
    var current = grid
    for generation in range(1, count + 1)
        current = advance(current)
        show(current, generation)
    current

flow array.new([24, 24], 0)
    stamp(4, 6, ["......#.", "##......", ".#...###"])
    show 0
    generations 130

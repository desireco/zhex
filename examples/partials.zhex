word add left: Int, right: Int -> Int
    left + right

let plus-five = add _, 5
let five-plus: (Int) -> Int = add 5, _
print plus-five(7)
let right-hole-result = five-plus 7
print right-hole-result

var offset = 5
let plus-offset = add _, offset
offset = 100
let captured-result = plus-offset 7
print captured-result

word append-and-count(item: Int, values: List<Int> = []) -> Int
    list.append(values, item)
    list.length(values)

let add-to-fresh-list = append-and-count _
print add-to-fresh-list(1)
let second-length = add-to-fresh-list 2
print second-length

flow 7
    plus-five
    print

let change = text.replace _, "A", "a"
print(change("ADA"))
let show: (Int) -> Unit = print _
show 7
let append-one = list.append _, 1
let values: List<Int> = []
append-one(values)
print(list.length(values))

word parse raw: String
    text.to-int raw try

let parse-later = parse _
let parsed = parse-later "8" try
print parsed
let fallback = parse-later "bad" catch problem
    print(error.code(problem))
    3
print fallback

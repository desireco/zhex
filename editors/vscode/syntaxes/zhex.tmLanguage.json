{
  "name": "Zhex",
  "scopeName": "source.zhex",
  "fileTypes": [
    "zhex"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "match": "(?<![A-Za-z0-9_.-])(word)(\\s+)([A-Za-z_][A-Za-z0-9_]*(?:[-.][A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": {
          "name": "storage.type.function.zhex"
        },
        "3": {
          "name": "entity.name.function.zhex"
        }
      }
    },
    {
      "match": "(?<![A-Za-z0-9_.-])(?:ok|err|int\\.to-string|text\\.(?:reverse|to-int|length|line-count|word-count|upper|lower|trim|contains|index-of|slice|replace)|buffer\\.(?:new|add-line|line-count|line|set-line|to-text)|file\\.(?:read-all|read-lines|open|read-line|close|lines)|console\\.(?:arg|args-count|exit|fail)|error\\.(?:new|wrap|has-cause|cause|code|message|operation|file|line|column|detail|report|set-reporter)|list\\.(?:new|length|append)|array\\.(?:new|resize|shape|rank|length)|read-line|print|range)(?![A-Za-z0-9_.-])",
      "name": "support.function.builtin.zhex"
    },
    {
      "match": "(?<![A-Za-z0-9_.-])(?:type|record|choice|match|case|use|let|var|if|elif|else|for|in|flow|try|catch|return)(?![A-Za-z0-9_.-])",
      "name": "keyword.control.zhex"
    },
    {
      "match": "(?<![A-Za-z0-9_.-])(?:and|or|not)(?![A-Za-z0-9_.-])",
      "name": "keyword.operator.logical.zhex"
    },
    {
      "match": "(?<![A-Za-z0-9_.-])(?:Int|Bool|String|Unit|Buffer|File|Error|Result|List|Array|InputError|ParseError|FileError|BufferError)(?![A-Za-z0-9_.-])",
      "name": "support.type.builtin.zhex"
    },
    {
      "match": "(?<![A-Za-z0-9_.-])(?:true|false)(?![A-Za-z0-9_.-])",
      "name": "constant.language.boolean.zhex"
    },
    {
      "match": "[A-Za-z_][A-Za-z0-9_]*(?:[-.][A-Za-z_][A-Za-z0-9_]*)*(?=\\s*:)",
      "name": "variable.parameter.zhex"
    },
    {
      "match": "[A-Za-z_][A-Za-z0-9_]*(?:[-.][A-Za-z_][A-Za-z0-9_]*)*(?=\\s*\\()",
      "name": "entity.name.function.call.zhex"
    },
    {
      "match": "[A-Za-z_][A-Za-z0-9_]*(?:[-.][A-Za-z_][A-Za-z0-9_]*)*",
      "name": "variable.other.zhex"
    },
    {
      "match": "(?<![A-Za-z0-9_.])\\d+(?![A-Za-z0-9_.])",
      "name": "constant.numeric.integer.zhex"
    },
    {
      "match": "->|==|!=|<=|>=|[-+*/%<>=]",
      "name": "keyword.operator.zhex"
    },
    {
      "match": "[()\\[\\]]",
      "name": "punctuation.section.parens.zhex"
    },
    {
      "match": "[,:]",
      "name": "punctuation.separator.zhex"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.zhex",
      "begin": "#",
      "end": "$"
    },
    "strings": {
      "name": "string.quoted.double.zhex",
      "begin": "\"",
      "end": "\"|(?=$)",
      "patterns": [
        {
          "match": "\\\\(?:[abfnrtv\\\\\"]|[0-7]{3}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
          "name": "constant.character.escape.zhex"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.zhex"
        }
      ]
    }
  }
}
